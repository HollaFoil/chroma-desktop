#  btop++ theme generated by matugen - do not edit, edit the template instead
#  ~/.config/matugen/templates/btop.theme

#  Empty on purpose: btop then paints nothing behind itself and the terminal's
#  own background (which matugen themes too) shows through. btop.conf must also
#  carry theme_background = false, otherwise btop fills the box with black.
theme[main_bg]=""

theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.primary.default.hex}}"
theme[hi_fg]="{{colors.tertiary.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"

#  Numbers drawn on top of the graphs - a step below main_fg so they sit on the
#  braille without competing with it.
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"

#  Unfilled part of every meter.
theme[meter_bg]="{{colors.surface_container_high.default.hex}}"

theme[selected_bg]="{{colors.primary_container.default.hex}}"
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"

#  Mini cpu graphs and detail text in the process box.
theme[proc_misc]="{{colors.tertiary.default.hex}}"

#  All four box outlines share one muted tone: the borders are long continuous
#  runs, and an accent colour there reads as noise. The accent lives in the
#  titles instead. div_line is a step darker so inner rules stay subordinate.
theme[cpu_box]="{{colors.outline.default.hex}}"
theme[mem_box]="{{colors.outline.default.hex}}"
theme[net_box]="{{colors.outline.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

#  --- Gradients: start = low value, end = high value ---

#  Load and temperature climb into the palette's error colour, so a hot CPU
#  reads as hot without leaving the scheme.
theme[temp_start]="{{colors.ansi_blue.default.hex}}"
theme[temp_mid]="{{colors.ansi_yellow.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

theme[cpu_start]="{{colors.ansi_cyan.default.hex}}"
theme[cpu_mid]="{{colors.ansi_yellow.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

theme[process_start]="{{colors.ansi_green.default.hex}}"
theme[process_mid]="{{colors.ansi_yellow.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"

#  Memory: only "used" is a severity axis, so only it escalates. free and
#  available measure headroom - more is better - and stay cool and quiet.
#  cached is pure information and gets the warm muted ramp.
theme[used_start]="{{colors.ansi_green.default.hex}}"
theme[used_mid]="{{colors.ansi_yellow.default.hex}}"
theme[used_end]="{{colors.error.default.hex}}"

theme[free_start]="{{colors.ansi_blue.default.hex}}"
theme[free_mid]="{{colors.ansi_cyan.default.hex}}"
theme[free_end]="{{colors.ansi_green.default.hex}}"

theme[available_start]="{{colors.ansi_blue.default.hex}}"
theme[available_mid]="{{colors.ansi_cyan.default.hex}}"
theme[available_end]="{{colors.ansi_green.default.hex}}"

theme[cached_start]="{{colors.secondary.default.hex}}"
theme[cached_mid]="{{colors.tertiary.default.hex}}"
theme[cached_end]="{{colors.primary.default.hex}}"

#  Network: the two directions get opposite temperatures rather than a shared
#  ramp, so which half of the box is busy is readable at a glance.
theme[download_start]="{{colors.ansi_cyan.default.hex}}"
theme[download_mid]="{{colors.ansi_blue.default.hex}}"
theme[download_end]="{{colors.ansi_magenta.default.hex}}"

theme[upload_start]="{{colors.ansi_yellow.default.hex}}"
theme[upload_mid]="{{colors.primary.default.hex}}"
theme[upload_end]="{{colors.ansi_red.default.hex}}"
