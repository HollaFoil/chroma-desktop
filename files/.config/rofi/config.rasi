/* Base rofi config: plain `rofi -show drun` gets the launcher theme.
 * Colours come from colors.rasi, regenerated by matugen on every setwall. */
configuration {
    modi:                   "drun,run";
    show-icons:             true;
    icon-theme:             "breeze-dark";
    font:                   "GeistMono Nerd Font Propo 12";
    drun-display-format:    "{name}";
    display-drun:           "";
    terminal:               "kitty";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}
@theme "~/.config/rofi/launchers/style-7.rasi"
