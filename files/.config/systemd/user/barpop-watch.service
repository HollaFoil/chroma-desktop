[Unit]
Description=barpop network watcher (notifies on connection changes not made from the menu)
Documentation=file:%h/.local/lib/barpop/watch.py
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/barpop watch
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
