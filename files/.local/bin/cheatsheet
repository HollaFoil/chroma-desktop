#!/usr/bin/env python3
"""Keybind cheatsheet for SUPER+slash.

A layer-shell overlay (not a window): a frosted card in the middle of the
screen with the current keybinds laid out in two columns, sections kept whole
and dealt to the side that makes the columns closest in height (the split is
part of the export, see lib/actions.lua). It holds keyboard focus no
matter where the pointer wanders; any key, or a click outside the card, closes
it - the click is swallowed rather than passed to what is underneath. Running
it again while open closes it, so the bind toggles.

The rows come from ~/.cache/hypr/binds.json, which hyprland.lua writes on
every (re)load from the action table in conf/actions.lua merged with the
rebinding done in the settings UI - so the sheet always shows what the keys
actually do. Colours are matugen's via ~/.config/waybar/colors.css; blur comes
from Hyprland (frosted-cheatsheet layer rule).
"""
from __future__ import annotations

import json
import os
import signal
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gtk, GtkLayerShell  # noqa: E402

DATA = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "hypr/binds.json"
COLORS = Path.home() / ".config/waybar/colors.css"
PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "cheatsheet.pid"

STYLE = """
window { background: transparent; }
.card {
  background: alpha(@surface, 0.62);
  border-radius: 24px;
  padding: 26px 34px 30px 34px;
}
* { font-family: "GeistMono Nerd Font Propo", "MesloLGS Nerd Font Propo", monospace; font-size: 13px; }
.title { color: @primary; font-weight: bold; margin-top: 14px; margin-bottom: 4px; }
.title.first { margin-top: 0; }
.key  { color: @on_surface; font-weight: bold; margin-right: 22px; }
.desc { color: @on_surface_variant; }
"""


def key_text(action) -> str:
    if action.get("keys_label"):
        return action["keys_label"]
    keys = action.get("keys") or []
    if action.get("parametrised"):
        suffix = action.get("params_label", "")
        return " / ".join(f"{k} + {suffix}" if k else suffix for k in keys)
    return " / ".join(keys)


def columns():
    """Two lists of (category, [(keys, name), ...]): only the actions that are
    bound and marked for the cheatsheet. The split between the columns comes
    with the export (`columns`, chosen by lib/actions.lua for the closest
    heights, recomputed whenever the config loads); an export without it is
    cut in two here."""
    try:
        data = json.loads(DATA.read_text())
    except (OSError, ValueError):
        return [("Cheatsheet", [("hyprctl reload", f"{DATA} is missing; the config writes it")])], []
    rows = {}
    for a in data.get("actions", []):
        if not a.get("cheatsheet", True) or not a.get("keys"):
            continue
        rows.setdefault(a["category"], []).append((key_text(a), a["name"]))
    cols = data.get("columns")
    if cols and len(cols) == 2 and all(c in rows for col in cols for c in col):
        return [[(c, rows[c]) for c in col] for col in cols]
    order = [c for c in data.get("categories", []) if c in rows]
    order += [c for c in rows if c not in order]
    return split_balanced([(c, rows[c]) for c in order])


def split_balanced(blocks):
    """Fallback: cut the list of whole sections where the two halves' row
    counts are closest, without reordering."""
    heights = [len(rows) + 2 for _, rows in blocks]      # title + spacing
    total = sum(heights)
    best, best_diff, running = 1, None, 0
    for i, h in enumerate(heights[:-1], start=1):
        running += h
        diff = abs(running - (total - running))
        if best_diff is None or diff < best_diff:
            best, best_diff = i, diff
    return blocks[:best], blocks[best:]


def label(text, cls, xalign=0.0):
    lab = Gtk.Label(label=text)
    lab.set_xalign(xalign)
    lab.get_style_context().add_class(cls)
    return lab


def column(blocks) -> Gtk.Grid:
    grid = Gtk.Grid(row_spacing=4, column_spacing=0)
    grid.set_valign(Gtk.Align.CENTER)   # the shorter column floats mid-card
    row = 0
    for i, (title, rows) in enumerate(blocks):
        t = label(title, "title")
        if i == 0:
            t.get_style_context().add_class("first")
        grid.attach(t, 0, row, 2, 1)
        row += 1
        for key, desc in rows:
            grid.attach(label(key, "key"), 0, row, 1, 1)
            grid.attach(label(desc, "desc"), 1, row, 1, 1)
            row += 1
    return grid


class Overlay(Gtk.Window):
    def __init__(self):
        super().__init__(title="cheatsheet")
        self.set_decorated(False)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self, "cheatsheet")
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.RIGHT,
                     GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_exclusive_zone(self, -1)

        self.connect("key-press-event", lambda *_: self.quit() or True)

        backdrop = Gtk.EventBox()                 # eats the click and closes
        backdrop.set_visible_window(False)
        backdrop.connect("button-press-event", lambda *_: self.quit() or True)
        self.add(backdrop)

        card = Gtk.EventBox()                     # clicks on the card do nothing
        card.set_visible_window(False)
        card.connect("button-press-event", lambda *_: True)
        card.set_halign(Gtk.Align.CENTER)
        card.set_valign(Gtk.Align.CENTER)
        backdrop.add(card)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=56)
        body.get_style_context().add_class("card")
        card.add(body)

        left, right = columns()
        body.pack_start(column(left), False, False, 0)
        body.pack_start(column(right), False, False, 0)

    def quit(self):
        Gtk.main_quit()


def toggle_instance() -> bool:
    try:
        os.kill(int(PIDFILE.read_text()), signal.SIGTERM)
        PIDFILE.unlink(missing_ok=True)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError):
        PIDFILE.unlink(missing_ok=True)
        return False


def main():
    if toggle_instance():
        return 0
    PIDFILE.write_text(str(os.getpid()))
    try:
        css = Gtk.CssProvider()
        css.load_from_data(((COLORS.read_text() if COLORS.exists() else "") + STYLE).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Overlay()
        win.show_all()
        signal.signal(signal.SIGTERM, lambda *_: win.quit())
        Gtk.main()
    finally:
        PIDFILE.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
