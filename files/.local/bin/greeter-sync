#!/bin/bash
# greeter-sync — give the login screen what it needs from this user's desktop.
#
# The greeter runs as the `greeter` user and cannot read ~, so the files it
# uses are copied into /etc/greetd/theme (a directory `./greeter install`
# makes writable by you). Runs as the post_hook of matugen's regreet template,
# i.e. on every setwall, and once from ./greeter install:
#
#   wallgreet.css   the rendered stylesheet (~/.config/matugen/generated/wallgreet.css)
#   background    the wallpaper it was rendered from (path in that file's first line)
#   monitors.lua  ~/.config/hypr/monitors.lua, so the greeter lays the outputs out like the session
#   colors.lua    ~/.config/hypr/colors.lua, for the backdrop of the monitors without the window
#
# A no-op (exit 0) when the theme directory does not exist or is not writable,
# so a machine without greetd is unaffected.
set -uo pipefail

THEME="${GREETER_THEME_DIR:-/etc/greetd/theme}"
CSS="$HOME/.config/matugen/generated/wallgreet.css"
HYPR="$HOME/.config/hypr"

[[ -d "$THEME" && -w "$THEME" ]] || exit 0
if [[ ! -f "$CSS" ]]; then
    echo "greeter-sync: $CSS does not exist yet; run setwall <image>" >&2
    exit 0
fi

# install(1) rather than cp: the mode is what makes the files readable by the
# greeter user regardless of this shell's umask.
install -m644 "$CSS" "$THEME/wallgreet.css"

wall="$(sed -n '1s#^/\* wallpaper: \(.*\) \*/$#\1#p' "$CSS")"
if [[ -n "$wall" && -f "$wall" ]]; then
    install -m644 "$wall" "$THEME/background"
else
    echo "greeter-sync: wallpaper '$wall' not found; login screen keeps its old picture" >&2
fi

[[ -f "$HYPR/monitors.lua" ]] && install -m644 "$HYPR/monitors.lua" "$THEME/monitors.lua"
[[ -f "$HYPR/colors.lua" ]]   && install -m644 "$HYPR/colors.lua"   "$THEME/colors.lua"
exit 0
