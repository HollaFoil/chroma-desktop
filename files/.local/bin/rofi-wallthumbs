#!/bin/bash
# Render the wallpaper crops the rofi launcher styles paint behind themselves
# (see ~/.config/rofi/launchers/*.rasi). Called by setwall after awww; the
# magick recipes are Matuprland's matugenMagick.sh with paths changed.
#   wall.thumb       1000px wide, plain
#   wall-blur.thumb  same, blurred (used as a strip behind the mode buttons)
#   wall.sqre        500x500 centre crop
#   wall.quad        the square with a slanted right edge cut to transparency
set -euo pipefail

WALL="${1:?usage: rofi-wallthumbs <image>}"
OUT="$HOME/.cache/rofi"
mkdir -p "$OUT"

magick "$WALL" -strip -resize 1000 -gravity center -extent 1000 -quality 90 "$OUT/wall.thumb"
magick "$WALL" -strip -resize 1000 -gravity center -extent 1000 -blur 30x30 -quality 90 "$OUT/wall-blur.thumb"
magick "$WALL" -strip -thumbnail 500x500^ -gravity center -extent 500x500 "$OUT/wall.sqre"
magick "$OUT/wall.sqre" \
    \( -size 500x500 xc:white -fill "rgba(0,0,0,0.7)" -draw "polygon 400,500 500,500 500,0 450,0" \
       -fill black -draw "polygon 500,500 500,0 450,500" \) \
    -alpha Off -compose CopyOpacity -composite "$OUT/wall.quad.png"
mv "$OUT/wall.quad.png" "$OUT/wall.quad"
