#!/usr/bin/env python3
"""wallgreet - one screen for logging in and for unlocking.

    wallgreet            greeter: run by greetd's Hyprland (/etc/greetd/hyprland.lua)
    wallgreet --lock     lock screen: locks the current session (ext-session-lock,
                         the protocol hyprlock uses) and unlocks it through PAM
    --demo               greeter without greetd / lock that Esc unlocks; for looking at it
    --demo-unlock N      with --lock --demo: unlock by itself after N seconds (for screenshots)

The picture is the same in both:

    idle    date top-left, sleep/restart/power top-right, the clock as two big
            numbers, "Press any key" at the bottom
    form    the clock fades out and the form fades in where it was: your name,
            a pill input with an Enter glyph; in the greeter also the session as
            a small drop-up list bottom-left. Any key, a scroll, or a drag in
            any direction gets you there; the drag follows your hand and
            completes on its own once it has gone far enough. Escape, a drag
            with an empty input, or a while of nothing fades it back.

Greeter: one layer-shell surface per monitor (the UI on the largest), the
wallpaper and palette from /etc/greetd/theme, which greeter-sync fills on
every setwall from the logged-in user's desktop - so the login screen shows
the wallpaper that was set last, and nothing here can change it.
Lock: one session-lock surface per monitor, wallpaper and palette straight
from ~/.config (matugen's generated wallgreet.css names the wallpaper).

Stdlib + PyGObject; gtk-layer-shell for the greeter, gtk-session-lock and
python-pam for the lock. Talks greetd's JSON IPC over $GREETD_SOCK.
"""
from __future__ import annotations

import configparser
import fcntl
import glob
import json
import math
import os
import pwd
import shlex
import socket
import struct
import subprocess
import sys
import threading
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

LOCK = "--lock" in sys.argv
DEMO = "--demo" in sys.argv
DEMO_UNLOCK = float(sys.argv[sys.argv.index("--demo-unlock") + 1]) if "--demo-unlock" in sys.argv else None
START_IN_FORM = "--form" in sys.argv

if LOCK:
    try:
        gi.require_version("GtkSessionLock", "0.1")
        from gi.repository import GtkSessionLock  # noqa: E402
        import pam  # noqa: F401  python-pam
    except (ValueError, ImportError) as e:
        # Exit before touching the screen, so `wallgreet --lock || hyprlock` falls through.
        sys.exit(f"wallgreet: lock mode needs gtk-session-lock and python-pam ({e})")
else:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell  # noqa: E402

HOME = Path.home()
if LOCK:
    CSS_FILE = HOME / ".config/matugen/generated/wallgreet.css"
    BACKGROUND = None            # taken from the first line of CSS_FILE
    STATE = None
else:
    THEME = Path(os.environ.get("WALLGREET_THEME", "/etc/greetd/theme"))
    CSS_FILE = THEME / "wallgreet.css"
    BACKGROUND = THEME / "background"
    STATE = Path(os.environ.get("WALLGREET_STATE", "/var/lib/wallgreet/state.json"))

SESSION_DIRS = ["/usr/share/wayland-sessions"]   # X11 sessions are deliberately not offered
IDLE_BACK = 45          # s without typing before the form fades away
DRAG_FULL = 160         # px of drag for the full transition; past half of it, it completes itself
ANIM_MS = 320           # the transition's own animation (keys, scroll, completing a drag)
CLOCK_LIFT = 40         # px the clock rises while fading out
FORM_DROP = 30          # px the form travels while fading in
DIM = 0.30              # black over the wallpaper
MARGIN = 48             # corners

# Nerd Font (Material Design set): power, power-sleep, restart, account, keyboard-return, chevron-up
G = dict(power="\U000F0425", sleep="\U000F0904", reboot="\U000F0709", user="\U000F0004",
         enter="\U000F0311", up="\U000F0143")

FALLBACK_CSS = """
* { font-family: "GeistMono Nerd Font Propo", monospace; color: #dde4e1; }
window { background: transparent; }
.clock { font-size: 140px; font-weight: 700; }
.date { font-size: 18px; } .hint, .status, .session button { font-size: 13px; }
.flat { background: none; border: none; box-shadow: none; }
.pass-box { border: 2px solid #83d5c6; border-radius: 999px; background: alpha(#1a201f, 0.85); min-width: 300px; }
.pass-box entry { background: none; border: none; box-shadow: none; }
"""


def ease(t: float) -> float:
    """ease-out cubic"""
    return 1 - (1 - t) ** 3


# ── data ─────────────────────────────────────────────────────────────────────

class Session:
    def __init__(self, name: str, exec_: str, desktops: list[str]):
        self.name, self.cmd = name, shlex.split(exec_)
        self.env = ["XDG_SESSION_TYPE=wayland"]
        if desktops:
            self.env += [f"XDG_SESSION_DESKTOP={desktops[0]}", "XDG_CURRENT_DESKTOP=" + ":".join(desktops)]


def sessions() -> list[Session]:
    out = []
    for d in SESSION_DIRS:
        for f in sorted(glob.glob(f"{d}/*.desktop")):
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(f, encoding="utf-8")
                e = cp["Desktop Entry"]
            except Exception:
                continue
            if e.get("Hidden", "false").lower() == "true" or e.get("NoDisplay", "false").lower() == "true":
                continue
            if not e.get("Exec"):
                continue
            names = [n for n in e.get("DesktopNames", "").split(";") if n]
            out.append(Session(e.get("Name", Path(f).stem), e["Exec"], names))
    return out


def users() -> list[str]:
    bad = ("nologin", "/bin/false", "/usr/bin/false")
    return sorted(p.pw_name for p in pwd.getpwall()
                  if 1000 <= p.pw_uid < 60000 and not p.pw_shell.endswith(bad))


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def save_state(**kw):
    if STATE is None:
        return
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(kw))
    except OSError:
        pass   # a read-only state dir only costs the memory of the last user/session


def wallpaper_named_in(css: Path) -> Path | None:
    """The first line of the rendered stylesheet is `/* wallpaper: <path> */`."""
    try:
        first = css.read_text().splitlines()[0]
    except (OSError, IndexError):
        return None
    if first.startswith("/* wallpaper: ") and first.endswith(" */"):
        p = Path(first[len("/* wallpaper: "):-3])
        return p if p.is_file() else None
    return None


# ── authentication ───────────────────────────────────────────────────────────

class Greetd:
    """greetd-ipc(7): native-endian u32 length prefix, then a JSON object."""

    def __init__(self, path: str):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(path)

    def call(self, **msg) -> dict:
        data = json.dumps(msg).encode()
        self.sock.sendall(struct.pack("=I", len(data)) + data)
        (n,) = struct.unpack("=I", self._recv(4))
        return json.loads(self._recv(n))

    def _recv(self, n: int) -> bytes:
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("greetd closed the socket")
            buf += chunk
        return buf


def greetd_login(user: str, password: str, session: Session) -> tuple[bool, str]:
    g = Greetd(os.environ["GREETD_SOCK"])
    r = g.call(type="create_session", username=user)
    answered = False
    while r["type"] == "auth_message":
        if r.get("auth_message_type") in ("secret", "visible"):
            if answered:   # a second prompt (a token, a second factor) this UI cannot take
                g.call(type="cancel_session")
                return False, r.get("auth_message", "").strip() or "unsupported prompt"
            r = g.call(type="post_auth_message_response", response=password)
            answered = True
        else:              # info / error text from PAM: acknowledge and go on
            r = g.call(type="post_auth_message_response", response=None)
    if r["type"] == "error":
        g.call(type="cancel_session")
        return False, "Wrong password" if r.get("error_type") == "auth_error" else r.get("description", "error")
    r = g.call(type="start_session", cmd=session.cmd, env=session.env)
    if r["type"] == "error":
        return False, r.get("description", "could not start the session")
    return True, ""


def pam_service() -> str:
    """/etc/pam.d/wallgreet if it has an account stack, else login.

    python-pam runs pam_acct_mgmt after pam_authenticate; a service file with
    only auth lines (hyprlock's, or an older wallgreet one) falls through to
    /etc/pam.d/other for that and is denied - a correct password reported as
    wrong. `login` always has both stacks."""
    f = Path("/etc/pam.d/wallgreet")
    try:
        if any(line.split()[:1] == ["account"] for line in f.read_text().splitlines()):
            return "wallgreet"
    except OSError:
        pass
    return "login"


def pam_login(user: str, password: str) -> tuple[bool, str]:
    import pam  # python-pam; only the lock needs it
    # resetcreds=False: no pam_setcred; this only checks the password
    ok = pam.pam().authenticate(user, password, service=pam_service(), resetcreds=False)
    return (True, "") if ok else (False, "Wrong password")


def authenticate(user: str, password: str, session: Session | None, done):
    """Runs the conversation off the GTK thread; done(ok, message) on the main loop."""
    def run():
        try:
            if DEMO:
                time.sleep(0.6)
                ok, msg = True, (f"demo: would unlock" if LOCK else f"demo: would start {session.name} as {user}")
            elif LOCK:
                ok, msg = pam_login(user, password)
            else:
                ok, msg = greetd_login(user, password, session)
        except Exception as e:  # noqa: BLE001 - shown on screen, nothing else to do with it
            ok, msg = False, str(e)
        GLib.idle_add(done, ok, msg)

    threading.Thread(target=run, daemon=True).start()


# ── widgets ──────────────────────────────────────────────────────────────────

class Backdrop(Gtk.DrawingArea):
    """The wallpaper, scaled to cover, dimmed."""

    def __init__(self, pixbuf: GdkPixbuf.Pixbuf | None):
        super().__init__()
        self.pixbuf = pixbuf
        self.connect("draw", self.on_draw)

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        if self.pixbuf:
            pw, ph = self.pixbuf.get_width(), self.pixbuf.get_height()
            s = max(w / pw, h / ph)
            cr.save()
            cr.translate((w - pw * s) / 2, (h - ph * s) / 2)
            cr.scale(s, s)
            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(0.08, 0.08, 0.08)
            cr.paint()
        cr.set_source_rgba(0, 0, 0, DIM)
        cr.paint()


def flat(label: str, *classes: str) -> Gtk.Button:
    b = Gtk.Button(label=label)
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.set_can_focus(False)
    ctx = b.get_style_context()
    ctx.add_class("flat")
    for c in classes:
        ctx.add_class(c)
    return b


class DropUp(Gtk.Box):
    """A small text button; clicking it reveals the choices above it (an inline list,
    not a popup: GTK popups on layer surfaces repaint at the bar's pace under Hyprland)."""

    def __init__(self, items: list[str], current: int, on_pick, css: str):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.get_style_context().add_class(css)
        self.items, self.current, self.on_pick = items, current, on_pick
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.list.get_style_context().add_class("list")
        self.rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_UP, transition_duration=180)
        self.rev.add(self.list)
        self.toggle = flat("")
        self.toggle.connect("clicked", lambda *_: self.rev.set_reveal_child(not self.rev.get_reveal_child()))
        self.pack_start(self.rev, False, False, 0)
        self.pack_start(self.toggle, False, False, 0)
        self._rebuild()

    def _rebuild(self):
        for c in self.list.get_children():
            self.list.remove(c)
        for i, name in enumerate(self.items):
            b = flat(name, *(["current"] if i == self.current else []))
            b.get_child().set_xalign(0)
            b.connect("clicked", self._pick, i)
            self.list.pack_start(b, False, False, 0)
        self.list.show_all()
        arrow = G["up"] if len(self.items) > 1 else ""
        self.toggle.set_label(f"{self.items[self.current]}  {arrow}".rstrip())
        self.toggle.set_sensitive(len(self.items) > 1)

    def _pick(self, _b, i):
        self.current = i
        self.rev.set_reveal_child(False)
        self._rebuild()
        self.on_pick(i)

    def close(self):
        self.rev.set_reveal_child(False)


# ── the screen ───────────────────────────────────────────────────────────────

class Screen:
    def __init__(self):
        me = pwd.getpwuid(os.getuid()).pw_name
        if LOCK:
            self.sessions, self.users, self.si, self.ui = [], [me], 0, 0
        else:
            self.sessions = sessions() or [Session("Hyprland", "start-hyprland", ["Hyprland"])]
            self.users = users() or [me]
            st = load_state()
            self.ui = next((i for i, u in enumerate(self.users) if u == st.get("user")), 0)
            # Last used session, else the plainest Hyprland entry (hyprland.desktop
            # before hyprland-uwsm.desktop), else the first one.
            self.si = next((i for i, s in enumerate(self.sessions) if s.name == st.get("session")), None)
            if self.si is None:
                hypr = [i for i, s in enumerate(self.sessions) if "hyprland" in s.name.lower()]
                self.si = min(hypr, key=lambda i: len(self.sessions[i].name)) if hypr else 0

        self.busy = False
        self.last_input = time.monotonic()
        self.p = 0.0            # 0 = clock, 1 = form
        self.target = 0.0
        self.anim = None        # (start_p, target, t0) while animating
        self.drag = None        # (x, y, p_at_press, direction) while the button is down
        self.windows: list[Gtk.Window] = []
        self.main: Gtk.Window | None = None
        self.lock = None
        self.unlocking = False
        self.exit_code = 0

        css = Gtk.CssProvider()
        try:
            css.load_from_path(str(CSS_FILE))
        except GLib.Error:
            css.load_from_data(FALLBACK_CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)
        if Path("/usr/share/themes/adw-gtk3-dark").is_dir():
            settings.set_property("gtk-theme-name", "adw-gtk3-dark")

        wall = BACKGROUND if BACKGROUND else wallpaper_named_in(CSS_FILE)
        try:
            self.pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(wall)) if wall else None
        except GLib.Error:
            self.pixbuf = None

        self.display = Gdk.Display.get_default()
        if LOCK:
            # gtk-session-lock 0.2: signals are "locked" and "finished"; the latter
            # means the compositor ended the lock - refused it, or we unlocked.
            self.lock = GtkSessionLock.prepare_lock()
            self.lock.connect("locked", lambda *_: None)
            self.lock.connect("finished", self.on_lock_finished)
            self.lock.lock_lock()
        self._cover_monitors()
        self.display.connect("monitor-added", lambda *_: self._cover_monitors())

        GLib.timeout_add_seconds(1, self._tick)
        self._tick()

    def on_lock_finished(self, *_):
        if not self.unlocking:
            print("wallgreet: the compositor ended the session lock (another locker running?)", file=sys.stderr)
            self.exit_code = 2
        Gtk.main_quit()

    def unlock(self):
        self.unlocking = True
        self.lock.unlock_and_destroy()
        Gtk.main_quit()

    # -- windows --

    def _cover_monitors(self):
        mons = [self.display.get_monitor(i) for i in range(self.display.get_n_monitors())]
        if not mons:
            GLib.timeout_add(300, self._cover_monitors)   # outputs still coming up
            return False
        covered = {w.wallgreet_monitor for w in self.windows}
        main = max(mons, key=lambda m: m.get_geometry().width * m.get_geometry().height)
        for m in mons:
            if m in covered:
                continue
            is_main = self.main is None and m is main
            self.windows.append(self._window(m, is_main))
        return False

    def _window(self, monitor, is_main: bool) -> Gtk.Window:
        win = Gtk.Window()
        win.wallgreet_monitor = monitor
        if LOCK:
            self.lock.new_surface(win, monitor)
        else:
            GtkLayerShell.init_for_window(win)
            GtkLayerShell.set_namespace(win, "wallgreet")
            GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_monitor(win, monitor)
            for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
                GtkLayerShell.set_anchor(win, edge, True)
            GtkLayerShell.set_exclusive_zone(win, -1)
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE if is_main
                                            else GtkLayerShell.KeyboardMode.NONE)

        overlay = Gtk.Overlay()
        overlay.add(Backdrop(self.pixbuf))
        if is_main:
            self.main = win
            self._build_ui(overlay)
        # Every surface takes keys and the drag: under a session lock the
        # compositor gives the keyboard to whichever monitor it likes.
        win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                       | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        win.connect("key-press-event", self.on_key)
        win.connect("button-press-event", self.on_press)
        win.connect("motion-notify-event", self.on_motion)
        win.connect("button-release-event", self.on_release)
        win.connect("scroll-event", self.on_scroll)
        win.add(overlay)
        win.show_all()
        if is_main:
            self.set_progress(0.0)
        return win

    def _build_ui(self, overlay: Gtk.Overlay):
        def place(w, halign, valign, mx=MARGIN, my=MARGIN):
            w.set_halign(halign)
            w.set_valign(valign)
            w.set_margin_start(mx); w.set_margin_end(mx)
            w.set_margin_top(my);   w.set_margin_bottom(my)
            overlay.add_overlay(w)
            overlay.set_overlay_pass_through(w, False)

        # top-left: the date
        self.date = Gtk.Label()
        self.date.get_style_context().add_class("date")
        place(self.date, Gtk.Align.START, Gtk.Align.START, my=MARGIN - 8)

        # top-right: sleep / restart / power
        power = Gtk.Box(spacing=4)
        power.get_style_context().add_class("power")
        for glyph, action, cls in ((G["sleep"], "suspend", ""), (G["reboot"], "reboot", ""), (G["power"], "poweroff", "danger")):
            b = flat(glyph, *([cls] if cls else []))
            b.connect("clicked", self.on_power, action)
            power.pack_start(b, False, False, 0)
        place(power, Gtk.Align.END, Gtk.Align.START, my=MARGIN - 14)

        # bottom: the hint
        self.hint = Gtk.Label(label="Press any key to unlock" if LOCK else "Press any key to log in")
        self.hint.get_style_context().add_class("hint")
        place(self.hint, Gtk.Align.CENTER, Gtk.Align.END)

        # centre, idle: the clock
        self.clock = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.hours = Gtk.Label(); self.hours.get_style_context().add_class("clock"); self.hours.get_style_context().add_class("hours")
        self.mins = Gtk.Label();  self.mins.get_style_context().add_class("clock");  self.mins.get_style_context().add_class("minutes")
        self.clock.pack_start(self.hours, False, False, 0)
        self.clock.pack_start(self.mins, False, False, 0)
        place(self.clock, Gtk.Align.CENTER, Gtk.Align.CENTER, mx=0, my=0)

        # centre, form: name, the input, a status line - drawn over the clock's place
        self.form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.form.get_style_context().add_class("form")
        self.user_drop = DropUp([f"{G['user']}  {u}" for u in self.users], self.ui, self.on_user, "user")
        self.user_drop.set_halign(Gtk.Align.CENTER)
        self.form.pack_start(self.user_drop, False, False, 0)

        self.pass_box = Gtk.Box(spacing=0)
        self.pass_box.get_style_context().add_class("pass-box")
        self.entry = Gtk.Entry()
        self.entry.set_visibility(False)
        self.entry.set_invisible_char("●")
        self.entry.set_alignment(0.5)
        self.entry.set_width_chars(22)
        self.entry.connect("activate", self.on_login)
        self.entry.connect("changed", self.on_changed)
        enter = flat(G["enter"], "enter")
        enter.connect("clicked", self.on_login)
        self.pass_box.pack_start(self.entry, True, True, 0)
        self.pass_box.pack_end(enter, False, False, 0)
        self.pass_box.set_halign(Gtk.Align.CENTER)
        self.form.pack_start(self.pass_box, False, False, 0)

        self.status = Gtk.Label(label=" ")
        self.status.get_style_context().add_class("status")
        self.form.pack_start(self.status, False, False, 0)
        place(self.form, Gtk.Align.CENTER, Gtk.Align.CENTER, mx=0, my=0)

        # bottom-left: the session (greeter only)
        self.session_drop = None
        if not LOCK:
            self.session_drop = DropUp([s.name for s in self.sessions], self.si, self.on_session, "session")
            place(self.session_drop, Gtk.Align.START, Gtk.Align.END)

    # -- the transition: p = 0 is the clock, p = 1 the form --

    @property
    def in_form(self) -> bool:
        return self.target >= 1.0

    def set_progress(self, p: float):
        p = max(0.0, min(1.0, p))
        self.p = p
        q = p          # linear in p: a drag maps 1:1 to the hand; animate_to eases in time
        self.clock.set_opacity(1 - q)
        self.clock.set_margin_bottom(int(q * CLOCK_LIFT * 2))     # centred: margin m lifts it m/2
        self.hint.set_opacity(1 - q)
        self.form.set_opacity(q)
        self.form.set_margin_top(int((1 - q) * FORM_DROP * 2))    # eases up into place
        if self.session_drop is not None:
            self.session_drop.set_opacity(q)
        # Only a fully shown form takes clicks; a fully hidden one takes none.
        self.form.set_sensitive(p >= 1.0)
        self.clock.set_visible(p < 1.0)
        self.form.set_visible(p > 0.0)
        if self.session_drop is not None:
            self.session_drop.set_visible(p > 0.0)
            self.session_drop.set_sensitive(p >= 1.0)

    def animate_to(self, target: float):
        """Ease from wherever we are to 0 or 1, then settle."""
        self.target = target
        self.drag = None
        self.last_input = time.monotonic()
        if self.p == target:
            self._settled()
            return
        if self.anim is None:
            self.main.add_tick_callback(self._frame)
        self.anim = (self.p, target, None)

    def _frame(self, _w, clock):
        if self.anim is None:
            return False
        start, target, t0 = self.anim
        now = clock.get_frame_time()
        if t0 is None:
            t0 = now
            self.anim = (start, target, t0)
        t = min(1.0, (now - t0) / (ANIM_MS * 1000))
        self.set_progress(start + (target - start) * ease(t))
        if t >= 1.0:
            self.anim = None
            self._settled()
            return False
        return True

    def _settled(self):
        if self.in_form:
            self.entry.grab_focus()
        else:
            if self.session_drop is not None:
                self.session_drop.close()
            self.user_drop.close()
            self.entry.set_text("")
            self.status.set_text(" ")
            self.pass_box.get_style_context().remove_class("error")

    def open_form(self):
        if not self.in_form:
            self.animate_to(1.0)

    def close_form(self):
        if self.in_form and not self.busy:
            self.animate_to(0.0)

    def _tick(self):
        now = time.localtime()
        self.hours.set_text(time.strftime("%H", now))
        self.mins.set_text(time.strftime("%M", now))
        self.date.set_text(time.strftime("%A, %-d %B", now))
        if self.in_form and not self.busy and not self.entry.get_text() and time.monotonic() - self.last_input > IDLE_BACK:
            self.close_form()
        return True

    # -- keys --

    def on_key(self, win, ev):
        self.last_input = time.monotonic()
        if ev.keyval == Gdk.KEY_Escape:
            if self.in_form:
                self.close_form()
            elif DEMO:
                if self.lock is not None:
                    self.unlock()
                else:
                    Gtk.main_quit()
            return True
        if not self.in_form:
            self.open_form()
            ch = Gdk.keyval_to_unicode(ev.keyval)
            if ch >= 0x20 and not ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK):
                self.entry.set_text(chr(ch))       # the key you pressed is the first character
                self.entry.set_position(-1)
            return True
        if win is not self.main:
            # a key on another monitor's surface: hand it to the form
            self.main.emit("key-press-event", ev)
            return True
        return False   # let the entry have it

    # -- the drag --

    def on_press(self, _w, ev):
        if ev.button == 1 and self.anim is None and not self.busy:
            if self.in_form and self.entry.get_text():
                return False    # typing something: a click is just a click
            self.drag = (ev.x_root, ev.y_root, self.p, 1.0 if not self.in_form else -1.0)
        return False

    def on_motion(self, _w, ev):
        if self.drag is None or not ev.state & Gdk.ModifierType.BUTTON1_MASK:
            return False
        x0, y0, p0, direction = self.drag
        dist = math.hypot(ev.x_root - x0, ev.y_root - y0)
        p = p0 + direction * dist / DRAG_FULL
        # far enough: it finishes on its own, the hand can let go
        if (direction > 0 and p >= 0.5) or (direction < 0 and p <= 0.5):
            self.animate_to(1.0 if direction > 0 else 0.0)
            return True
        self.set_progress(p)
        return True

    def on_release(self, _w, ev):
        if self.drag is None or ev.button != 1:
            return False
        _x0, _y0, p0, _d = self.drag
        self.animate_to(1.0 if p0 >= 1.0 else 0.0)    # not far enough: back to where it came from
        return True

    def on_scroll(self, _w, ev):
        if ev.direction == Gdk.ScrollDirection.SMOOTH and abs(ev.delta_y) < 0.2 and abs(ev.delta_x) < 0.2:
            return True
        if not self.in_form:
            self.open_form()
        elif not self.entry.get_text():
            self.close_form()
        return True

    # -- the form --

    def on_changed(self, _e):
        self.last_input = time.monotonic()
        self.pass_box.get_style_context().remove_class("error")
        if self.status.get_text().strip():
            self.status.set_text(" ")

    def on_user(self, i):
        self.ui = i
        self.entry.grab_focus()

    def on_session(self, i):
        self.si = i
        self.entry.grab_focus()

    def on_power(self, _b, action):
        if DEMO:
            self.status.set_text(f"demo: systemctl {action}")
            return
        subprocess.Popen(["systemctl", action])

    def on_login(self, *_):
        if self.busy or not self.in_form:
            return
        pw = self.entry.get_text()
        if not pw:
            return
        self.busy = True
        self.entry.set_sensitive(False)
        self.status.set_text("…")
        authenticate(self.users[self.ui], pw, self.sessions[self.si] if self.sessions else None, self.on_done)

    def on_done(self, ok: bool, msg: str):
        self.busy = False
        self.entry.set_sensitive(True)
        self.entry.set_text("")
        if ok:
            save_state(user=self.users[self.ui], session=self.sessions[self.si].name if self.sessions else "")
            if DEMO and not LOCK:
                self.status.set_text(msg)
                GLib.timeout_add(1500, Gtk.main_quit)
                return False
            if self.lock is not None:
                self.unlock()
            else:
                Gtk.main_quit()                  # greetd starts the session; Hyprland exits after us
            return False
        self.pass_box.get_style_context().add_class("error")
        self.status.set_text(msg)
        self.entry.grab_focus()
        return False


def single_instance() -> bool:
    """Lock mode: a second `wallgreet --lock` (hypridle + a bind, say) just exits."""
    path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "wallgreet.lock"
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return False
    single_instance.fd = fd   # keep it open for the life of the process
    return True


def main():
    if LOCK and not single_instance():
        return 0
    if LOCK and not GtkSessionLock.is_supported():
        print("wallgreet: this compositor has no ext-session-lock", file=sys.stderr)
        return 2
    s = Screen()
    if LOCK and DEMO and DEMO_UNLOCK:
        GLib.timeout_add(int(DEMO_UNLOCK * 1000), lambda: (s.unlock(), False)[1])
    if START_IN_FORM:
        s.set_progress(1.0)
        s.target = 1.0
        s._settled()
    Gtk.main()
    return s.exit_code


if __name__ == "__main__":
    sys.exit(main())
