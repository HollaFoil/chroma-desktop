#!/usr/bin/env python3
"""barpop - waybar's click menus as one layer-shell popup. See lib/barpop."""
import sys
from pathlib import Path

# ~/.local/bin/barpop -> ~/dotfiles/files/.local/bin/barpop; the package sits
# beside it in ../lib, whichever of the two paths this is run through.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from barpop.shell import main  # noqa: E402

sys.exit(main())
