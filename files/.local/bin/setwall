#!/bin/bash
set -euo pipefail

WALL="${1:-}"

if [[ -z "$WALL" ]]; then
    echo "usage: setwall <path-to-image>" >&2
    exit 1
fi

# make the path absolute so awww gets what it expects
WALL="$(realpath "$WALL")"

if [[ ! -f "$WALL" ]]; then
    echo "setwall: no such file: $WALL" >&2
    exit 1
fi

# The wallpaper daemon is optional: matugen still recolours everything else
# if it is not running (or not installed), the picture just does not change.
if command -v awww >/dev/null 2>&1; then
    awww img "$WALL" || echo "setwall: awww failed (is awww-daemon running?)" >&2
fi
matugen image "$WALL" -m dark --source-color-index 0

# Prompt colours, only for oh-my-posh users who have the source theme in place.
if command -v oh-my-posh >/dev/null 2>&1 && [[ -f ~/.config/oh-my-posh/themes/agnoster.omp.json ]]; then
    ~/.local/bin/gen-ohmyposh-template
fi

echo "setwall: applied $WALL"
