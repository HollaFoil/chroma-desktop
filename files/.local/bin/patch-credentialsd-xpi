#!/bin/bash
# Patch the credentialsd Firefox helper so it runs on every site.
#
# The credentialsd 0.2.0 release ships add-on 0.1.0, whose content script is
# only allowed on webauthn.io and demo.yubico.com, so passkey prompts on any
# other site never reach credentialsd (and Firefox on Linux has no phone/QR
# flow of its own). Upstream main already has "<all_urls>" but its add-on
# needs main's D-Bus interface, so until the next release this widens the
# packaged add-on in place and adds the same two guards main has:
#   - mediation: "conditional" (autofill-style prompts) goes to Firefox, so
#     login pages don't pop the credentialsd window on load;
#   - non-publicKey requests (password/federated credentials) are left alone.
#
# Rebuilds the xpi Firefox loads from the app-global extensions dir (which is
# exempt from signing), so it needs root. Re-run after a credentialsd upgrade
# reverts it; drop this once the packaged add-on matches on all sites.
set -euo pipefail

XPI=/usr/share/credentialsd/credentialsd-firefox-helper.xpi

if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi
if [[ ! -f "$XPI" ]]; then
    echo "patch-credentialsd-xpi: $XPI not found (is credentialsd installed?)" >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd "$work"
unzip -q "$XPI"

if grep -q '"<all_urls>"' manifest.json; then
    echo "patch-credentialsd-xpi: add-on already matches all sites, nothing to do"
    exit 0
fi

# manifest: run everywhere, and bump the version so Firefox notices the change
python3 - <<'EOF'
import json
m = json.load(open("manifest.json"))
for cs in m["content_scripts"]:
    cs["matches"] = ["<all_urls>"]
m["version"] = m["version"] + ".1"
json.dump(m, open("manifest.json", "w"), indent=2)
EOF

# content script: capture the page's own create/get before they are replaced,
# and hand back anything credentialsd should not handle
python3 - <<'EOF'
import re
src = open("content.js").read()

src = src.replace(
    'exportFunction(createCredential, navigator.credentials, { defineAs: "create"})',
    'const pageCredentials = window.wrappedJSObject.navigator.credentials;\n'
    'const pageCreate = pageCredentials.create;\n'
    'const pageGet = pageCredentials.get;\n'
    'function passThrough(request) {\n'
    '    return !request || !request.publicKey || request.mediation === "conditional";\n'
    '}\n'
    'exportFunction(createCredential, navigator.credentials, { defineAs: "create"})',
    1)

src = re.sub(
    r'(function createCredential\(request\) \{\n)',
    r'\1    if (passThrough(request)) return pageCreate.call(pageCredentials, request);\n',
    src, count=1)
src = re.sub(
    r'(function getCredential\(request\) \{\n)',
    r'\1    if (passThrough(request)) return pageGet.call(pageCredentials, request);\n',
    src, count=1)

assert src.count("passThrough(") == 3, "content.js did not match the expected 0.1.0 layout"
open("content.js", "w").write(src)
EOF

rm -f patched.xpi
zip -qr -X patched.xpi .
install -m644 patched.xpi "$XPI"
echo "patch-credentialsd-xpi: patched $XPI -> version $(python3 -c 'import json;print(json.load(open("manifest.json"))["version"])')"
echo "restart Firefox to load it"
