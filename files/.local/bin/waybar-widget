#!/usr/bin/env python3
"""Feeders for the custom modules in ~/.config/waybar/config.jsonc.

    waybar-widget media-status   stream: {"alt": playing|paused|stopped, ...}
    waybar-widget media-title    stream: {"text": "artist — title", ...}
    waybar-widget gpu            once:   {"text": "<util>%", "tooltip": ...}

The media commands follow `playerctl -F`, which stays alive while Spotify is
closed and reopened and prints one line per change, so waybar runs them without
an interval. JSON goes through json.dumps so titles with quotes or backslashes
cannot break the module.
"""
import json
import subprocess
import sys

PLAYER = "spotify"


def emit(obj):
    print(json.dumps(obj), flush=True)


def follow(fmt):
    proc = subprocess.Popen(
        ["playerctl", "-p", PLAYER, "metadata", "-F", "--format", fmt],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    for line in proc.stdout:
        yield line.rstrip("\n")


def media_status():
    for status in follow("{{status}}"):
        s = (status or "Stopped").lower()
        emit({"text": "", "alt": s, "class": s})


def media_title():
    for line in follow("{{status}}\t{{artist}}\t{{title}}\t{{album}}"):
        parts = (line.split("\t") + ["", "", "", ""])[:4]
        status, artist, title, album = parts
        if not status or not (artist or title):
            emit({"text": "", "class": "stopped"})  # empty text hides the module
            continue
        text = f"{artist} — {title}" if artist and title else (title or artist)
        tooltip = "\n".join(p for p in (title, artist, album) if p)
        emit({"text": text, "tooltip": tooltip, "class": status.lower()})


def gpu():
    try:
        out = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5, check=True,
        ).stdout.strip()
        util, temp, used, total = [p.strip() for p in out.split(",")]
    except (subprocess.SubprocessError, ValueError, FileNotFoundError):
        emit({"text": "--", "class": "unavailable"})
        return
    emit({
        "text": f"{util}%",
        "tooltip": f"GPU {util}%  ·  {temp}°C  ·  {int(used) / 1024:.1f} / {int(total) / 1024:.1f} GiB",
        "class": "hot" if int(temp) >= 85 else "",
    })


COMMANDS = {"media-status": media_status, "media-title": media_title, "gpu": gpu}

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd not in COMMANDS:
        sys.exit(f"usage: waybar-widget {{{'|'.join(COMMANDS)}}}")
    try:
        COMMANDS[cmd]()
    except KeyboardInterrupt:
        pass
