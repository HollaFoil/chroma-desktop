#!/bin/bash
# gen-monitors — write this machine's monitors into the config.
#
#   gen-monitors           detect the connected outputs and write all three
#                          places their names appear, then reload
#   gen-monitors --check   print what it would write, change nothing
#
# The repo ships one machine's three monitors, and their names have to agree
# across three files or workspaces land on outputs that are not there:
#
#   ~/.config/hypr/monitors.lua          one hl.monitor{} per output
#   ~/.config/hypr/state/monitors.json   workspace -> monitor map, read by conf/rules.lua
#
# Workspaces 1-10 are split by size: the largest monitor takes 1-5 and the
# rest are dealt out left to right, which is the layout the config assumes
# (1 is "the main one"). One monitor gets all ten. Edit state/monitors.json
# afterwards if you want a different split - it is only read, never merged.
#
# nwg-displays still owns monitors.lua if you would rather place the outputs
# in a GUI: it writes the same hl.monitor{} blocks. Run this afterwards to
# redistribute the workspaces over whatever it wrote.
set -uo pipefail

CHECK=0
case "${1:-}" in
    --check)   CHECK=1 ;;
    -h|--help) sed -n '2,21p' "$0"; exit 0 ;;
    "")        ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
esac

# Workspaces are banked per monitor: the primary gets 1-5, the next 11-15,
# then 21-25. Nobody types the tens digit - SUPER+1..5 means "the Nth
# workspace of the monitor under the pointer" (hypr/lib/workspaces.lua) and the
# bar relabels each bank 1-5 - but Hyprland has one global set of workspaces,
# so the ids have to differ. Keep PER_MON in step with
# hypr/lib/workspaces.lua's PER_MON.
PER_MON=5
BANK=10

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
MONITORS_LUA="$HYPR_DIR/monitors.lua"
STATE_JSON="$HYPR_DIR/state/monitors.json"

die() { echo "gen-monitors: $*" >&2; exit 1; }

command -v jq >/dev/null 2>&1 || die "jq is required"
MONS="$(hyprctl monitors -j 2>/dev/null)" || die "hyprctl is not answering; run this inside a Hyprland session"
[[ -n "$MONS" ]] || die "hyprctl returned nothing"

# Enabled outputs only, left to right.
mapfile -t BY_X < <(jq -r '[.[] | select(.disabled != true)] | sort_by(.x) | .[].name' <<<"$MONS")
[[ ${#BY_X[@]} -gt 0 ]] || die "no enabled monitors"

# The primary is the biggest one (ties: the focused one, then the leftmost).
# It gets workspace 1, so it should be the monitor you actually look at.
PRIMARY="$(jq -r '[.[] | select(.disabled != true)]
    | sort_by(-(.width * .height), (if .focused then 0 else 1 end), .x)
    | .[0].name' <<<"$MONS")"

# ---- workspace -> monitor -------------------------------------------
# The primary takes bank 0 (1-5), then the others left to right. Same order
# lib/workspaces.lua derives when this file does not exist yet, so running
# this later renumbers nothing.
MON_ORDER=("$PRIMARY")
for m in "${BY_X[@]}"; do [[ "$m" == "$PRIMARY" ]] || MON_ORDER+=("$m"); done

declare -A WS_OF WS_LIST WS_LABEL
ALL_WS=()
slot=0
for m in "${MON_ORDER[@]}"; do
    for ((n = 1; n <= PER_MON; n++)); do
        ws=$(( slot * BANK + n ))
        WS_OF[$ws]="$m"
        WS_LABEL[$ws]="$n"                              # what the bar shows
        WS_LIST[$m]="${WS_LIST[$m]:+${WS_LIST[$m]}, }$ws"
        ALL_WS+=("$ws")
    done
    slot=$((slot + 1))
done

# ---- what to write --------------------------------------------------
monitors_lua() {
    echo "-- Generated by gen-monitors on $(date '+%Y-%m-%d at %H:%M:%S'). Do not edit manually."
    echo "-- (nwg-displays writes this file too, in the same shape.)"
    echo
    jq -r '[.[] | select(.disabled != true)] | sort_by(.x) | .[] |
        "hl.monitor({\n    output = \"\(.name)\",\n" +
        "    mode = \"\(.width)x\(.height)@\((.refreshRate * 100 | round) / 100)\",\n" +
        "    position = \"\(.x)x\(.y)\",\n" +
        "    scale = \(.scale),\n" +
        (if (.transform // 0) != 0 then "    transform = \(.transform),\n" else "" end) +
        "    vrr = \(if .vrr then 1 else 0 end)\n})"' <<<"$MONS"
}

# Only the workspace -> monitor map: rules.lua derives each monitor's default
# workspace from it (the lowest one), so there is nothing here to fall out of
# step with itself.
state_json() {
    local pairs=""
    for ws in "${ALL_WS[@]}"; do
        pairs+="${pairs:+,}$(jq -nc --arg k "$ws" --arg v "${WS_OF[$ws]}" '{($k): $v}' | sed 's/^{//;s/}$//')"
    done
    jq -n --argjson ws_home "{$pairs}" \
        '{_comment: "Written by gen-monitors, read by hypr/lib/workspaces.lua: which monitor owns each workspace.",
          ws_home: $ws_home}'
}

# The bar (quickshell, Bar/WorkspacesModule.qml) watches state/monitors.json
# itself, so there is no bar config to patch and nothing to restart.

# ---- report / write -------------------------------------------------
echo "primary (owns workspace 1): $PRIMARY"
for m in "${MON_ORDER[@]}"; do
    printf '  %-12s SUPER+1..%d -> workspaces %s\n' "$m" "$PER_MON" "${WS_LIST[$m]}"
done

if [[ $CHECK == 1 ]]; then
    echo
    echo "--- $MONITORS_LUA"; monitors_lua
    echo "--- $STATE_JSON"; state_json
    exit 0
fi

write_through() {                                   # keep the dotfiles symlink, replace the file it points at
    local path="$1" target
    target="$(readlink -f "$path" 2>/dev/null || echo "$path")"
    mkdir -p "$(dirname "$target")"
    cat > "$target"
    echo "  wrote $path"
}

monitors_lua | write_through "$MONITORS_LUA"
state_json   | write_through "$STATE_JSON"

hyprctl reload >/dev/null 2>&1 && echo "  reloaded hyprland"
