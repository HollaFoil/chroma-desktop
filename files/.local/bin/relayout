#!/bin/bash
# relayout — place the dashboard layout on one monitor, keep the others usable.
#
#   relayout            re-apply the current profile
#   relayout main       dashboard on the main monitor
#   relayout alt        dashboard on the alt monitor
#   relayout toggle     switch to the other monitor
#   relayout --boot     as above, but launch missing apps and wait for them
#
# Invariants this script maintains:
#   * every dashboard app is floating, unpinned, un-fullscreened and placed
#     at an absolute position on the profile's dashboard workspace
#   * dashboard apps not used by the active profile are parked in the
#     scratchpad (special:magic, revealed with SUPER+S)
#   * the dashboard workspace is the visible one on its monitor
#   * the other monitor shows its work workspace, not a stale dashboard one
#   * window rules are re-injected so apps restarted later land correctly
#   * focus is returned to wherever it was before the script ran

set -uo pipefail

# ---- profiles ------------------------------------------------------
# layout rows: "class x y w h" as percentages of the usable area
# (monitor minus waybar). x+w and y+h should reach 100.

MAIN_MON="HDMI-A-1"
MAIN_DASH_WS=1
MAIN_WORK_WS=2
MAIN_LAYOUT=(
    "Spotify         0   0  32 100"
    "slack          32   0  26  50"
    "vesktop        32  50  40  50"
    "layout-sysmon  58   0  42  50"
    "homelab-dash   72  50  28  50"
)

ALT_MON="DP-2"
ALT_DASH_WS=6
ALT_WORK_WS=7
ALT_LAYOUT=(
    "slack           0   0  55  44"
    "vesktop         0  44  55  56"
    "layout-sysmon  55   0  45  58"
    "homelab-dash   55  58  45  42"
)

# ---- general config ------------------------------------------------
BAR=46                      # waybar footprint
GAP=8                       # gap between windows
SETTLE=0.06                 # pause after the float toggle
STASH_WS="special:magic"    # where dashboard apps this profile doesn't use go
STATE="$HOME/.cache/relayout-target"
LUA_STATE="$HOME/.cache/relayout-state.lua"
ALL_APPS=(Spotify slack vesktop layout-sysmon homelab-dash)

# Which monitor each workspace belongs to. This is the source of truth:
# relayout writes it into the Lua state file and hyprland.lua turns it into
# workspace rules. (hyprland.lua keeps an identical inline copy purely as a
# bootstrap fallback for the first run, before this file exists.)
WS_HOME=(
    "1 HDMI-A-1" "2 HDMI-A-1" "3 HDMI-A-1" "4 HDMI-A-1" "5 HDMI-A-1"
    "6 DP-2"     "7 DP-2"     "8 DP-2"
    "9 HDMI-A-2" "10 HDMI-A-2"
)
CLASS_RE='^(Spotify|slack|vesktop|layout-sysmon|homelab-dash)$'
# Windows allowed to open on the dashboard workspace anyway: deliberate
# overlays that are meant to appear on top of whatever you are looking at.
GUARD_EXEMPT=(cheatsheet hyprland-run)
LAUNCH=0                    # --boot turns this on
# --------------------------------------------------------------------

usage() {
    sed -n '2,14p' "$0" | sed 's/^# \?//'
}

log() { [[ -n "${RELAYOUT_QUIET:-}" ]] || echo "$@"; }

ARG=""
for a in "$@"; do
    case "$a" in
        --boot)          LAUNCH=1 ;;
        --launch)        LAUNCH=1 ;;
        --no-launch)     LAUNCH=0 ;;
        -h|--help)       usage; exit 0 ;;
        main|alt|toggle) ARG="$a" ;;
        *) echo "unknown argument: $a" >&2; usage >&2; exit 1 ;;
    esac
done

mkdir -p "$(dirname "$STATE")"

# Two runs interleaving their dispatches produces a half-applied layout, which
# is exactly what mashing the keybind used to do. Drop the second press rather
# than queueing it — a queued toggle would just undo the one still running.
exec 9>"$HOME/.cache/relayout.lock"
if ! flock -n 9; then
    echo "relayout already running; ignoring this invocation" >&2
    exit 0
fi

CURRENT=$(cat "$STATE" 2>/dev/null || echo main)
[[ "$CURRENT" == "main" || "$CURRENT" == "alt" ]] || CURRENT=main

case "$ARG" in
    main)   TARGET=main ;;
    alt)    TARGET=alt ;;
    toggle) [[ "$CURRENT" == "main" ]] && TARGET=alt || TARGET=main ;;
    "")     TARGET="$CURRENT" ;;
esac

if [[ "$TARGET" == "main" ]]; then
    MON=$MAIN_MON;  DASH_WS=$MAIN_DASH_WS;  WORK_WS=$MAIN_WORK_WS
    OTHER_MON=$ALT_MON; OTHER_DASH_WS=$ALT_DASH_WS; OTHER_WORK_WS=$ALT_WORK_WS
    LAYOUT=("${MAIN_LAYOUT[@]}")
else
    MON=$ALT_MON;   DASH_WS=$ALT_DASH_WS;   WORK_WS=$ALT_WORK_WS
    OTHER_MON=$MAIN_MON; OTHER_DASH_WS=$MAIN_DASH_WS; OTHER_WORK_WS=$MAIN_WORK_WS
    LAYOUT=("${ALT_LAYOUT[@]}")
fi
printf '%s' "$TARGET" > "$STATE"

# which apps this profile uses
LAYOUT_APPS=()
for row in "${LAYOUT[@]}"; do LAYOUT_APPS+=("${row%% *}"); done

in_layout() {
    local a
    for a in "${LAYOUT_APPS[@]}"; do [[ "$a" == "$1" ]] && return 0; done
    return 1
}

# ---- window rules --------------------------------------------------
# Written to a Lua file that hyprland.lua reads (so they survive a reload,
# e.g. the one matugen fires on every wallpaper change) and also injected
# live so they take effect without one.
write_rules() {
    local used_re parked_re guard_re
    used_re="^($(IFS='|'; echo "${LAYOUT_APPS[*]}"))\$"
    # matched by the guard = everything EXCEPT the dashboard apps and the
    # deliberate overlays. Hyprland's matcher has no boolean negation, but a
    # "negative:" prefix on the value inverts it (verified; a regex negative
    # lookahead is NOT supported and matches nothing).
    guard_re="negative:^($(IFS='|'; echo "${ALL_APPS[*]} ${GUARD_EXEMPT[*]}" | tr ' ' '|'))\$"
    local parked=()
    local c
    for c in "${ALL_APPS[@]}"; do in_layout "$c" || parked+=("$c"); done

    {
        echo "-- generated by relayout; do not edit"
        echo "return {"
        echo "    profile   = \"$TARGET\","
        echo "    monitor   = \"$MON\","
        echo "    dash_ws   = $DASH_WS,"
        echo "    work_ws   = $WORK_WS,"
        echo "    used_re   = [[$used_re]],"
        echo "    guard_re  = [[$guard_re]],"
        if ((${#parked[@]})); then
            parked_re="^($(IFS='|'; echo "${parked[*]}"))\$"
            echo "    parked_re = [[$parked_re]],"
        fi
        echo "    stash_ws  = [[$STASH_WS]],"
        echo "    ws_home   = {"
        local e
        for e in "${WS_HOME[@]}"; do
            echo "        [${e%% *}] = \"${e##* }\","
        done
        echo "    },"
        echo "}"
    } > "$LUA_STATE"

    # guard: anything that is not a dashboard app must not squat the
    # dashboard workspace. Not silent — the user should see what they opened.
    hyprctl eval "hl.window_rule({ name = \"relayout-dash-guard\",
        match = { workspace = \"$DASH_WS\", class = [[$guard_re]] },
        workspace = \"$WORK_WS\" })" >/dev/null
    # dashboard apps this profile uses belong on the dashboard workspace
    hyprctl eval "hl.window_rule({ name = \"relayout-dash-apps\",
        match = { class = [[$used_re]] }, workspace = \"$DASH_WS silent\", float = true })" >/dev/null
    # dashboard apps this profile does not use go straight to the scratchpad
    if ((${#parked[@]})); then
        parked_re="^($(IFS='|'; echo "${parked[*]}"))\$"
        hyprctl eval "hl.window_rule({ name = \"relayout-dash-parked\",
            match = { class = [[$parked_re]] }, workspace = \"$STASH_WS silent\", float = true })" >/dev/null
    else
        hyprctl eval "hl.window_rule({ name = \"relayout-dash-parked\",
            match = { class = [[^\$relayout-never\$]] } })" >/dev/null
    fi
}

# ---- monitor geometry ----------------------------------------------
MW=""
for _ in $(seq 1 10); do
    read -r MX MY MW MH < <(
      hyprctl monitors -j | jq -r --arg m "$MON" \
        '.[] | select(.name==$m) | "\(.x) \(.y) \(.width) \(.height)"'
    )
    [[ -n "${MW:-}" ]] && break
    sleep 1
done
if [[ -z "${MW:-}" ]]; then
    # The alt monitor being unplugged should not leave the dashboard nowhere.
    if [[ "$TARGET" == "alt" ]]; then
        echo "monitor $MON not found; falling back to $MAIN_MON" >&2
        TARGET=main
        MON=$MAIN_MON; DASH_WS=$MAIN_DASH_WS; WORK_WS=$MAIN_WORK_WS
        OTHER_MON=$ALT_MON; OTHER_DASH_WS=$ALT_DASH_WS; OTHER_WORK_WS=$ALT_WORK_WS
        LAYOUT=("${MAIN_LAYOUT[@]}")
        LAYOUT_APPS=(); for row in "${LAYOUT[@]}"; do LAYOUT_APPS+=("${row%% *}"); done
        printf '%s' "$TARGET" > "$STATE"
        write_rules
        read -r MX MY MW MH < <(
          hyprctl monitors -j | jq -r --arg m "$MON" \
            '.[] | select(.name==$m) | "\(.x) \(.y) \(.width) \(.height)"'
        )
    fi
    if [[ -z "${MW:-}" ]]; then
        echo "monitor $MON not found" >&2
        exit 1
    fi
fi

# scale-aware: hyprctl reports width/height in pixels, positions in layout
# coords. With scale=1 (the case here) they are the same.
UX=$MX
UY=$(( MY + BAR ))
UW=$MW
UH=$(( MH - BAR ))
HG=$(( GAP / 2 ))

# ---- workspace homing ----------------------------------------------
# Workspace rules only bind a workspace to a monitor when it is *created*.
# A workspace that already exists on the wrong monitor stays there through a
# `hyprctl reload`, which is why dragging a window to a fresh workspace on the
# wrong screen used to be sticky until a logout. Repair it here instead.
rehome_workspaces() {
    local e ws want have moved=0
    local live; live=$(hyprctl workspaces -j)
    for e in "${WS_HOME[@]}"; do
        ws="${e%% *}"; want="${e##* }"
        have=$(printf '%s' "$live" | jq -r --argjson w "$ws" \
            '.[] | select(.id==$w) | .monitor')
        [[ -z "$have" || "$have" == "$want" ]] && continue
        hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$ws\", monitor = \"$want\" })" >/dev/null
        log "  re-homed ws$ws: $have -> $want"
        moved=1
    done
    return $moved
}

# ---- client cache --------------------------------------------------
CLIENTS=""
refresh_clients() { CLIENTS=$(hyprctl clients -j); }

# Some apps map several toplevels under one class: Slack's huddle and
# screen-share windows are all class "slack", and Discord does the same for
# calls. Taking .[0] meant relayout could place a transient call popup into the
# main window's slot, and which one it got was down to Hyprland's list order.
#
# Prefer the LARGEST window of the class: a main window is always far bigger
# than these popups. Tie-break on address so repeated runs are deterministic
# rather than flipping between equally-sized windows.
#
# If area is ever not enough, add a title regex below and it is applied first;
# it falls back to the unfiltered set if it matches nothing, so a wrong regex
# degrades to the old behaviour instead of losing the window entirely.
declare -A MAIN_TITLE_RE=(
    # [slack]="Slack$"
)

# The single place that decides which window of a class relayout acts on.
main_of() {  # class -> that window's JSON object, or nothing
    local re="${MAIN_TITLE_RE[$1]:-}"
    printf '%s' "$CLIENTS" | jq -c --arg c "$1" --arg re "$re" '
        [ .[] | select(.class == $c) ] as $all
        | ( if $re == "" then $all
            else ( $all | map(select((.title // "") | test($re))) ) end ) as $named
        | ( if ($named | length) > 0 then $named else $all end )
        | if length == 0 then empty
          else ( sort_by([ -(.size[0] * .size[1]), .address ]) | .[0] )
          end'
}

field_of() {  # class, jq-field
    local w; w=$(main_of "$1")
    [[ -z "$w" ]] && { printf ''; return; }
    printf '%s' "$w" | jq -r --arg f "$2" '.[$f] // "" | tostring'
}
addr_of()    { field_of "$1" address; }
running()    { [[ -n "$(addr_of "$1")" ]]; }

place() {
    local class="$1" xp="$2" yp="$3" wp="$4" hp="$5"
    local addr x y w h fs pinned pre=""

    addr=$(addr_of "$class")
    if [[ -z "$addr" || "$addr" == "null" ]]; then
        log "  skipped (not running): $class"
        return 1
    fi

    fs=$(field_of "$class" fullscreen)
    pinned=$(field_of "$class" pinned)
    # only issue these when they apply — "unset"/"disable" on a window that is
    # not fullscreen/pinned is a no-op at best and a toggle at worst
    [[ "$fs" != "0" ]]      && pre="$pre dispatch hl.dsp.window.fullscreen({ action = \"unset\" }) ;"
    [[ "$pinned" == "true" ]] && pre="$pre dispatch hl.dsp.window.pin({ action = \"disable\" }) ;"

    x=$(( UX + UW * xp / 100 + HG ))
    y=$(( UY + UH * yp / 100 + HG ))
    w=$(( UW * wp / 100 - GAP ))
    h=$(( UH * hp / 100 - GAP ))

    hyprctl --batch \
"dispatch hl.dsp.focus({ window = \"address:$addr\" }) ;$pre \
dispatch hl.dsp.window.float({ action = \"enable\" }) ; \
dispatch hl.dsp.window.move({ workspace = $DASH_WS })" >/dev/null

    [[ "$SETTLE" != "0" ]] && sleep "$SETTLE"

    hyprctl --batch \
"dispatch hl.dsp.window.resize({ x = $w, y = $h }) ; \
dispatch hl.dsp.window.move({ x = $x, y = $y })" >/dev/null

    log "  placed $class  ${w}x${h} at ${x},${y}"
}

stash() {
    local class="$1" addr fs pre=""
    addr=$(addr_of "$class")
    [[ -z "$addr" || "$addr" == "null" ]] && return
    fs=$(field_of "$class" fullscreen)
    [[ "$fs" != "0" ]] && pre="$pre dispatch hl.dsp.window.fullscreen({ action = \"unset\" }) ;"
    [[ "$(field_of "$class" pinned)" == "true" ]] && pre="$pre dispatch hl.dsp.window.pin({ action = \"disable\" }) ;"
    # Give it a definite size and position too. A stashed window keeps the
    # coordinates it had on the monitor it came from, and Hyprland clamps it
    # onto the stash monitor lazily — one relayout later — which made the whole
    # layout take two runs to settle. Placing it explicitly keeps one run enough,
    # and means it looks sensible when SUPER+S reveals it.
    local sx sy sw sh
    sw=$(( UW * 60 / 100 )); sh=$(( UH * 70 / 100 ))
    sx=$(( UX + (UW - sw) / 2 )); sy=$(( UY + (UH - sh) / 2 ))
    hyprctl --batch \
"dispatch hl.dsp.focus({ window = \"address:$addr\" }) ;$pre \
dispatch hl.dsp.window.float({ action = \"enable\" }) ; \
dispatch hl.dsp.window.move({ workspace = \"$STASH_WS\" }) ; \
dispatch hl.dsp.window.resize({ x = $sw, y = $sh }) ; \
dispatch hl.dsp.window.move({ x = $sx, y = $sy })" >/dev/null
    log "  stashed $class to $STASH_WS"
}

# Moving a window to a special workspace *shows* that workspace on the monitor
# it happened on — there is no silent variant of the move (silent=true parses
# but is ignored). Left visible, the scratchpad overlays the dashboard and, worse,
# every window opened afterwards lands inside it. So put it away again.
hide_stash() {
    local m name="${STASH_WS#special:}"
    for m in $(hyprctl monitors -j | jq -r --arg s "$STASH_WS" \
                 '.[] | select(.specialWorkspace.name == $s) | .name'); do
        hyprctl --batch \
"dispatch hl.dsp.focus({ monitor = \"$m\" }) ; \
dispatch hl.dsp.workspace.toggle_special(\"$name\")" >/dev/null
        log "  hid $STASH_WS on $m"
    done
}

# NB the `9>&-` on every line. Without it the launched app inherits the lock
# file descriptor and keeps the lock held for as long as it runs, so the very
# first --boot leaves SUPER+SHIFT+R and SUPER+ALT+R silently doing nothing for
# the rest of the session.
launch() {
    case "$1" in
        Spotify)       setsid spotify-launcher >/dev/null 2>&1 9>&- & ;;
        slack)         setsid slack            >/dev/null 2>&1 9>&- & ;;
        vesktop)       setsid vesktop          >/dev/null 2>&1 9>&- & ;;
        layout-sysmon) setsid kitty --class layout-sysmon -o font_size=9 -e btop >/dev/null 2>&1 9>&- & ;;
        homelab-dash)  setsid "$HOME/.local/bin/homelab-dash" >/dev/null 2>&1 9>&- & ;;
    esac
}

# ---- go ------------------------------------------------------------
write_rules

# remember where the user was
FOCUS_BEFORE=$(hyprctl activewindow -j | jq -r '.address // empty')
FOCUS_CLASS=$(hyprctl activewindow -j | jq -r '.class // empty')

if [[ "$LAUNCH" == "1" ]]; then
    # Start *every* dashboard app, not just the ones this profile shows.
    # Spotify has no slot in the alt layout, but it still belongs to the
    # session — booting into alt used to mean it never started at all, and
    # toggling to main afterwards found nothing to place.
    refresh_clients
    for c in "${ALL_APPS[@]}"; do running "$c" || launch "$c"; done
    for i in $(seq 1 90); do
        refresh_clients
        missing=""
        for c in "${ALL_APPS[@]}"; do running "$c" || missing="$missing $c"; done
        [[ -z "$missing" ]] && break
        (( i % 5 == 0 )) && log "  waiting for:$missing"
        sleep 1
    done
    sleep 1
else
    # Interactive run: never block a keybind waiting for Discord to start.
    # Kick off anything missing in the background — the window rules put it on
    # the right workspace when it maps, and the next SUPER+SHIFT+R slots it in.
    refresh_clients
    for c in "${LAYOUT_APPS[@]}"; do
        running "$c" || { log "  launching $c in the background"; launch "$c"; }
    done
fi

rehome_workspaces
refresh_clients
log "[$TARGET] dashboard on $MON ws$DASH_WS (${MW}x${MH} at ${MX},${MY})"

for row in "${LAYOUT[@]}"; do
    # shellcheck disable=SC2086
    place $row
done

for c in "${ALL_APPS[@]}"; do
    in_layout "$c" || stash "$c"
done
hide_stash

# Verify, and re-place anything that did not land. Moving a floating window
# between monitors is asynchronous — Hyprland can re-clamp it just after the
# batch lands — so trust the reported geometry, not the dispatch return value.
for attempt in 1 2; do
    refresh_clients
    bad_rows=()
    for row in "${LAYOUT[@]}"; do
        set -- $row
        cl="$1"; xp="$2"; yp="$3"; wp="$4"; hp="$5"
        addr=$(addr_of "$cl"); [[ -z "$addr" || "$addr" == "null" ]] && continue
        want_x=$(( UX + UW * xp / 100 + HG )); want_y=$(( UY + UH * yp / 100 + HG ))
        want_w=$(( UW * wp / 100 - GAP ));     want_h=$(( UH * hp / 100 - GAP ))
        # Same selection as place() used, so the check cannot land on a
        # different window of the same class.
        win=$(main_of "$cl"); [[ -z "$win" ]] && continue
        got_ws=$(printf '%s' "$win" | jq -r '.workspace.id')
        read -r got_x got_y got_w got_h < <(printf '%s' "$win" | jq -r \
            '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')
        if [[ "$got_ws" != "$DASH_WS" ]] \
           || (( got_x != want_x || got_y != want_y || got_w != want_w || got_h != want_h )); then
            bad_rows+=("$row")
        fi
    done
    ((${#bad_rows[@]} == 0)) && break
    log "  re-placing after attempt $attempt: ${bad_rows[*]%% *}"
    for row in "${bad_rows[@]}"; do
        # shellcheck disable=SC2086
        place $row
    done
done
if ((${#bad_rows[@]})); then
    for row in "${bad_rows[@]}"; do echo "warning: ${row%% *} did not settle into its slot" >&2; done
fi

# Don't leave the monitor we just vacated showing an empty dashboard workspace.
OTHER_ACTIVE=$(hyprctl monitors -j | jq -r --arg m "$OTHER_MON" \
    '.[] | select(.name==$m) | .activeWorkspace.id')
if [[ "$OTHER_ACTIVE" == "$OTHER_DASH_WS" ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = $OTHER_WORK_WS })" >/dev/null
    log "  $OTHER_MON switched off vacated dashboard ws$OTHER_DASH_WS -> ws$OTHER_WORK_WS"
fi

# make the dashboard the visible workspace on its monitor
hyprctl dispatch "hl.dsp.focus({ workspace = $DASH_WS })" >/dev/null

# Put focus back where it was — but only if that window is on a different
# monitor. If the user was on the dashboard monitor, they just asked for the
# dashboard to be there, so the dashboard keeps the screen.
if [[ -n "$FOCUS_BEFORE" ]]; then
    refresh_clients
    read -r F_MON F_CLASS < <(printf '%s' "$CLIENTS" | jq -r --arg a "$FOCUS_BEFORE" \
        '.[] | select(.address==$a) | "\(.monitor) \(.class)"')
    MON_ID=$(hyprctl monitors -j | jq -r --arg m "$MON" '.[]|select(.name==$m)|.id')
    if [[ -z "${F_MON:-}" ]]; then
        log "  focus not restored (window is gone)"
    elif [[ "$F_CLASS" =~ $CLASS_RE ]] && ! in_layout "$F_CLASS"; then
        log "  focus not restored ($F_CLASS was stashed)"
    elif [[ "$F_MON" == "$MON_ID" ]]; then
        log "  focus kept on the dashboard ($F_CLASS shares $MON)"
    else
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$FOCUS_BEFORE\" })" >/dev/null
        log "  focus restored to ${F_CLASS:-$FOCUS_BEFORE}"
    fi
fi
