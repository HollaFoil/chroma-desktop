#!/usr/bin/env python3
"""Build the ~/.local/share/icons/Matugen icon theme from Adwaita.

Adwaita's folders (scalable/places) and the accents in its mimetypes are drawn
from a fixed set of GNOME blues. Every one of those hexes is remapped onto the
matugen primary: same hue as the primary, saturation scaled by the ratio of
the primary to Adwaita's folder face, lightness shifted so the folder face
lands exactly on the primary. Every other colour (paper greys, the green
trash, the red server LED) is left alone, so the recolour keeps Adwaita's
shading intact and only moves the blue channel of the theme.

Everything Adwaita ships that is not places or mimetypes is symlinked in
unchanged, and the theme inherits breeze-dark for the app icons Adwaita no
longer carries. 16x16/places and 16x16/mimetypes are dropped from the index
on purpose: they are pre-rendered PNGs in the stock blue, and without them
GTK rasterises the recoloured SVGs at 16px instead.

Matugen runs this as the post_hook of its `icons` template; run it by hand
to rebuild the theme from the current icon-colors.sh.
"""

import colorsys
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
COLORS = HOME / ".config/matugen/generated/icon-colors.sh"
ADWAITA = Path("/usr/share/icons/Adwaita")
THEME = HOME / ".local/share/icons/Matugen"

RECOLOURED_DIRS = {"scalable/places", "scalable/mimetypes"}
DROPPED_DIRS = {"16x16/places", "16x16/mimetypes"}

# The folder's front face; the primary is anchored to it and every other
# blue keeps its lightness/saturation offset from it.
FACE = "#a4caee"

# Every blue Adwaita uses in places/ and mimetypes/ (the GNOME palette blues
# plus the folder's own gradient stops). Anything not listed is left as is.
BLUES = [
    "#d7e8fc", "#d3e3f9", "#b3d3f9", "#afd4ff", "#c0d5ea", "#a4caee",
    "#99c1f1", "#98c1f1", "#76aaeb", "#62a0ea", "#438de6", "#4a86cf",
    "#3584e4", "#1c71d8", "#1a5fb4", "#204a87", "#154a8d", "#14498a",
    "#113e74",
]

HEX_RE = re.compile(r"#[0-9a-fA-F]{6}\b")


def hex_to_hls(h):
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return colorsys.rgb_to_hls(r, g, b)


def hls_to_hex(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return "#%02x%02x%02x" % tuple(round(max(0.0, min(1.0, c)) * 255) for c in (r, g, b))


def read_colors():
    colors = {}
    try:
        for line in COLORS.read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                colors[k.strip()] = v.strip()
    except FileNotFoundError:
        sys.exit(f"matugen-icons: {COLORS} not found, run setwall first")
    return colors


def build_palette(anchor):
    """Map every source blue onto the anchor colour's hue."""
    ah, al, asat = hex_to_hls(anchor)
    fh, fl, fsat = hex_to_hls(FACE)
    dl = al - fl
    ks = asat / fsat if fsat else 1.0
    out = {}
    for src in BLUES:
        _, l, s = hex_to_hls(src)
        out[src] = hls_to_hex(ah, max(0.04, min(0.97, l + dl)), min(1.0, s * ks))
    return out


def recolour(svg, palette):
    return HEX_RE.sub(lambda m: palette.get(m.group(0).lower(), m.group(0)), svg)


def write_atomic(path, text):
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def link(dst, src):
    """Point dst at src, replacing whatever is there."""
    if dst.is_symlink():
        if os.readlink(dst) == str(src):
            return
        dst.unlink()
    elif dst.exists():
        sys.exit(f"matugen-icons: {dst} exists and is not a symlink, refusing to replace it")
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.symlink_to(src)


def build_index(src_index):
    """Adwaita's index.theme with our header and the PNG dirs dropped."""
    out = []
    skipping = False
    for line in src_index.splitlines():
        if line.startswith("["):
            section = line.strip("[]")
            skipping = section in DROPPED_DIRS
            if skipping:
                continue
            out.append(line)
            continue
        if skipping:
            continue
        if line.startswith("Name="):
            out.append("Name=Matugen")
        elif line.startswith("Comment="):
            out.append("Comment=Adwaita with folders and file accents recoloured by matugen")
        elif line.startswith("Inherits="):
            out.append("Inherits=breeze-dark,hicolor")
            out.append("FollowsColorScheme=true")
        elif line.startswith("Hidden="):
            continue
        elif line.startswith("Directories="):
            dirs = [d for d in line[len("Directories="):].split(",") if d and d not in DROPPED_DIRS]
            out.append("Directories=" + ",".join(dirs) + ",")
        else:
            out.append(line)
    return "\n".join(out) + "\n", dirs


def main():
    colors = read_colors()
    # primary.dark is the light tone of the primary (T80) whatever mode
    # matugen ran in, so the icons look the same in light and dark schemes,
    # the way Adwaita's own do.
    anchor = colors.get("PRIMARY_DARK") or colors.get("PRIMARY")
    if not anchor:
        sys.exit(f"matugen-icons: no PRIMARY_DARK in {COLORS}")
    palette = build_palette(anchor)

    if not (ADWAITA / "index.theme").is_file():
        sys.exit(f"matugen-icons: {ADWAITA} not found, install adwaita-icon-theme")
    index_text, dirs = build_index((ADWAITA / "index.theme").read_text())
    THEME.mkdir(parents=True, exist_ok=True)

    for d in dirs:
        src = ADWAITA / d
        dst = THEME / d
        if not src.is_dir():
            continue
        if d not in RECOLOURED_DIRS:
            link(dst, src)
            continue
        if dst.is_symlink():
            dst.unlink()
        dst.mkdir(parents=True, exist_ok=True)
        wanted = set()
        for svg in sorted(src.glob("*.svg")):
            wanted.add(svg.name)
            write_atomic(dst / svg.name, recolour(svg.read_text(), palette))
        for stale in dst.iterdir():
            if stale.name not in wanted:
                stale.unlink()

    write_atomic(THEME / "index.theme", index_text)
    os.utime(THEME)
    print(f"matugen-icons: {THEME} built from {anchor}")

    # GTK only rescans a theme dir on the next icon lookup, and an idle Nemo
    # never makes one, so a rebuilt theme stays invisible until something
    # else redraws. Bouncing the gsettings key fires GtkIconTheme::changed in
    # every GTK app, which flushes their icon caches and repaints (the same
    # trick the gtk3 template's post_hook uses for the widget theme).
    if shutil.which("gsettings"):
        for name in ("", "Matugen"):
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", name], check=False)


if __name__ == "__main__":
    main()
