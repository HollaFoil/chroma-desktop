#!/usr/bin/env python3
"""volpop - a one-glance audio popup for the waybar volume module.

Opens as a layer-shell surface, not a window: a transparent overlay covering the
focused output with the card tucked under the bar's right edge. Clicking
anywhere outside the card, pressing Escape, or running volpop again closes it.

    [speaker] ─────●──── 75%    ▾ HyperX Cloud III
    [mic]     ───●────── 60%    ▾ HyperX Cloud III
    Apps ▸   (per-stream rows: icon, name, slider, mute)

Reads and writes PulseAudio/PipeWire through pactl's JSON output, and follows
`pactl subscribe` so a volume key or a new stream updates the sliders live.

Theming is matugen: ~/.config/waybar/colors.css (86 @define-color rules,
valid GTK CSS) is concatenated with STYLE below, so the popup matches the bar
and retints on the next setwall. Stdlib + PyGObject only.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

COLORS = Path.home() / ".config/waybar/colors.css"
PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "volpop.pid"

BAR_HEIGHT = 37       # matches "height" in waybar's config.jsonc
MARGIN_TOP = 6
MARGIN_RIGHT = 10

STYLE = """
* {
  font-family: "GeistMono Nerd Font Propo", "MesloLGS Nerd Font Propo", monospace;
  font-size: 13px;
  font-weight: bold;
  color: @on_surface;
}
window { background: transparent; }
.popup {
  background: alpha(@surface, 0.62); /* Hyprland blurs behind it (frosted-volpop layer rule) */
  border: none;
  border-radius: 24px 10px 24px 10px;
  padding: 14px 16px;
}
.row { min-height: 30px; }
.icon-btn {
  background: transparent;
  border: none;
  border-radius: 10px;
  padding: 4px 8px;
  font-size: 18px;
  color: @primary;
  min-width: 30px;
}
.icon-btn:hover { background: alpha(@primary, 0.15); }
button:focus { outline: none; box-shadow: none; }
.icon-btn.muted { color: @on_surface_variant; }
.pct { min-width: 44px; color: @on_surface_variant; font-size: 12px; }
scale { padding: 0; min-width: 190px; }
scale trough {
  background: @surface_container_highest;
  border-radius: 999px;
  min-height: 6px;
  border: none;
}
scale highlight { background: @primary; border-radius: 999px; }
scale slider {
  background: @primary;
  border-radius: 999px;
  min-width: 14px; min-height: 14px;
  margin: -5px;
  border: none;
  box-shadow: none;
}
