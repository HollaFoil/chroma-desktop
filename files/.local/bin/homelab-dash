FALLBACK_PALETTE = """
@define-color surface_dim #0f1417;
@define-color surface #0f1417;
@define-color surface_container #1b2023;
@define-color surface_container_high #262b2d;
@define-color on_surface #dee3e6;
@define-color on_surface_variant #c0c8cc;
@define-color outline #8a9296;
@define-color outline_variant #40484c;
@define-color primary #8ad0ee;
@define-color tertiary #c5c3ea;
@define-color ansi_green #95d5a8;
@define-color ansi_yellow #c9cc78;
@define-color ansi_red #ffb2b9;
"""


class Theme:
    """Concatenates matugen's palette with STYLE and reloads on file change.

    Colours are not shared across GTK4 CSS providers, so the palette and the
    rules that use it have to live in the same one.

    It also parses the palette into plain hex, because the icon tint is
    applied to pixels rather than by CSS: GTK can recolour a symbolic icon but
    not an arbitrary texture, so `color()` is how Icons finds out what the
    current scheme's foreground is, and `listeners` is how it learns that the
    answer just changed.
    """

    def __init__(self, colors_path: Path):
        self.colors_path = colors_path
        self.provider = Gtk.CssProvider()
        self.listeners: list = []
        self.palette: dict[str, str] = {}
        self._monitor = None
        self._debounce = 0
        self.apply()
        self._watch()

    def _palette_text(self) -> str:
        try:
            return self.colors_path.read_text()
        except OSError:
            # No matugen output yet: fall back to a neutral dark palette so the
            # panel is still legible rather than unstyled.
            return FALLBACK_PALETTE

    def color(self, name: str, fallback: str = "#c0c8cc") -> str:
        return self.palette.get(name, fallback)

    def apply(self):
        palette = self._palette_text()
        self.palette = dict(
            re.findall(r"@define-color\s+([a-z0-9_]+)\s+(#[0-9a-fA-F]{3,8})\s*;", palette)
        )
        self.provider.load_from_string(palette + "\n" + STYLE)

    def _watch(self):
        try:
            f = Gio.File.new_for_path(str(self.colors_path))
            self._monitor = f.monitor_file(Gio.FileMonitorFlags.NONE, None)
            self._monitor.connect("changed", self._changed)
        except GLib.Error:
            pass

    def _changed(self, _mon, _f, _other, event):
        if event not in (
            Gio.FileMonitorEvent.CHANGED,
            Gio.FileMonitorEvent.CREATED,
            Gio.FileMonitorEvent.RENAMED,
            Gio.FileMonitorEvent.CHANGES_DONE_HINT,
        ):
            return
        # matugen writes then post-hooks; coalesce the burst into one reload.
        if self._debounce:
            GLib.source_remove(self._debounce)
        self._debounce = GLib.timeout_add(180, self._reload)

    def _reload(self):
        self._debounce = 0
        self.apply()
        for fn in self.listeners:
            try:
                fn()
            except Exception:
                pass
        return GLib.SOURCE_REMOVE


# --------------------------------------------------------------------------
# icons
# --------------------------------------------------------------------------

ICON_DIR = "~/.cache/homelab-dash/icons"
ICON_RENDER = 96          # rasterise once at this size; tiles scale it down
ICON_URL = "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/{slug}.svg"
ICON_ROLES = ("on_surface_variant", "primary")


class Icons:
    """Service logos, monochrome and tinted from the current colour scheme.

    Fetched once from selfhst/icons and cached under ~/.cache. Nothing here
    blocks the UI: a slug with no cached file draws the monogram fallback and
    the real logo swaps in when the download lands, and a cached file is all
    that is ever read afterwards, so the panel starts fine offline.

    Two things make the marks a set rather than a pile of brand logos:

    * `-light` is preferred over the plain slug. Those variants are drawn as
      white ink for dark backgrounds, and -- this is the point -- they keep
      their cutouts, so nginx stays a hexagon with an N in it.
    * a `<slug>-symbolic.svg` from the installed icon themes fills the gaps.
      Jellyfin has no light variant and its mark is two overlapping chevrons,
      so flattening the colour original gave a featureless blob; the symbolic
      icon is the same shape with the hole still in it.
    * whatever comes back is then flattened to its alpha channel and refilled
      with a palette colour. That is what handles a logo with no light variant
      (Jellyfin) -- it becomes a silhouette -- and it is why the tint follows
      the wallpaper: Theme calls retint() when matugen rewrites the scheme.

    Sizes are normalised by Gtk.Image.set_pixel_size at the far end; this only
    has to produce one square texture per (slug, role).
    """

    def __init__(self, theme, on_ready=None):
        self.dir = expand(ICON_DIR)
        self.theme = theme
        self.on_ready = on_ready
        self._tex: dict[tuple, object] = {}
        self._pending: set[str] = set()
        self._failed: dict[str, float] = {}
        self._lock = threading.Lock()
        self._pool = ThreadPoolExecutor(max_workers=3, thread_name_prefix="icon")
        try:
            self.dir.mkdir(parents=True, exist_ok=True)
        except OSError:
            pass

    # -- public -----------------------------------------------------------
    def get(self, slug: str, role: str = ICON_ROLES[0]):
        """A tinted texture, or None while the artwork is missing."""
        key = (slug, role)
        if key in self._tex:
            return self._tex[key]
        png = self.dir / f"{slug}.mono.png"
        if not png.exists():
            self._fetch(slug)
            return None
        try:
            tex = self._tint(png, self.theme.color(role))
        except (GLib.Error, OSError, ValueError):
            tex = None
        self._tex[key] = tex
        return tex

    def retint(self):
        """Scheme changed; drop the tinted textures and rebuild on demand."""
        self._tex.clear()
        if self.on_ready is not None:
            self.on_ready()

    # -- internals --------------------------------------------------------
    @staticmethod
    def _rgb(hexstr: str) -> tuple:
        h = hexstr.lstrip("#")
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

    def _tint(self, png: Path, hexstr: str):
        """Keep the alpha channel, replace the colour with a flat fill."""
        pb = GdkPixbuf.Pixbuf.new_from_file(str(png))
        if not pb.get_has_alpha():
            pb = pb.add_alpha(False, 0, 0, 0)
        w, h = pb.get_width(), pb.get_height()
        src, stride, nch = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
        r, g, b = self._rgb(hexstr)
        n = w * h
        # Strided slices, not a per-pixel loop: this runs on the main thread
        # the first time a tile asks for an icon, and 96x96 times fifteen
        # services times two roles is enough to be felt as a hitch.
        alpha = bytearray(n)
        for y in range(h):
            start = y * stride + 3
            alpha[y * w:(y + 1) * w] = src[start:start + w * nch:nch]
        out = bytearray(n * 4)
        out[0::4] = bytes((r,)) * n
        out[1::4] = bytes((g,)) * n
        out[2::4] = bytes((b,)) * n
        out[3::4] = alpha
        return Gdk.MemoryTexture.new(
            w, h, Gdk.MemoryFormat.R8G8B8A8, GLib.Bytes.new(bytes(out)), w * 4
        )

    @staticmethod
    def _symbolic(slug: str):
        """A monochrome icon from the installed themes, if one is there.

        Symbolic icons are drawn to be recoloured, so they are exactly the
        right shape of artwork for this -- they just do not cover much.
        """
        roots = (expand("~/.local/share/icons"), Path("/usr/share/icons"))
        pats = (f"*/apps/symbolic/{slug}-symbolic.svg",
                f"*/scalable/apps/{slug}-symbolic.svg",
                f"*/apps/scalable/{slug}-symbolic.svg")
        for root in roots:
            for pat in pats:
                try:
                    hit = next(iter(sorted(root.glob(pat))), None)
                except OSError:
                    continue
                if hit is not None:
                    try:
                        return hit.read_bytes()
                    except OSError:
                        continue
        return None

    @staticmethod
    def _download(slug: str):
        try:
            with urllib.request.urlopen(ICON_URL.format(slug=slug), timeout=10) as r:
                return r.read()
        except Exception:
            return None

    def _fetch(self, slug: str):
        with self._lock:
            if slug in self._pending:
                return
            # Tiles ask for their icon on every repaint, so a slug that cannot
            # be fetched -- no network, or a typo in the config -- must not
            # turn into a request per frame.
            failed_at = self._failed.get(slug)
            if failed_at is not None and time.monotonic() - failed_at < 600.0:
                return
            self._pending.add(slug)
        self._pool.submit(self._work, slug)

    def _work(self, slug: str):
        ok = False
        try:
            # A user-supplied SVG in the cache dir wins over the download.
            local = self.dir / f"{slug}.svg"
            data = None
            if local.exists():
                data = local.read_bytes()
            else:
                # Best shape of artwork first: a light variant, then a
                # symbolic icon, then the colour original as a silhouette.
                for source in (lambda: self._download(f"{slug}-light"),
                               lambda: self._symbolic(slug),
                               lambda: self._download(slug)):
                    data = source()
                    if data:
                        break
            if not data:
                raise OSError(f"no icon for {slug}")
            loader = GdkPixbuf.PixbufLoader.new_with_mime_type("image/svg+xml")
            loader.set_size(ICON_RENDER, ICON_RENDER)
            loader.write(data)
            loader.close()
            pb = loader.get_pixbuf()
            if pb is None:
                raise OSError(f"could not rasterise {slug}")
            pb.savev(str(self.dir / f"{slug}.mono.png"), "png", [], [])
            ok = True
        except Exception:
            ok = False
        finally:
            with self._lock:
                self._pending.discard(slug)
                if ok:
                    self._failed.pop(slug, None)
                else:
                    self._failed[slug] = time.monotonic()
        if not ok:
            return
        if self.on_ready is not None:
            GLib.idle_add(self.on_ready, priority=GLib.PRIORITY_DEFAULT_IDLE)


# --------------------------------------------------------------------------
# widgets
# --------------------------------------------------------------------------

def dot(css_extra="dot"):
    d = Gtk.Box()
    d.add_css_class(css_extra)
    d.add_css_class(UNKNOWN)
    d.set_valign(Gtk.Align.CENTER)
    return d


def set_status_class(widget, status, base):
    for s in (UP, BUSY, WARN, DOWN, UNKNOWN):
        widget.remove_css_class(s)
    widget.add_css_class(status if status in (UP, BUSY, WARN, DOWN) else UNKNOWN)


def hover_toggle(widget, on_change, close_delay: int = 140):
    """Open as soon as the pointer arrives, close a beat after it leaves.

    Without the delay, the boundary between two panels flickers: opening a
    drawer moves the edge the pointer is sitting on, the pointer is briefly
    over neither panel, and the drawer slams shut and reopens. The delay
    swallows that -- coming back within it is not a state change at all.
    """
    state = {"id": 0}

    def cancel():
        if state["id"]:
            GLib.source_remove(state["id"])
            state["id"] = 0

    def changed(inside):
        cancel()
        if inside:
            on_change(True)
            return

        def close():
            state["id"] = 0
            on_change(False)
            return GLib.SOURCE_REMOVE

        state["id"] = GLib.timeout_add(close_delay, close)

    on_pointer(widget, changed)


def on_pointer(widget, callback):
    """Run `callback(inside)` whenever the pointer enters or leaves `widget`.

    Watches the controller's contains-pointer property rather than connecting
    to enter/leave, because a drawer that opens shifts everything below it:
    the widget now under the pointer changed without the pointer moving, and
    only the property is re-evaluated in that case. With enter/leave, moving
    off one panel and stopping dead on another lit the second one's hover
    background but never opened it.
    """
    ctrl = Gtk.EventControllerMotion()
    ctrl.connect("notify::contains-pointer",
                 lambda c, _p: callback(c.contains_pointer()))
    widget.add_controller(ctrl)
    return ctrl


class ServiceIcon(Gtk.Overlay):
    """The logo, with the service's status as a badge over its bottom corner.

    Replaces the bare coloured dot: on the infra strip especially, ten green
    dots told you that ten things were fine but not which ten.
    """

    def __init__(self, svc: dict, icons, size: int = 20, big_badge=False):
        super().__init__()
        self.slug = svc.get("icon") or svc["id"]
        self.icons = icons
        self.size = size
        self.role = ICON_ROLES[0]
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)

        self.holder = Gtk.Box()
        self.holder.set_size_request(size, size)
        self.set_child(self.holder)

        # Gtk.Image, not Gtk.Picture: a Picture's natural size is the
        # texture's own, and set_size_request only sets a floor -- which is
        # how a 96px render ended up as a 64px icon in the infra strip.
        # set_pixel_size is a hard box, and the aspect ratio is kept inside it.
        self.pic = Gtk.Image()
        self.pic.set_pixel_size(size)

        self.mono = Gtk.Label(label=(svc.get("label") or svc.get("id") or "?")[:1].upper())
        self.mono.add_css_class("icon-mono")
        self.mono.set_size_request(size, size)

        self.badge = Gtk.Box()
        self.badge.add_css_class("badge")
        self.badge.add_css_class(UNKNOWN)
        if big_badge:
            self.badge.add_css_class("big")
        self.badge.set_halign(Gtk.Align.END)
        self.badge.set_valign(Gtk.Align.END)
        self.add_overlay(self.badge)

        self._showing = None
        self._role_shown = None
        self.refresh()

    def set_role(self, role: str):
        if role != self.role:
            self.role = role
            self.refresh()

    def refresh(self):
        tex = self.icons.get(self.slug, self.role)
        want = "pic" if tex is not None else "mono"
        if want != self._showing:
            child = self.holder.get_first_child()
            if child is not None:
                self.holder.remove(child)
            self.holder.append(self.pic if tex is not None else self.mono)
            self._showing = want
        if tex is not None and (tex, self.role) != self._role_shown:
            self.pic.set_from_paintable(tex)
            self._role_shown = (tex, self.role)

    def update(self, status):
        set_status_class(self.badge, status, "badge")


class Spark(Gtk.DrawingArea):
    """Recent history of one number, as an area chart.

    Only shown inside a drawer: a chart on the resting panel would make one
    column look unlike its neighbours, which is the thing this design is
    trying to get rid of.
    """

    def __init__(self, height: int = 26):
        super().__init__()
        self.add_css_class("spark")
        self.set_content_height(height)
        self.set_hexpand(True)
        self._vals: list[float] = []
        self.set_draw_func(self._draw)

    def set_values(self, vals):
        vals = list(vals)
        if vals != self._vals:
            self._vals = vals
            self.queue_draw()

    def _draw(self, _area, cr, w, h, *_):
        vals = self._vals
        if len(vals) < 2 or w <= 1:
            return
        # Headroom, so a series pinned at its own maximum draws as a line
        # near the top rather than a solid block filling the whole box.
        peak = max(vals) * 1.2
        if peak <= 0:
            return
        c = self.get_color()
        step = w / (len(vals) - 1)
        pts = [(i * step, (h - 1) - (v / peak) * (h - 3)) for i, v in enumerate(vals)]
        cr.move_to(0, h)
        for x, y in pts:
            cr.line_to(x, y)
        cr.line_to(w, h)
        cr.close_path()
        cr.set_source_rgba(c.red, c.green, c.blue, 0.16)
        cr.fill()
        cr.set_line_width(1.4)
        cr.move_to(*pts[0])
        for p in pts[1:]:
            cr.line_to(*p)
        cr.set_source_rgba(c.red, c.green, c.blue, 0.85)
        cr.stroke()


class KVList(Gtk.Grid):
    """Fixed pool of key/value rows, shown or hidden as the data changes.

    A pool rather than rebuilding: these update on every poll, and churning
    widgets under an open drawer makes it flicker.

    A grid rather than a stack of boxes so the key column sizes itself to the
    widest key it actually holds. With a fixed width, a 200px-wide column in
    the four-tile row rendered Bazarr's keys as "PROVIDE..." if the width was
    small enough for the values to fit, and squeezed the values if it was not.

    Rows past `capacity` are dropped, and they arrive most-useful-first, so a
    list longer than the pool loses the container trivia rather than the queue.
    """

    def __init__(self, rows: int = 8, key_min: int = 0, spacing: int = 1):
        super().__init__(row_spacing=spacing, column_spacing=7)
        self.spacing_px = spacing
        self.capacity = rows
        self._rows = []
        self._data: list = []
        for i in range(rows):
            k = Gtk.Label(label="", xalign=0)
            k.add_css_class("kv-key")
            k.set_valign(Gtk.Align.BASELINE_CENTER)
            if key_min:
                k.set_size_request(key_min, -1)
            v = Gtk.Label(label="", xalign=0)
            v.add_css_class("kv-val")
            v.set_hexpand(True)
            v.set_ellipsize(Pango.EllipsizeMode.END)
            k.set_visible(False)
            v.set_visible(False)
            self.attach(k, 0, i, 1, 1)
            self.attach(v, 1, i, 1, 1)
            self._rows.append((k, v))

    def shown(self) -> int:
        """Rows currently on screen -- what the pool holds, capped."""
        return min(len(self._data), self.capacity)

    def row_height(self) -> int:
        # Measured off a row that is actually on screen: GTK reports 0 for an
        # invisible widget, and every row is hidden before the first update.
        for k, _v in self._rows:
            if k.get_visible():
                _, nat, _, _ = k.measure(Gtk.Orientation.VERTICAL, -1)
                if nat:
                    return nat + self.spacing_px
        return 0

    def update(self, rows):
        self._data = list(rows)
        self._apply()

    def _apply(self):
        rows = self._data[: self.capacity]
        for i, (k, v) in enumerate(self._rows):
            if i < len(rows):
                k.set_text(str(rows[i][0] or ""))
                v.set_text(str(rows[i][1] or ""))
                k.set_visible(True)
                v.set_visible(True)
            else:
                k.set_visible(False)
                v.set_visible(False)


# What Docker reports as a health verdict, as opposed to "Up 3 hours" for a
# container with no healthcheck -- appending the latter to the uptime row gave
# "3 hours - Up 3 hours".
HEALTH_WORDS = ("healthy", "unhealthy", "health: starting", "starting")


def container_rows(st: dict, url: str = "", full: bool = False) -> list:
    """The rows every service shows about its container, in a drawer.

    A column's drawer gets the uptime and the image and stops there. The
    published port and the URL cost two of the handful of rows a 426px-tall
    window has room for, and neither is worth one: the port is in the compose
    file and clicking the column opens the URL. The infra strip's drawer is a
    single wide panel with room to spare, so it asks for `full`.
    """
    rows = []
    health = st.get("docker_detail") or ""
    uptime = st.get("docker_uptime") or ""
    if uptime:
        extra = f" - {health}" if health in HEALTH_WORDS else ""
        rows.append(("uptime", f"{uptime}{extra}"))
    elif health:
        rows.append(("container", health))
    if st.get("docker_image"):
        rows.append(("image", st["docker_image"]))
    if full and st.get("docker_ports"):
        rows.append(("ports", st["docker_ports"]))
    if full and url:
        rows.append(("open", url.split("://")[-1].rstrip("/")))
    return rows


class Clickable:
    """Whole-surface click -> open the URL. No button, by request."""

    def _wire(self, widget, url, opener):
        widget._url = url or ""
        if not url:
            return
        widget.add_css_class("clickable")
        click = Gtk.GestureClick()
        click.connect("released", lambda *_: opener(url))
        widget.add_controller(click)
        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_: widget.set_cursor(Gdk.Cursor.new_from_name("pointer")))
        motion.connect("leave", lambda *_: widget.set_cursor(None))
        widget.add_controller(motion)


class ColumnRules(Gtk.DrawingArea):
    """A group's vertical dividers, drawn over the whole panel.

    One unbroken line per boundary, from the top of the columns to the bottom
    of the open drawer. As CSS borders they could not be: on the columns the
    border stopped short of the drawer's rule and its corner radius curved the
    last few pixels away, and on the drawer's own columns -- inside the
    scroller -- it slid up with the rows, which a table's dividers do not do.

    Both grids are column-homogeneous and the same width, so a line at
    width*i/n is the boundary in both.
    """

    def __init__(self, columns: int):
        super().__init__()
        self.add_css_class("col-rules")
        self.columns = columns
        # Purely decorative: it must not shadow the columns underneath it.
        self.set_can_target(False)
        self.set_draw_func(self._draw)

    def _draw(self, _area, cr, w, h, *_):
        if self.columns < 2 or w <= 0:
            return
        c = self.get_color()
        cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
        cr.set_line_width(1.0)
        for i in range(1, self.columns):
            # +0.5 so a one-pixel line lands on a pixel instead of between two
            x = round(w * i / self.columns) + 0.5
            cr.move_to(x, 0)
            cr.line_to(x, h)
        cr.stroke()


def wheel_scroll(scroller, step: float = 46.0):
    """Wheel scrolling that does not depend on the scrollbar policy.

    These scrollers are set to EXTERNAL, which is what keeps their minimum
    height at zero and stops them resizing the window -- but EXTERNAL means
    "someone else draws the scrollbar", and rather than trust what it does
    with a scroll event, this handles the wheel itself. In the capture phase
    and claiming the event, so it cannot end up scrolling twice.
    """
    ctrl = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
    ctrl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)

    def scrolled(_c, _dx, dy):
        adj = scroller.get_vadjustment()
        room = adj.get_upper() - adj.get_page_size()
        if room <= 0:
            return False        # nothing to scroll; let it through
        adj.set_value(max(0.0, min(room, adj.get_value() + dy * step)))
        return True

    ctrl.connect("scroll", scrolled)
    scroller.add_controller(ctrl)
    return scroller


def drawer_clip(child):
    """Wrap a drawer's content so it can never resize the window.

    GTK asks the compositor to grow a toplevel whose content minimum exceeds
    its current size, and relayout has already decided how big this window is.
    A plain Gtk.Revealer reports its child's full minimum once open, so opening
    the library and infra drawers together took the window's minimum to 439px
    inside a 426px slot and Hyprland duly resized it -- which is what the
    layout jumping around mid-animation was.

    A scroller reports zero minimum instead, so a drawer with nowhere to go is
    squeezed rather than the window stretched. EXTERNAL rather than AUTOMATIC
    because AUTOMATIC keeps a 58px floor of its own whatever
    min-content-height says; it draws no scrollbar and still scrolls.
    """
    clip = Gtk.ScrolledWindow()
    clip.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.EXTERNAL)
    clip.set_min_content_height(0)
    clip.set_propagate_natural_height(True)
    clip.set_child(child)
    return wheel_scroll(clip)


class Column(Gtk.Box, Clickable):
    """One service's slice of a merged row.

    Two shapes, differing only in whether the headline number gets a line of
    its own: `hero` for the three services with a live number worth reading
    from across the room, `tile` for the request pipeline. Seerr used to be a
    full-width bar above three little pills, which made it look more important
    than Sonarr for no reason that survived being asked about.
    """

    def __init__(self, svc, opener, icons, hero: bool):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.svc = svc
        self.hero = hero
        self.add_css_class("col")
        self.add_css_class("hero" if hero else "tile")

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        self.icon = ServiceIcon(svc, icons, size=24 if hero else 20, big_badge=hero)
        label = Gtk.Label(label=svc["label"], xalign=0)
        label.add_css_class("card-label")
        label.set_hexpand(True)
        label.set_valign(Gtk.Align.CENTER)
        if not hero:
            label.set_ellipsize(Pango.EllipsizeMode.END)
        top.append(self.icon)
        top.append(label)

        self.count = None
        if hero:
            self.value = Gtk.Label(label="", xalign=0)
            self.value.add_css_class("card-value")
            self.value.set_ellipsize(Pango.EllipsizeMode.END)
        else:
            self.count = Gtk.Label(label="", xalign=1)
            self.count.add_css_class("tile-count")
            top.append(self.count)
            self.value = None

        self.detail = Gtk.Label(label="", xalign=0)
        self.detail.add_css_class("card-detail")
        self.detail.set_ellipsize(Pango.EllipsizeMode.END)

        self.append(top)
        if self.value is not None:
            self.append(self.value)
        self.append(self.detail)
        self._wire(self, svc.get("url"), opener)

    def update(self, st):
        status = st.get("status", UNKNOWN)
        self.icon.update(status)
        self.icon.refresh()
        if status == DOWN:
            self.add_css_class("down")
        else:
            self.remove_css_class("down")
        val = str(st.get("value") or "")
        if self.value is not None:
            shown = val or ("" if status == UP else status)
            self.value.set_text(str(shown))
            muted = str(shown) in ("idle", "-", "no models", "0") or status in (DOWN, UNKNOWN)
            if muted:
                self.value.add_css_class("muted")
            else:
                self.value.remove_css_class("muted")
        if self.count is not None:
            self.count.set_text(val)
            if val in ("", "0"):
                self.count.add_css_class("zero")
            else:
                self.count.remove_css_class("zero")
        self.detail.set_text(st.get("detail") or st.get("docker_detail") or "")


class Group(Gtk.Box):
    """Several services merged into one panel with one shared drawer.

    Hovering anywhere opens every column's detail at once, aligned under the
    column it belongs to. Per-card drawers meant the four-tile row grew from
    whichever card you happened to be over, shoving the panels below it off
    the bottom of a 426px-tall window; one drawer for the row is both less
    jumpy and less work to read.

    The drawer asks for the height its rows need and is allowed to be given
    less: it sits in a scroller that reports no minimum, so GtkBox tops it up
    towards its natural size out of the room the feed panel gives back, and
    clamps it -- scrolling inside itself -- only if even that is not enough.
    Nothing outside the panel moves either way, which is what the earlier
    version got wrong; it tried to predict the number of rows that would fit
    and, measuring mid-animation, often predicted none.
    """

    def __init__(self, services, opener, icons, hero: bool, max_rows: int = 12):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add_css_class("group")
        self.icons = icons
        self.hero = hero
        self.columns: list = []
        self.details: list = []

        self.top = Gtk.Grid(column_homogeneous=True)
        for i, svc in enumerate(services):
            col = Column(svc, opener, icons, hero)
            self.top.attach(col, i, 0, 1, 1)
            self.columns.append(col)

        self.drawer_grid = Gtk.Grid(column_homogeneous=True)
        for i, svc in enumerate(services):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            box.add_css_class("drawer-col")
            kv = KVList(max_rows)
            box.append(kv)
            spark = None
            cap = None
            if svc.get("spark"):
                spark = Spark()
                cap = Gtk.Label(label="", xalign=0)
                cap.add_css_class("spark-cap")
                holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                holder.append(spark)
                holder.append(cap)
                holder.set_visible(False)
                box.append(holder)
                spark = (holder, spark, cap)
            self.drawer_grid.attach(box, i, 0, 1, 1)
            self.details.append({"svc": svc, "kv": kv, "spark": spark})

        self.clip = drawer_clip(self.drawer_grid)
        # The rule belongs to the scroller, not to the grid inside it, so it
        # stays put when the rows scroll under it.
        self.clip.add_css_class("drawer-top")
        self._cap = -2

        self.revealer = Gtk.Revealer()
        self.revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.revealer.set_transition_duration(180)
        self.revealer.set_child(self.clip)

        # Columns and drawer stacked, with the dividers drawn over both so
        # each one is a single line down the whole panel.
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.append(self.top)
        body.append(self.revealer)
        deck = Gtk.Overlay()
        deck.set_child(body)
        deck.add_overlay(ColumnRules(len(services)))
        self.append(deck)

        self.on_open = None
        hover_toggle(self, self._hover)

    # -- state -------------------------------------------------------------
    def _hover(self, inside: bool):
        self.revealer.set_reveal_child(inside)
        # The whole group lights up, not just the column under the pointer:
        # the drawer belongs to the row, so the row is what acknowledges it.
        role = ICON_ROLES[1] if inside else ICON_ROLES[0]
        for col in self.columns:
            col.icon.set_role(role)
        if inside and self.on_open is not None:
            self.on_open(self)

    def force_close(self):
        """Shut immediately, without waiting out the close delay."""
        self._hover(False)

    def animating(self) -> bool:
        return self.revealer.get_child_revealed() != self.revealer.get_reveal_child()

    def is_open(self) -> bool:
        return self.revealer.get_reveal_child()

    def set_drawer_cap(self, px: int):
        """Tallest the drawer may grow, rounded down to a whole row.

        Without the rounding the drawer stops wherever the pixels ran out and
        slices its last row through the middle of the glyphs; without the cap
        it takes every pixel the feed panel had and leaves it a sliver.

        Set while the drawer is shut, from a budget measured at rest, so the
        answer never depends on a height read mid-animation -- which is what
        made the old version show anything between no rows and three.
        """
        row_h = self.details[0]["kv"].row_height() if self.details else 0
        _, want, _, _ = self.drawer_grid.measure(Gtk.Orientation.VERTICAL, -1)
        rows = max((d["kv"].shown() for d in self.details), default=0)
        if row_h <= 0 or rows <= 0 or px >= want:
            cap = -1          # it all fits; let it size itself
        else:
            chrome = max(0, want - rows * row_h)
            cap = max(1, (px - chrome) // row_h) * row_h + chrome
        if cap != self._cap:
            self._cap = cap
            self.clip.set_max_content_height(cap)

    # -- data --------------------------------------------------------------
    def update(self, state, history):
        busy = False
        for col in self.columns:
            st = state.get(col.svc["id"], {})
            col.update(st)
            if st.get("status") == BUSY:
                busy = True
        if busy:
            self.add_css_class("busy")
        else:
            self.remove_css_class("busy")

        for d in self.details:
            svc = d["svc"]
            st = state.get(svc["id"], {})
            d["kv"].update(list(st.get("rows") or [])
                           + container_rows(st, svc.get("url") or ""))
            if d["spark"] is None:
                continue
            holder, spark, cap = d["spark"]
            vals = list(history.get(svc["id"]) or [])
            peak = max(vals) if vals else 0
            # Nothing to plot while the number has been zero all along; an
            # empty axis is just a box taking up room in the drawer.
            holder.set_visible(bool(peak))
            if peak:
                spark.set_values(vals)
                unit = svc.get("spark_unit") or ""
                shown = human_bytes(peak, unit) if unit else f"{peak:g}"
                window = float(svc.get("interval") or 10.0) * len(vals)
                cap.set_text(f"peak {shown} over the last "
                             f"{rel_time(window).replace('in ', '')}")


class InfraIcon(Gtk.Box, Clickable):
    """A logo with a status badge in the bottom strip.

    Detail goes to the panel above the strip rather than into the icon: there
    is no room to expand a 26px square, and one shared panel means moving
    along the row swaps text instead of opening and closing nine of them.
    """

    def __init__(self, svc, icons, opener, on_hover):
        super().__init__()
        self.svc = svc
        self.add_css_class("infra-icon")
        self.icon = ServiceIcon(svc, icons, size=24, big_badge=True)
        self.append(self.icon)
        self._wire(self, svc.get("url"), opener)
        on_pointer(self, lambda inside: on_hover(self.svc["id"], inside))

    def set_role(self, role):
        self.icon.set_role(role)

    def update(self, st, history=None):
        status = st.get("status", UNKNOWN)
        self.icon.update(status)
        self.icon.refresh()
        if status == DOWN:
            self.add_css_class("down")
        else:
            self.remove_css_class("down")


class ActivityRow(Gtk.Box):
    """One thing currently happening: a download, or a stream."""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        left.set_hexpand(True)
        self.name = Gtk.Label(label="", xalign=0)
        self.name.add_css_class("act-name")
        self.name.set_ellipsize(Pango.EllipsizeMode.END)
        self.bar = Gtk.ProgressBar()
        self.bar.add_css_class("act-bar")
        self.bar.set_valign(Gtk.Align.CENTER)
        self.bar.set_hexpand(True)
        # A 4px bar centred in a slot the height of the line of text opposite
        # it, rather than sitting at the top of its own 4px allocation: this
        # is the second line of the left column, and the second line of the
        # right column is the percentage, so the two should share a centre.
        slot = Gtk.Box()
        slot.set_size_request(-1, 13)
        slot.append(self.bar)
        left.append(self.name)
        left.append(slot)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        right.set_valign(Gtk.Align.CENTER)
        self.right = Gtk.Label(label="", xalign=1)
        self.right.add_css_class("act-right")
        self.sub = Gtk.Label(label="", xalign=1)
        self.sub.add_css_class("act-sub")
        right.append(self.right)
        right.append(self.sub)

        self.append(left)
        self.append(right)

    def update(self, item):
        self.name.set_text(item.get("name", "")[:70])
        frac = max(0.0, min(1.0, float(item.get("fraction") or 0.0)))
        self.bar.set_fraction(frac)
        if item.get("kind") == "play":
            self.bar.add_css_class("play")
        else:
            self.bar.remove_css_class("play")
        self.right.set_text(str(item.get("right") or ""))
        pct = f"{frac * 100:.0f}%"
        sub = item.get("sub") or ""
        self.sub.set_text(f"{pct} - {sub}" if sub else pct)


class Feed(Gtk.Box):
    """What is happening, and what turned up recently, in one scrolling list.

    Always on the panel, and the only thing on it with no height of its own,
    so this is what pays for an open drawer: the drawer takes the room it
    needs and the list scrolls instead of the window doing it.

    That is the whole trick. The scroller keeps propagate-natural-height off,
    so it asks GtkBox for nothing and expands into whatever is left after
    every other panel has reached its natural size. It replaced two panels
    that appeared and vanished on their own, plus the arithmetic that tried to
    work out in advance how many rows would fit -- which, measuring while a
    drawer was still animating, quite often decided the answer was none.

    Streams and downloads come first because they are happening now; the
    library additions underneath are only ever a nice-to-know.
    """

    def __init__(self, activity_rows: int = 6, recent_rows: int = 24):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add_css_class("group")
        self.add_css_class("pad")

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        self.act_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        head = Gtk.Label(label="activity", xalign=0)
        head.add_css_class("section-label")
        self.act_box.append(head)
        self.act_rows = []
        for _ in range(activity_rows):
            r = ActivityRow()
            r.set_visible(False)
            self.act_rows.append(r)
            self.act_box.append(r)
        self.act_more = Gtk.Label(label="", xalign=0)
        self.act_more.add_css_class("act-sub")
        self.act_more.set_visible(False)
        self.act_box.append(self.act_more)
        inner.append(self.act_box)

        self.rec_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        head2 = Gtk.Label(label="recently added", xalign=0)
        head2.add_css_class("section-label")
        self.rec_box.append(head2)
        self.rec_rows = []
        for _ in range(recent_rows):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            name = Gtk.Label(label="", xalign=0)
            name.add_css_class("act-name")
            name.set_ellipsize(Pango.EllipsizeMode.END)
            sub = Gtk.Label(label="", xalign=0)
            sub.add_css_class("act-sub")
            sub.set_hexpand(True)
            sub.set_ellipsize(Pango.EllipsizeMode.END)
            when = Gtk.Label(label="", xalign=1)
            when.add_css_class("recent-when")
            row.append(name)
            row.append(sub)
            row.append(when)
            row.set_visible(False)
            self.rec_box.append(row)
            self.rec_rows.append((row, name, sub, when))
        inner.append(self.rec_box)

        # See Group for why this is EXTERNAL. propagate-natural-height stays
        # off so the panel asks GtkBox for nothing and simply expands into
        # whatever the rows above did not want.
        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.EXTERNAL)
        self.scroller.set_min_content_height(0)
        self.scroller.set_propagate_natural_height(False)
        self.scroller.set_vexpand(True)
        self.scroller.set_child(inner)
        wheel_scroll(self.scroller)
        self.append(self.scroller)

    def slack(self) -> int:
        """Height this panel is currently absorbing -- the spare space."""
        return self.scroller.get_height()

    def update(self, items, recent):
        # Streams before downloads: someone watching matters more than a
        # background grab.
        items = sorted(items or [], key=lambda i: 0 if i.get("kind") == "play" else 1)
        self.act_box.set_visible(bool(items))
        for i, row in enumerate(self.act_rows):
            if i < len(items):
                row.update(items[i])
                row.set_visible(True)
            else:
                row.set_visible(False)
        hidden = len(items) - len(self.act_rows)
        self.act_more.set_visible(hidden > 0)
        if hidden > 0:
            self.act_more.set_text(f"+{hidden} more")

        recent = list(recent or [])
        self.rec_box.set_visible(bool(recent))
        for i, (row, name, sub, when) in enumerate(self.rec_rows):
            if i < len(recent):
                name.set_text(str(recent[i].get("name") or ""))
                sub.set_text(str(recent[i].get("sub") or ""))
                when.set_text(str(recent[i].get("right") or ""))
                row.set_visible(True)
            else:
                row.set_visible(False)


class LibraryPanel(Gtk.Box):
    """The media mount: one bar at rest, a breakdown by library on hover.

    The per-library figures are Sonarr's and Radarr's own totals rather than a
    walk of the mount -- they are already computed, exact about what counts as
    a show and what counts as a film, and cost one request every five minutes.
    """

    SHADES = ("a", "b", "c")

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.add_css_class("pad")

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl = Gtk.Label(label="library", xalign=0)
        lbl.add_css_class("disk-label")
        self.value = Gtk.Label(label="", xalign=1)
        self.value.add_css_class("disk-value")
        sp = Gtk.Box()
        sp.set_hexpand(True)
        head.append(lbl)
        head.append(sp)
        head.append(self.value)
        self.append(head)

        self.bar = Gtk.ProgressBar()
        self.bar.add_css_class("disk-bar")
        self.bar.set_valign(Gtk.Align.CENTER)
        self.append(self.bar)

        detail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        detail.add_css_class("drawer")
        self.lib_rows = []
        for shade in self.SHADES:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            k = Gtk.Label(label="", xalign=0)
            k.add_css_class("kv-key")
            k.set_size_request(52, -1)
            bar = Gtk.ProgressBar()
            bar.add_css_class("lib-bar")
            bar.add_css_class(shade)
            bar.set_hexpand(True)
            bar.set_valign(Gtk.Align.CENTER)
            v = Gtk.Label(label="", xalign=1)
            v.add_css_class("kv-val")
            v.set_size_request(190, -1)
            v.set_ellipsize(Pango.EllipsizeMode.END)
            row.append(k)
            row.append(bar)
            row.append(v)
            row.set_visible(False)
            detail.append(row)
            self.lib_rows.append((row, k, bar, v))
        self.kv = KVList(3, key_min=52)
        detail.append(self.kv)

        self.revealer = Gtk.Revealer()
        self.revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.revealer.set_transition_duration(180)
        self.revealer.set_child(drawer_clip(detail))
        self.append(self.revealer)

        self.on_open = None
        hover_toggle(self, self._hover)

    def _hover(self, inside: bool):
        self.revealer.set_reveal_child(inside)
        if inside and self.on_open is not None:
            self.on_open(self)

    def force_close(self):
        self.revealer.set_reveal_child(False)

    def animating(self) -> bool:
        return self.revealer.get_child_revealed() != self.revealer.get_reveal_child()

    def is_open(self) -> bool:
        return self.revealer.get_reveal_child()

    def update(self, extra):
        free, total = extra.get("free"), extra.get("total")
        if not (free and total):
            self.value.set_text("mount unavailable")
            return
        used = total - free
        self.bar.set_fraction(1.0 - free / total)
        for c in ("tight", "full"):
            self.bar.remove_css_class(c)
        if free / total <= 0.08:
            self.bar.add_css_class("full")
        elif free / total <= 0.2:
            self.bar.add_css_class("tight")
        self.value.set_text(
            f"{human_bytes(used)} used of {human_bytes(total)}  -  {human_bytes(free)} free"
        )

        libs = list((extra.get("library") or {}).values())
        libs.sort(key=lambda x: -(x.get("size") or 0))
        accounted = 0.0
        for i, (row, k, bar, v) in enumerate(self.lib_rows):
            if i < len(libs):
                lib = libs[i]
                size = float(lib.get("size") or 0)
                accounted += size
                k.set_text(str(lib.get("label") or "")[:10].lower())
                bar.set_fraction(min(1.0, size / total))
                bits = [human_bytes(size)]
                if lib.get("count") is not None:
                    bits.append(f"{lib['count']} {lib.get('noun', '')}".strip())
                if lib.get("files"):
                    bits.append(f"{lib['files']} {lib.get('file_noun', '')}".strip())
                v.set_text(" - ".join(bits))
                row.set_visible(True)
            else:
                row.set_visible(False)

        rows = []
        if accounted:
            other = max(0.0, used - accounted)
            rows.append(("other", f"{human_bytes(other)} outside the media libraries"))
        rows.append(("free", f"{human_bytes(free)} - {free / total * 100:.0f}% of the mount"))
        if extra.get("fill_in"):
            rows.append(("full in", str(extra["fill_in"])))
        self.kv.update(rows)


# --------------------------------------------------------------------------
# window
# --------------------------------------------------------------------------

# Old tier names, kept so an existing config keeps working. "wide" and "chip"
# were the full-width Seerr bar and the little *arr pills; both are now the
# same second-tier column, which is the whole point.
TIER_ALIAS = {"wide": "tile", "chip": "tile"}


class Window(Gtk.ApplicationWindow):
    def __init__(self, app, cfg, services, theme):
        super().__init__(application=app)
        self.cfg = cfg
        self.services = services
        self.set_title(cfg["general"].get("title", "homelab"))
        self.set_default_size(720, 700)
        # relayout floats and positions this window; a titlebar would just eat
        # a row of pixels for nothing.
        self.set_decorated(False)

        self.icons = Icons(theme, self.on_icons_ready)
        theme.listeners.append(self.icons.retint)
        self.tiles: dict[str, object] = {}
        self.groups: list = []
        self._infra_hover: str | None = None
        self._infra_close_id = 0

        # One plain box, no scroller around the middle. A ScrolledWindow
        # allocates its child the child's own natural height, so anything
        # inside one can never be asked to give height back -- which is what
        # a drawer needs. The Feed panel is the flexible element instead.
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        outer.add_css_class("root")
        self.set_child(outer)

        # header ----------------------------------------------------------
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        t = Gtk.Label(label=cfg["general"].get("title", "homelab"), xalign=0)
        t.add_css_class("title")
        self.head_dot = dot()
        self.headline = Gtk.Label(label="starting...", xalign=1)
        self.headline.add_css_class("headline")
        head.append(self.head_dot)
        head.append(t)
        sp = Gtk.Box()
        sp.set_hexpand(True)
        head.append(sp)
        head.append(self.headline)
        outer.append(head)

        def tier_of(svc):
            tier = svc.get("tier", "dot")
            return TIER_ALIAS.get(tier, tier)

        by_tier = lambda tier: [s for s in services if tier_of(s) == tier]  # noqa: E731

        # One panel per tier rather than one per service: the columns are
        # divided by a hairline, and share a drawer.
        for tier, hero in (("hero", True), ("tile", False)):
            members = by_tier(tier)
            if not members:
                continue
            group = Group(members, self.open_url, self.icons, hero)
            group.on_open = self._claim
            for col in group.columns:
                self.tiles[col.svc["id"]] = col
            self.groups.append(group)
            outer.append(group)

        # The one panel with no height of its own: it takes what is left and
        # gives it back when a drawer opens.
        self.feed = Feed(int(cfg["general"].get("activity_rows") or 6),
                         int(cfg["general"].get("recent_rows") or 24))
        outer.append(self.feed)

        # bottom panel: the mount and the infra strip, merged -------------
        bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        bottom.add_css_class("group")
        self.library = LibraryPanel()
        self.library.on_open = self._claim
        bottom.append(self.library)

        dots = by_tier("dot")
        if dots:
            self.infra_name = Gtk.Label(label="", xalign=0)
            self.infra_name.add_css_class("infra-name")
            self.infra_kv = KVList(4)
            panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            panel.add_css_class("drawer")
            panel.append(self.infra_name)
            panel.append(self.infra_kv)
            holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            holder.add_css_class("pad-x")
            holder.append(panel)
            self.infra_reveal = Gtk.Revealer()
            self.infra_reveal.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
            self.infra_reveal.set_transition_duration(180)
            self.infra_reveal.set_child(drawer_clip(holder))

            strip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
            strip.add_css_class("pad")
            strip.add_css_class("hrule")
            lbl = Gtk.Label(label="infra", xalign=0)
            lbl.add_css_class("infra-label")
            lbl.set_valign(Gtk.Align.CENTER)
            strip.append(lbl)
            pad = Gtk.Box()
            pad.set_size_request(4, -1)
            strip.append(pad)
            for svc in dots:
                d = InfraIcon(svc, self.icons, self.open_url, self.on_infra_hover)
                self.tiles[svc["id"]] = d
                strip.append(d)
            sp2 = Gtk.Box()
            sp2.set_hexpand(True)
            strip.append(sp2)
            self.footer = Gtk.Label(label="", xalign=1)
            self.footer.add_css_class("footer-note")
            self.footer.set_valign(Gtk.Align.CENTER)
            strip.append(self.footer)

            # Above the icons, not below them: the strip is the last thing in
            # the window, so a drawer under it has nothing to expand into and
            # was allocated no height at all.
            bottom.append(self.infra_reveal)
            bottom.append(strip)
        else:
            self.footer = Gtk.Label(label="")
            self.infra_reveal = None

        outer.append(bottom)
        self._state: dict = {}

    # -- icons -------------------------------------------------------------
    def on_icons_ready(self):
        """A download finished, or the scheme changed; re-read every icon."""
        for tile in self.tiles.values():
            icon = getattr(tile, "icon", None)
            if icon is not None:
                icon.refresh()
        return GLib.SOURCE_REMOVE

    def _claim(self, owner):
        """One drawer at a time.

        The close delay that stops a boundary flickering also means a drawer
        the pointer has just left is still open for a moment, so crossing two
        of them quickly used to leave both open at once -- and two open
        drawers is the state whose combined minimum height made GTK resize the
        window. Whoever opens shuts the others on the spot.
        """
        for group in self.groups:
            if group is not owner:
                group.force_close()
        if self.library is not owner:
            self.library.force_close()
        if owner != "infra":
            self._close_infra()

    # -- how much height a drawer may borrow -------------------------------
    # What the feed panel keeps for itself while a drawer is open: its header
    # and one whole row, so it stays a panel rather than becoming a sliver.
    # Sized to end just after that row -- it is a scrolling viewport, so
    # whatever comes next is cut wherever the pixels run out, and a section
    # heading sliced in half looks like a fault rather than like more content.
    FEED_KEEP = 46

    def _settled(self) -> bool:
        """True when nothing is open and nothing is still sliding."""
        parts = [*self.groups, self.library]
        for part in parts:
            if part.is_open() or part.animating():
                return False
        if self.infra_reveal is not None and (
                self.infra_reveal.get_reveal_child()
                or self.infra_reveal.get_child_revealed()):
            return False
        return True

    def _budget(self):
        """Tell the drawers how much room there is, measured while at rest.

        The feed panel's own height is the answer: at rest it is absorbing
        exactly the space nothing else wanted, which is the space a drawer has
        to borrow. Sampling it only when everything is shut and still means
        the figure never comes from a half-open drawer.
        """
        if not self._settled():
            return
        slack = self.feed.slack()
        if slack <= 0:
            return
        cap = max(0, slack - self.FEED_KEEP)
        for group in self.groups:
            group.set_drawer_cap(cap)

    # -- infra strip hover -------------------------------------------------
    def on_infra_hover(self, svc_id, entered):
        """One shared panel for the whole strip.

        Closing is deferred by a beat so that sliding along the row swaps the
        text instead of slamming the panel shut between every two icons.
        """
        if self.infra_reveal is None:
            return
        if entered:
            if self._infra_close_id:
                GLib.source_remove(self._infra_close_id)
                self._infra_close_id = 0
            self._infra_hover = svc_id
            self._render_infra()
            self._claim("infra")
            self.infra_reveal.set_reveal_child(True)
            self._set_infra_role(svc_id)
            return
        if self._infra_hover != svc_id:
            return

        if self._infra_close_id:
            GLib.source_remove(self._infra_close_id)
        self._infra_close_id = GLib.timeout_add(140, self._close_infra)

    def _close_infra(self):
        if self._infra_close_id:
            GLib.source_remove(self._infra_close_id)
            self._infra_close_id = 0
        self._infra_hover = None
        if self.infra_reveal is not None:
            self.infra_reveal.set_reveal_child(False)
        self._set_infra_role(None)
        return GLib.SOURCE_REMOVE

    def _set_infra_role(self, svc_id):
        for tile in self.tiles.values():
            if isinstance(tile, InfraIcon):
                tile.set_role(ICON_ROLES[1] if tile.svc["id"] == svc_id
                              else ICON_ROLES[0])

    def _render_infra(self):
        sid = self._infra_hover
        if not sid or self.infra_reveal is None:
            return
        svc = next((s for s in self.services if s["id"] == sid), None)
        st = self._state.get(sid, {})
        if svc is None:
            return
        self.infra_name.set_text(f"{svc['label']}  -  {st.get('status', UNKNOWN)}")
        self.infra_kv.update(list(st.get("rows") or [])
                             + container_rows(st, svc.get("url") or "", full=True))

    def open_url(self, url):
        browser = (self.cfg["general"].get("browser") or "").strip()
        try:
            if browser:
                subprocess.Popen(
                    [*browser.split(), url],
                    start_new_session=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            else:
                Gio.AppInfo.launch_default_for_uri(url, None)
        except (GLib.Error, OSError):
            subprocess.Popen(
                ["xdg-open", url],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

    def render(self, state, extra, history=None):
        history = history or {}
        self._state = state
        if os.environ.get("HOMELAB_DASH_DEMO"):
            # Has to happen before the columns are updated, below.
            for svc in self.services:
                # `not any(...)`: an idle qBittorrent has a full history of
                # zeros, which is a non-empty list and would suppress this.
                if svc.get("spark") and not any(history.get(svc["id"]) or []):
                    history[svc["id"]] = [
                        max(0.0, 9e6 + 7e6 * math.sin(i / 7.0) + 3e6 * math.sin(i / 2.3))
                        for i in range(SPARK_SAMPLES)
                    ]

        worst = UP
        rank = {UP: 0, BUSY: 0, WARN: 1, UNKNOWN: 2, DOWN: 3}
        up = total = 0
        broken = []
        for group in self.groups:
            group.update(state, history)
        for svc in self.services:
            st = state.get(svc["id"], {})
            tile = self.tiles.get(svc["id"])
            if isinstance(tile, InfraIcon):
                tile.update(st)
            s = st.get("status", UNKNOWN)
            if svc.get("container"):
                total += 1
                if s in (UP, BUSY):
                    up += 1
                elif s == DOWN:
                    broken.append(svc["label"])
            if rank.get(s, 2) > rank.get(worst, 0):
                worst = s
        set_status_class(self.head_dot, worst, "dot")

        items = []
        for svc in self.services:
            items.extend(state.get(svc["id"], {}).get("items") or [])
        if os.environ.get("HOMELAB_DASH_DEMO"):
            # Dev aid: HOMELAB_DASH_DEMO=1 fakes activity and a transfer-rate
            # history, so the panel -- including the sparkline in qBittorrent's
            # drawer -- can be designed without waiting for a real download.
            items = items + [
                {"kind": "play", "name": "Arcane - S01E03 - The Base Violence",
                 "fraction": 0.37, "right": "transcode", "sub": "nedas"},
                {"kind": "dl", "name": "[MiniMTBB] Steins;Gate S1 (BD 1080p)",
                 "fraction": 0.62, "right": "18.0 MB/s", "sub": "downloading"},
            ]
        self.feed.update(items, extra.get("recent"))
        self.library.update(extra)
        self._budget()
        self._render_infra()

        # Header: the count when everything is fine, the names when it is not.
        # "15/16 up" leaves you hunting the strip for the one red badge.
        streams = sum(1 for i in items if i.get("kind") == "play")
        rate = sum(1 for i in items if i.get("kind") == "dl")
        bits = [f"{up}/{total} up"]
        if streams:
            bits.append(f"{streams} stream{'s' if streams > 1 else ''}")
        if rate:
            bits.append(f"{rate} downloading")
        err = extra.get("docker_error")
        if err:
            bits = [err]
        elif broken:
            bits = [f"{len(broken)} down: " + ", ".join(broken[:3])]
        if err or broken:
            self.headline.add_css_class("alert")
        else:
            self.headline.remove_css_class("alert")
        self.headline.set_text("  -  ".join(bits))
        return False


# --------------------------------------------------------------------------
# application
# --------------------------------------------------------------------------

def load_config():
    path = expand(str(CONFIG))
    if not path.exists():
        sys.exit(f"homelab-dash: no config at {path}")
    with path.open("rb") as f:
        cfg = tomllib.load(f)

    # Optional untracked override, merged over [credentials]. config.toml is a
    # symlink into ~/dotfiles and therefore git-tracked, so tokens belong here
    # instead -- this file is a real local file and never leaves the machine.
    secrets = path.parent / "secrets.toml"
    if secrets.exists():
        try:
            with secrets.open("rb") as f:
                extra = tomllib.load(f)
            creds = dict(cfg.get("credentials") or {})
            creds.update(extra.get("credentials") or {})
            cfg["credentials"] = creds
        except (OSError, tomllib.TOMLDecodeError) as e:
            print(f"homelab-dash: ignoring {secrets}: {e}", file=sys.stderr)
    cfg.setdefault("general", {})
    cfg.setdefault("paths", {"stack": "/mnt/media/Docker/MediaServer", "media_mount": "/mnt/media"})
    services = cfg.get("service") or []
    for s in services:
        s.setdefault("tier", "dot")
        s.setdefault("label", s.get("id", "?"))
    return cfg, services


class App(Gtk.Application):
    def __init__(self):
        # No application_id on purpose: a valid GApplication id must contain a
        # period, which would make the Wayland app_id -- and therefore
        # Hyprland's window class -- "dev.hollafoil.homelab-dash". With None,
        # GTK uses g_get_prgname(), so the class is plainly "homelab-dash",
        # which is what relayout matches on.
        super().__init__(flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.cfg, self.services = load_config()
        self.win = None
        self.collector = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        colors = expand((self.cfg.get("theme") or {}).get(
            "colors", "~/.config/homelab-dash/colors.css"))
        self.theme = Theme(colors)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            self.theme.provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def do_activate(self):
        if self.win is None:
            self.win = Window(self, self.cfg, self.services, self.theme)
            self.collector = Collector(self.cfg, self.services, self.on_update)
            self.collector.start()
            self.win.connect("close-request", self.on_close)
        self.win.present()

    def on_update(self):
        if self.win is not None:
            state, extra, history = self.collector.snapshot()
            self.win.render(state, extra, history)
        return GLib.SOURCE_REMOVE

    def on_close(self, *_):
        if self.collector:
            self.collector.stop()
        return False


def main():
    # GDK_BACKEND is left alone; under Hyprland this is Wayland and the
    # application_id becomes the window class relayout matches on.
    GLib.set_prgname(APP_ID)
    GLib.set_application_name("homelab-dash")
    return App().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
