#!/usr/bin/env python
"""homelab-dash - status and launcher panel for the MediaServer homelab.

Lives in the SUPER+SHIFT+R dashboard layout (see ~/.local/bin/relayout), in the
slot the terminal used to hold. Every tile is clickable and opens the service;
there are no launch buttons.

Services that belong together share one translucent panel, divided by
hairlines rather than each sitting in its own bordered card, and the wallpaper
behind the window is meant to read through the gaps. Hovering a panel opens a
drawer under the whole row at once -- container uptime, image, queue contents,
who is watching what -- sized to the height that is actually free, so it never
makes the panel scroll.

Service logos come from selfhst/icons, fetched once into
~/.cache/homelab-dash/icons, flattened to a silhouette and tinted from the
current colour scheme. A missing logo draws a monogram instead, so the panel is
fine offline and on its first run; drop your own <slug>.svg into that directory
to override one.

Theming comes from matugen: ~/.config/homelab-dash/colors.css is regenerated on
every `setwall` and is watched here, so the panel restyles itself live without a
restart. That file is 86 `@define-color` rules, which is already valid GTK CSS,
so it is concatenated with STYLE below into a single provider (colour
definitions do not reliably cross provider boundaries in GTK4).

Stdlib + PyGObject only, deliberately: no pip, no venv, nothing to keep in sync.
"""

from __future__ import annotations

import calendar
import http.client
import math
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from collections import deque
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango  # noqa: E402

APP_ID = "homelab-dash"
CONFIG = Path(os.environ.get("HOMELAB_DASH_CONFIG", "~/.config/homelab-dash/config.toml"))

# Status vocabulary. Kept tiny on purpose - anything richer belongs in the
# detail line, not in a colour the user has to decode.
UP, BUSY, WARN, DOWN, UNKNOWN = "up", "busy", "warn", "down", "unknown"


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------

def expand(p: str) -> Path:
    return Path(os.path.expanduser(os.path.expandvars(p)))


def human_bytes(n: float, unit: str = "B") -> str:
    for suffix in ("", "K", "M", "G", "T"):
        if abs(n) < 1024 or suffix == "T":
            if suffix == "":
                return f"{n:.0f} {unit}"
            return f"{n:.1f} {suffix}{unit}" if n < 100 else f"{n:.0f} {suffix}{unit}"
        n /= 1024.0
    return f"{n:.0f} T{unit}"


def http_json(url: str, headers: dict | None = None, timeout: float = 6.0):
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read()
    return json.loads(body) if body else None


def http_code(url: str, headers: dict | None = None, timeout: float = 6.0) -> int:
    req = urllib.request.Request(url, headers=headers or {}, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code


class UnixHTTPConnection(http.client.HTTPConnection):
    """Minimal unix-socket HTTP, so talking to Docker needs no docker SDK."""

    def __init__(self, path: str, timeout: float = 5.0):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self.unix_path)
        self.sock = s


# --------------------------------------------------------------------------
# credential discovery
# --------------------------------------------------------------------------

class Secrets:
    """Reads API keys out of the services' own config files.

    Deliberate: keys copied into our config.toml would silently rot the moment
    an app regenerated one, and would duplicate secrets onto disk for no gain.
    """

    def __init__(self, stack: Path, cfg_creds: dict):
        self.stack = stack
        self._cache: dict[str, str] = {}
        self._explicit = dict(cfg_creds or {})

    def _xml_apikey(self, rel: str) -> str:
        try:
            text = (self.stack / rel).read_text(errors="ignore")
        except OSError:
            return ""
        m = re.search(r"<ApiKey>([^<]+)</ApiKey>", text)
        return m.group(1).strip() if m else ""

    def arr(self, name: str) -> str:
        if name not in self._cache:
            self._cache[name] = self._xml_apikey(f"{name}/config/config.xml")
        return self._cache[name]

    def bazarr(self) -> str:
        if "bazarr" not in self._cache:
            key = ""
            try:
                text = (self.stack / "bazarr/config/config/config.yaml").read_text(errors="ignore")
                for line in text.splitlines():
                    m = re.match(r"\s*apikey:\s*['\"]?([0-9a-fA-F]{16,})['\"]?\s*$", line)
                    if m:
                        key = m.group(1)
                        break
            except OSError:
                pass
            self._cache["bazarr"] = key
        return self._cache["bazarr"]

    def qbittorrent(self) -> str:
        if "qbit" not in self._cache:
            key = ""
            try:
                text = (self.stack / "qbittorrent/config/qBittorrent/qBittorrent.conf").read_text(
                    errors="ignore"
                )
                m = re.search(r"^WebUI\\APIKey=(\S+)", text, re.M)
                key = m.group(1).strip() if m else ""
            except OSError:
                pass
            self._cache["qbit"] = key
        return self._cache["qbit"]

    def seerr(self) -> str:
        if "seerr" not in self._cache:
            key = ""
            try:
                data = json.loads(
                    (self.stack / "jellyseerr/config/settings.json").read_text(errors="ignore")
                )
                key = (data.get("main") or {}).get("apiKey") or ""
            except (OSError, json.JSONDecodeError):
                pass
            self._cache["seerr"] = key
        return self._cache["seerr"]

    def jellyfin(self) -> str:
        return (self._explicit.get("jellyfin_api_key") or "").strip()


# --------------------------------------------------------------------------
# probes
#
# A probe returns a dict merged into the service's state:
#   status  one of UP/BUSY/WARN/DOWN/UNKNOWN  (omit to keep Docker's verdict)
#   value   the big number on a hero tile, or the tile's count
#   detail  one short line under it
#   rows    [(key, value), ...] revealed when the tile is hovered
#   items   activity rows: what is playing or downloading right now
#   spark   one number appended to the tile's sparkline history
# Raising is fine: the scheduler records it as WARN with the reason.
#
# Anything a probe puts in `rows` is only ever seen on hover, so it can be as
# chatty as it likes -- but it must not cost an HTTP round-trip on every poll.
# Slow-moving facts (versions, item counts, library sizes) go through Cached.
# --------------------------------------------------------------------------

class Cached:
    """A value refreshed at most every `ttl` seconds.

    qBittorrent is polled every two seconds; its free-space figure does not
    need to be. On failure the previous value is kept rather than blanked --
    a hover row that flickers to empty is worse than one that is a minute old.
    """

    def __init__(self, ttl: float, fn):
        self.ttl = ttl
        self.fn = fn
        self._at = 0.0
        self._val = None
        self._lock = threading.Lock()

    def get(self):
        # Held across the call: two collector threads asking at once should
        # both wait for the one answer, not race and hand one of them the
        # not-filled-in-yet value.
        with self._lock:
            now = time.monotonic()
            if now - self._at >= self.ttl:
                try:
                    self._val = self.fn()
                    self._at = now
                except Exception:
                    # Retry sooner than a full ttl, but not on every poll of a
                    # two-second probe.
                    self._at = now - self.ttl + 15.0
            return self._val or {}


def rel_time(secs: float) -> str:
    """Compact "in 4h" / "3d ago" for calendar and uptime rows."""
    past = secs < 0
    secs = abs(secs)
    if secs < 90:
        out = f"{int(secs)}s"
    elif secs < 5400:
        out = f"{int(secs // 60)}m"
    elif secs < 172800:
        out = f"{int(secs // 3600)}h"
    else:
        out = f"{int(secs // 86400)}d"
    return f"{out} ago" if past else f"in {out}"


class Probes:
    def __init__(self, cfg: dict, secrets: Secrets):
        self.cfg = cfg
        self.s = secrets
        self.llm_url = ((cfg.get("llm") or {}).get("url") or "http://127.0.0.1:9292").rstrip("/")
        self._jf_meta = Cached(300.0, self._jf_meta_fetch)
        self._qb_disk = Cached(60.0, self._qb_disk_fetch)
        self._seerr_ver = Cached(600.0, self._seerr_ver_fetch)
        self._arr_slow: dict[str, Cached] = {}

    # -- jellyfin: active streams ------------------------------------------
    def _jf(self, path: str, timeout: float = 6.0):
        return http_json(
            f"http://127.0.0.1:8096{path}",
            {"Authorization": f'MediaBrowser Token="{self.s.jellyfin()}"'},
            timeout=timeout,
        )

    def _jf_meta_fetch(self) -> dict:
        info = self._jf("/System/Info") or {}
        counts = self._jf("/Items/Counts") or {}
        return {"version": info.get("Version") or "?", "counts": counts}

    def jellyfin(self, svc: dict) -> dict:
        key = self.s.jellyfin()
        if not key:
            return {"value": "-", "detail": "no api key"}
        sessions = self._jf("/Sessions") or []
        playing = [s for s in sessions if s.get("NowPlayingItem")]
        meta = self._jf_meta.get()
        counts = meta.get("counts") or {}

        items = []
        for sess in playing:
            it = sess.get("NowPlayingItem") or {}
            ps = sess.get("PlayState") or {}
            ticks = float(it.get("RunTimeTicks") or 0)
            pos = float(ps.get("PositionTicks") or 0)
            label = it.get("Name") or "?"
            if it.get("SeriesName"):
                label = f"{it['SeriesName']} - {label}"
            items.append({
                "kind": "play",
                "name": label,
                "fraction": (pos / ticks) if ticks else 0.0,
                "right": "transcode" if sess.get("TranscodingInfo") else "direct",
                "sub": sess.get("UserName") or "?",
            })

        rows = []
        for sess in playing[:3]:
            it = sess.get("NowPlayingItem") or {}
            ps = sess.get("PlayState") or {}
            ticks = float(it.get("RunTimeTicks") or 0)
            pos = float(ps.get("PositionTicks") or 0)
            left = ""
            if ticks and pos:
                left = f" - {rel_time((ticks - pos) / 1e7).replace('in ', '')} left"
            tr = sess.get("TranscodingInfo") or {}
            how = "transcode" if tr else "direct play"
            if tr.get("Bitrate"):
                how += f" {human_bytes(float(tr['Bitrate']) / 8, 'B/s')}"
            paused = " (paused)" if ps.get("IsPaused") else ""
            rows.append((sess.get("UserName") or "?", f"{how}{left}{paused}"))
        idle_clients = len(sessions) - len(playing)
        if idle_clients > 0:
            rows.append(("idle clients", str(idle_clients)))
        lib = ", ".join(x for x in (
            f"{counts.get('SeriesCount')} series" if counts.get("SeriesCount") else "",
            f"{counts.get('EpisodeCount')} eps" if counts.get("EpisodeCount") else "",
            f"{counts.get('MovieCount')} movies" if counts.get("MovieCount") else "",
        ) if x)
        if lib:
            rows.append(("library", lib))
        rows.append(("version", meta.get("version") or "?"))

        if not playing:
            return {
                "value": "idle",
                "detail": f"{len(sessions)} client(s) connected",
                "rows": rows,
                "spark": 0,
            }
        first = playing[0]
        item = first.get("NowPlayingItem") or {}
        name = item.get("SeriesName") or item.get("Name") or "?"
        method = "transcode" if first.get("TranscodingInfo") else "direct"
        who = first.get("UserName") or "?"
        extra = f" +{len(playing) - 1}" if len(playing) > 1 else ""
        return {
            "status": BUSY,
            "value": f"{len(playing)} streaming",
            "detail": f"{name[:26]} - {who}, {method}{extra}",
            "items": items,
            "rows": rows,
            "spark": len(playing),
        }

    def jellyfin_recent(self, limit: int = 40) -> list:
        """What has landed in the library lately, newest first.

        One request, and Jellyfin already knows the real series and episode
        titles -- Sonarr's history would hand back release names like
        "[MiniMTBB] Steins;Gate - 24 (BD 1080p) [71267376]".

        A flat chronological log, one row per item. Runs of one series used
        to collapse into "S01E19-E24, 6 episodes" to stop a batch import
        crowding the list out, but the list lives in a scrolling panel now, so
        there is nothing to crowd -- and collapsing turned a library holding
        one show into a panel with three rows in it.
        """
        if not self.s.jellyfin():
            return []
        data = self._jf(
            "/Items?Recursive=true&IncludeItemTypes=Episode,Movie"
            "&SortBy=DateCreated&SortOrder=Descending"
            f"&Limit={limit}&Fields=DateCreated,SeriesName,ParentIndexNumber,IndexNumber",
            timeout=10.0,
        ) or {}
        now = time.time()
        out: list[dict] = []
        for it in data.get("Items") or []:
            created = it.get("DateCreated") or ""
            try:
                ts = calendar.timegm(time.strptime(created[:19], "%Y-%m-%dT%H:%M:%S"))
            except ValueError:
                ts = now
            series = it.get("SeriesName")
            if series:
                name = (f"{series} S{int(it.get('ParentIndexNumber') or 0):02d}"
                        f"E{int(it.get('IndexNumber') or 0):02d}")
                sub = it.get("Name") or ""
            else:
                name = it.get("Name") or "?"
                sub = "movie"
            out.append({"name": name, "sub": sub, "right": rel_time(ts - now)})
        return out

    # -- qbittorrent: transfer rate ----------------------------------------
    def _qb_hdr(self) -> dict:
        return {"Authorization": f"Bearer {self.s.qbittorrent()}"}

    def _qb_disk_fetch(self) -> dict:
        data = http_json("http://127.0.0.1:8085/api/v2/sync/maindata", self._qb_hdr()) or {}
        return data.get("server_state") or {}

    def qbittorrent(self, svc: dict) -> dict:
        key = self.s.qbittorrent()
        if not key:
            return {"value": "-", "detail": "no api key in qBittorrent.conf"}
        hdr = self._qb_hdr()
        info = http_json("http://127.0.0.1:8085/api/v2/transfer/info", hdr) or {}
        dl = float(info.get("dl_info_speed") or 0)
        up = float(info.get("up_info_speed") or 0)
        torrents = http_json("http://127.0.0.1:8085/api/v2/torrents/info", hdr) or []
        dl_states = ("downloading", "metaDL", "forcedDL", "stalledDL", "checkingDL")
        up_states = ("uploading", "forcedUP", "stalledUP")
        active = [t for t in torrents if (t.get("state") or "") in dl_states]
        seeding = [t for t in torrents if (t.get("state") or "") in up_states]
        paused = [t for t in torrents if "paused" in (t.get("state") or "").lower()]
        conn = (info.get("connection_status") or "").lower()
        server = self._qb_disk.get()

        left = sum(float(t.get("amount_left") or 0) for t in active)
        rows = [
            ("transfer", f"{human_bytes(dl, 'B/s')} down - {human_bytes(up, 'B/s')} up"),
            ("torrents", " - ".join(x for x in (
                f"{len(torrents)} total",
                f"{len(active)} downloading" if active else "",
                f"{len(seeding)} seeding" if seeding else "",
                f"{len(paused)} paused" if paused else "",
            ) if x)),
        ]
        if left > 0:
            rows.append(("remaining", human_bytes(left) + (
                f" - {rel_time(left / dl).replace('in ', '')} left" if dl > 0 else " - stalled")))
        rows.append(("session", f"{human_bytes(float(info.get('dl_info_data') or 0))} down - "
                                f"{human_bytes(float(info.get('up_info_data') or 0))} up"))
        if server.get("global_ratio") is not None:
            rows.append(("ratio", str(server.get("global_ratio"))))
        if server.get("free_space_on_disk"):
            rows.append(("free on disk", human_bytes(float(server["free_space_on_disk"]))))
        # Only worth a row when it is the answer to "why is nothing moving".
        if conn not in ("connected", "firewalled"):
            rows.append(("connection", conn or "?"))

        if conn not in ("connected", "firewalled"):
            return {"status": WARN, "value": conn or "?",
                    "detail": "not connected to peers", "rows": rows, "spark": 0}
        if dl > 0:
            eta = ""
            if left > 0:
                secs = int(left / dl)
                eta = f", {secs // 60}m left" if secs < 5400 else f", {secs // 3600}h left"
            items = []
            for t in sorted(active, key=lambda x: -float(x.get("dlspeed") or 0))[:6]:
                items.append({
                    "kind": "dl",
                    "name": t.get("name") or "?",
                    "fraction": float(t.get("progress") or 0.0),
                    "right": human_bytes(float(t.get("dlspeed") or 0), "B/s"),
                    "sub": t.get("state") or "",
                })
            return {
                "status": BUSY,
                "value": human_bytes(dl, "B/s"),
                "detail": f"{len(active)} active{eta}",
                "items": items,
                "rows": rows,
                "spark": dl,
            }
        detail = f"{len(torrents)} torrent(s)"
        if up > 0:
            detail += f", up {human_bytes(up, 'B/s')}"
        return {"value": "idle", "detail": detail, "rows": rows, "spark": 0}

    # -- open-webui / llama-swap -------------------------------------------
    def llm(self, svc: dict) -> dict:
        try:
            models = (http_json(f"{self.llm_url}/v1/models", timeout=4.0) or {}).get("data") or []
        except Exception:
            return {"status": WARN, "value": "no backend", "detail": "llama-swap unreachable",
                    "rows": [("backend", self.llm_url), ("state", "unreachable")]}
        names = [m.get("id") for m in models if m.get("id")]
        running = []
        try:
            # llama-swap exposes which upstreams are actually loaded; if this
            # endpoint moves, the model list alone is still useful.
            for m in http_json(f"{self.llm_url}/running", timeout=4.0).get("running") or []:
                if m.get("model"):
                    running.append(m["model"])
        except Exception:
            pass
        rows = [("loaded", ", ".join(running) if running else "none")]
        for n in names[:2]:
            rows.append(("model", n))
        if len(names) > 2:
            rows.append(("", f"+{len(names) - 2} more"))
        rows.append(("backend", self.llm_url))
        if running:
            return {"status": BUSY, "value": running[0][:18], "detail": "model loaded", "rows": rows}
        if not models:
            return {"value": "no models", "detail": "drop a .gguf in ~/llm/models", "rows": rows}
        return {"value": f"{len(models)} model(s)", "detail": "none loaded", "rows": rows}

    # -- seerr: pending requests -------------------------------------------
    def _seerr_ver_fetch(self) -> dict:
        return http_json("http://127.0.0.1:5055/api/v1/status",
                         {"X-Api-Key": self.s.seerr()}) or {}

    def seerr(self, svc: dict) -> dict:
        key = self.s.seerr()
        if not key:
            return {"detail": "no api key"}
        counts = http_json("http://127.0.0.1:5055/api/v1/request/count", {"X-Api-Key": key}) or {}
        pending = int(counts.get("pending") or 0)
        total = int(counts.get("total") or 0)
        ver = self._seerr_ver.get()
        rows = [
            ("pending", str(pending)),
            ("processing", str(counts.get("processing") or 0)),
        ] + ([("declined", str(counts["declined"]))] if counts.get("declined") else []) + [
            ("available", str(counts.get("available") or 0)),
            ("split", f"{counts.get('movie') or 0} movies - {counts.get('tv') or 0} tv"),
            ("version", str(ver.get("version") or "?") +
                        (" - update available" if ver.get("updateAvailable") else "")),
        ]
        if pending:
            return {"status": BUSY, "value": str(pending),
                    "detail": f"{pending} pending of {total}", "rows": rows}
        return {"value": "0", "detail": f"{total} request(s), none pending", "rows": rows}

    # -- sonarr / radarr: queue depth --------------------------------------
    def _arr_slow_fetch(self, svc: dict):
        """Library totals and what is next -- too heavy for the poll interval."""
        sid, port = svc["id"], svc.get("port")
        key = self.s.arr(sid)
        base = f"http://127.0.0.1:{port}/api/v3"
        hdr = {"X-Api-Key": key}
        out: dict = {}
        try:
            missing = http_json(f"{base}/wanted/missing?pageSize=1", hdr, timeout=10.0) or {}
            out["missing"] = int(missing.get("totalRecords") or 0)
        except Exception:
            pass
        if sid == "sonarr":
            series = http_json(f"{base}/series", hdr, timeout=25.0) or []
            out["count"] = len(series)
            out["size"] = sum(float((s.get("statistics") or {}).get("sizeOnDisk") or 0) for s in series)
            out["files"] = sum(int((s.get("statistics") or {}).get("episodeFileCount") or 0) for s in series)
            out["noun"] = "series"
            out["file_noun"] = "eps"
            try:
                now = time.time()
                cal = http_json(
                    f"{base}/calendar?pageSize=20&includeSeries=true", hdr, timeout=10.0) or []
                soon = []
                for e in cal:
                    air = e.get("airDateUtc")
                    if not air:
                        continue
                    ts = calendar.timegm(time.strptime(air[:19], "%Y-%m-%dT%H:%M:%S"))
                    if ts >= now:
                        soon.append((ts, e))
                if soon:
                    ts, e = min(soon)
                    title = (e.get("series") or {}).get("title") or "?"
                    out["next"] = (f"{title[:22]} S{e.get('seasonNumber', 0):02d}"
                                   f"E{e.get('episodeNumber', 0):02d} {rel_time(ts - now)}")
            except Exception:
                pass
        else:
            movies = http_json(f"{base}/movie", hdr, timeout=25.0) or []
            out["count"] = len(movies)
            out["size"] = sum(float(m.get("sizeOnDisk") or 0) for m in movies)
            out["files"] = sum(1 for m in movies if m.get("hasFile"))
            out["noun"] = "movies"
            out["file_noun"] = "on disk"
        return out

    def arr_slow(self, svc: dict) -> dict:
        """Public so the library panel can reuse the same cached aggregate."""
        c = self._arr_slow.get(svc["id"])
        if c is None:
            c = Cached(300.0, lambda s=svc: self._arr_slow_fetch(s))
            self._arr_slow[svc["id"]] = c
        return c.get()

    def arr(self, svc: dict) -> dict:
        key = self.s.arr(svc["id"])
        port = svc.get("port")
        if not key or not port:
            return {"detail": "no api key"}
        data = http_json(
            f"http://127.0.0.1:{port}/api/v3/queue?pageSize=20&includeEpisode=true",
            {"X-Api-Key": key},
        ) or {}
        n = int(data.get("totalRecords") or 0)
        slow = self.arr_slow(svc)

        rows = []
        for rec in (data.get("records") or [])[:3]:
            title = rec.get("title") or "?"
            size = float(rec.get("size") or 0)
            left = float(rec.get("sizeleft") or 0)
            pct = f"{(1 - left / size) * 100:.0f}%" if size else ""
            rows.append((rec.get("status") or "queued", f"{title[:34]} {pct}".strip()))
        if n > 3:
            rows.append(("", f"+{n - 3} more queued"))
        if slow.get("count") is not None:
            rows.append(("library", f"{human_bytes(slow.get('size') or 0)}, "
                                    f"{slow['count']} {slow.get('noun', '')}"))
        if slow.get("missing") is not None:
            rows.append(("missing", f"{slow['missing']} wanted"))
        if slow.get("next"):
            rows.append(("next", slow["next"]))
        if not rows:
            rows.append(("queue", "empty"))
        return {"status": BUSY if n else UP, "value": str(n),
                "detail": f"{n} queued" if n else "queue empty", "rows": rows}

    def bazarr(self, svc: dict) -> dict:
        key = self.s.bazarr()
        port = svc.get("port")
        if not key or not port:
            return {"detail": "no api key"}
        hdr = {"X-API-KEY": key}
        base = f"http://127.0.0.1:{port}/api"
        try:
            b = http_json(f"{base}/badges", hdr) or {}
        except Exception:
            code = http_code(f"{base}/system/status", hdr)
            return {"status": UP if code == 200 else WARN, "value": "",
                    "detail": f"HTTP {code}", "rows": [("api", f"HTTP {code}")]}
        eps = int(b.get("episodes") or 0)
        mov = int(b.get("movies") or 0)
        wanted = eps + mov
        rows = [
            ("wanted", f"{eps} episodes - {mov} movies" if wanted else "nothing missing"),
            ("providers", str(b.get("providers") or 0)),
            ("sonarr", str(b.get("sonarr_signalr") or "?").lower()),
            ("radarr", str(b.get("radarr_signalr") or "?").lower()),
        ]
        bad = [k for k in ("sonarr_signalr", "radarr_signalr")
               if str(b.get(k) or "").upper() != "LIVE"]
        return {
            "status": WARN if bad else UP,
            "value": str(wanted) if wanted else "",
            "detail": (f"{wanted} subtitle(s) wanted" if wanted else "all subtitles present")
                      if not bad else f"{bad[0].split('_')[0]} link down",
            "rows": rows,
        }

    # -- tailscale ---------------------------------------------------------
    def tailscale(self, svc: dict) -> dict:
        exe = shutil.which("tailscale")
        if not exe:
            return {}
        out = subprocess.run(
            [exe, "status", "--json"], capture_output=True, text=True, timeout=8
        )
        if out.returncode != 0:
            return {"status": WARN, "detail": "tailscale status failed"}
        data = json.loads(out.stdout)
        self_node = data.get("Self") or {}
        ip = (self_node.get("TailscaleIPs") or ["?"])[0]
        peers = data.get("Peer") or {}
        online = [p for p in peers.values() if p.get("Online")]
        rows = [
            ("this node", f"{self_node.get('HostName') or '?'} - {ip}"),
            ("peers", f"{len(online)}/{len(peers)} online"),
        ]
        exit_node = next((p.get("HostName") for p in peers.values() if p.get("ExitNode")), None)
        if exit_node:
            rows.append(("exit node", exit_node))
        for p in sorted(online, key=lambda x: (x.get("HostName") or ""))[:4]:
            rx = float(p.get("RxBytes") or 0) + float(p.get("TxBytes") or 0)
            rows.append((p.get("HostName") or "?",
                         human_bytes(rx) if rx else "idle"))
        return {"detail": f"{ip} - {len(online)}/{len(peers)} peers online", "rows": rows}


# --------------------------------------------------------------------------
# collector
# --------------------------------------------------------------------------

SPARK_SAMPLES = 90          # sparkline width, in polls
DISK_HISTORY = "~/.cache/homelab-dash/disk-history.json"


class Collector:
    """Per-service intervals on one scheduler thread, work done in a pool.

    A slow or hanging probe must not stall the others - that is the whole
    reason for the pool rather than a simple sequential loop.
    """

    def __init__(self, cfg: dict, services: list[dict], on_update):
        self.cfg = cfg
        self.services = services
        self.on_update = on_update
        self.secrets = Secrets(expand(cfg["paths"]["stack"]), cfg.get("credentials", {}))
        self.probes = Probes(cfg, self.secrets)
        self.state: dict[str, dict] = {
            s["id"]: {"status": UNKNOWN, "value": "", "detail": ""} for s in services
        }
        self.extra: dict[str, object] = {
            "free": None, "total": None, "docker_error": None,
            "library": {}, "fill_in": None, "recent": [],
        }
        self.history: dict[str, deque] = {
            s["id"]: deque(maxlen=SPARK_SAMPLES) for s in services
        }
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._pool = ThreadPoolExecutor(max_workers=6, thread_name_prefix="probe")
        self._inflight: set[str] = set()
        self._due: dict[str, float] = {}

    # -- docker ------------------------------------------------------------
    def _docker(self):
        dcfg = self.cfg.get("docker", {})
        conn = UnixHTTPConnection(dcfg.get("socket", "/var/run/docker.sock"), timeout=5.0)
        try:
            conn.request("GET", "/v1.43/containers/json?all=1")
            resp = conn.getresponse()
            payload = json.loads(resp.read() or b"[]")
        finally:
            conn.close()
        project = dcfg.get("project")
        out = {}
        for c in payload:
            labels = c.get("Labels") or {}
            if project and labels.get("com.docker.compose.project") != project:
                continue
            for name in c.get("Names") or []:
                out[name.lstrip("/")] = c
        return out

    @staticmethod
    def _docker_status(c: dict | None) -> tuple[str, str]:
        if not c:
            return DOWN, "not created"
        state = (c.get("State") or "").lower()
        status = c.get("Status") or ""
        if state != "running":
            return DOWN, status or state
        m = re.search(r"\((healthy|unhealthy|health: starting)\)", status)
        if m:
            h = m.group(1)
            if h == "healthy":
                return UP, "healthy"
            if h == "unhealthy":
                return DOWN, "unhealthy"
            return WARN, "starting"
        return UP, status.split(" (")[0] or "running"

    @staticmethod
    def _docker_meta(c: dict | None) -> dict:
        """The facts a hover row wants, all of them already in the list reply.

        Deliberately no per-container inspect: nine of these on every tick
        would be nine more round-trips for two extra strings.
        """
        if not c:
            return {}
        status = c.get("Status") or ""
        m = re.match(r"Up (.+?)(?: \(|$)", status)
        uptime = m.group(1) if m else ""
        image = (c.get("Image") or "").split("@")[0]
        ports = sorted({
            str(p["PublicPort"]) for p in (c.get("Ports") or []) if p.get("PublicPort")
        }, key=lambda s: int(s))
        return {
            "docker_uptime": uptime,
            "docker_image": image,
            "docker_ports": ", ".join(ports),
            "docker_created": c.get("Created"),
        }

    # -- scheduling --------------------------------------------------------
    def start(self):
        threading.Thread(target=self._loop, name="scheduler", daemon=True).start()

    def stop(self):
        self._stop.set()
        self._pool.shutdown(wait=False, cancel_futures=True)

    def _interval(self, svc: dict) -> float:
        return float(svc.get("interval") or self.cfg["general"].get("poll_interval") or 10.0)

    def _loop(self):
        docker_iv = float(self.cfg.get("docker", {}).get("interval") or 5.0)
        next_docker = 0.0
        next_disk = 0.0
        next_library = 0.0
        next_recent = 0.0
        while not self._stop.is_set():
            now = time.monotonic()

            if now >= next_docker:
                next_docker = now + docker_iv
                self._submit("__docker__", self._run_docker)

            if now >= next_disk:
                next_disk = now + 60.0
                self._submit("__disk__", self._run_disk)

            if now >= next_library:
                next_library = now + 300.0
                self._submit("__library__", self._run_library)

            if now >= next_recent:
                next_recent = now + 120.0
                self._submit("__recent__", self._run_recent)

            for svc in self.services:
                probe = svc.get("probe")
                if not probe or not hasattr(self.probes, probe):
                    continue
                if now >= self._due.get(svc["id"], 0.0):
                    self._due[svc["id"]] = now + self._interval(svc)
                    self._submit(svc["id"], self._run_probe, svc)

            self._stop.wait(0.4)

    def _submit(self, key: str, fn, *args):
        with self._lock:
            if key in self._inflight:
                # Still running from last time: skip rather than pile up.
                return
            self._inflight.add(key)

        def wrapper():
            try:
                fn(*args)
            finally:
                with self._lock:
                    self._inflight.discard(key)
                GLib.idle_add(self.on_update, priority=GLib.PRIORITY_DEFAULT_IDLE)

        self._pool.submit(wrapper)

    # -- units of work -----------------------------------------------------
    def _run_docker(self):
        try:
            containers = self._docker()
            err = None
        except PermissionError:
            containers, err = {}, "no access to docker socket (are you in the docker group?)"
        except Exception as e:  # socket gone, daemon down, malformed reply
            containers, err = {}, f"docker: {type(e).__name__}"
        with self._lock:
            self.extra["docker_error"] = err
            for svc in self.services:
                cname = svc.get("container")
                if not cname:
                    continue
                c = containers.get(cname)
                st, detail = (UNKNOWN, err) if err else self._docker_status(c)
                cur = self.state[svc["id"]]
                cur["docker_status"] = st
                cur["docker_detail"] = detail
                cur.update(self._docker_meta(None if err else c))
                # A probe's richer verdict normally wins, but a dead container
                # is not something a stale probe result gets to paper over.
                if st == DOWN or not cur.get("probe_ok"):
                    cur["status"] = st
                    if st == DOWN:
                        cur["items"] = []
                        cur["value"] = ""
                    if st == DOWN or not cur.get("detail"):
                        cur["detail"] = detail

    def _run_disk(self):
        try:
            st = os.statvfs(expand(self.cfg["paths"]["media_mount"]))
            free = st.f_bavail * st.f_frsize
            total = st.f_blocks * st.f_frsize
        except OSError:
            with self._lock:
                self.extra["free"] = self.extra["total"] = None
            return
        fill_in = self._disk_trend(free)
        with self._lock:
            self.extra["free"] = free
            self.extra["total"] = total
            self.extra["fill_in"] = fill_in

    def _disk_trend(self, free: float):
        """How long until the media disk is full, from samples on disk.

        A dashboard that says "852 GB free" tells you nothing about whether
        that is a month or a week. Half-hourly samples over the last 90 days
        are enough for a least-squares slope, and cheap to keep.
        """
        path = expand(DISK_HISTORY)
        now = time.time()
        try:
            hist = json.loads(path.read_text())
            if not isinstance(hist, list):
                hist = []
        except (OSError, json.JSONDecodeError):
            hist = []
        hist = [h for h in hist
                if isinstance(h, list) and len(h) == 2 and now - h[0] < 90 * 86400]
        if not hist or now - hist[-1][0] > 1800:
            hist.append([now, free])
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps(hist))
            except OSError:
                pass
        if len(hist) < 3 or now - hist[0][0] < 6 * 3600:
            return None
        # least squares over (hours, bytes free)
        xs = [(h[0] - hist[0][0]) / 3600.0 for h in hist]
        ys = [float(h[1]) for h in hist]
        n = len(xs)
        mx = sum(xs) / n
        my = sum(ys) / n
        den = sum((x - mx) ** 2 for x in xs)
        if den <= 0:
            return None
        slope = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / den
        if slope >= 0:
            return "not filling"
        hours = free / -slope
        if hours > 365 * 24:
            return "over a year"
        return rel_time(hours * 3600).replace("in ", "")

    def _run_library(self):
        """Per-library sizes for the disk panel, from Sonarr's and Radarr's
        own totals - far cheaper and far more useful than walking the mount."""
        out = {}
        for svc in self.services:
            if svc.get("probe") != "arr":
                continue
            try:
                agg = self.probes.arr_slow(svc)
            except Exception:
                continue
            if agg.get("count") is None:
                continue
            out[svc["id"]] = {
                "label": svc.get("label") or svc["id"],
                "count": agg.get("count"),
                "size": agg.get("size") or 0,
                "files": agg.get("files") or 0,
                "noun": agg.get("noun") or "",
                "file_noun": agg.get("file_noun") or "",
            }
        with self._lock:
            self.extra["library"] = out

    def _run_recent(self):
        try:
            recent = self.probes.jellyfin_recent()
        except Exception:
            return
        with self._lock:
            self.extra["recent"] = recent

    def _run_probe(self, svc: dict):
        fn = getattr(self.probes, svc["probe"])
        try:
            result = fn(svc) or {}
            ok = True
        except Exception as e:
            result = {"status": WARN, "detail": f"{type(e).__name__}"}
            ok = False
        with self._lock:
            cur = self.state[svc["id"]]
            cur["probe_ok"] = ok
            # Docker is the floor: a probe cannot claim UP for a dead container.
            floor = cur.get("docker_status", UNKNOWN)
            status = result.get("status") or (floor if floor != UNKNOWN else UP)
            if floor in (DOWN, UNKNOWN):
                status = floor
                result.setdefault("detail", cur.get("docker_detail", ""))
            cur["status"] = status
            cur["value"] = result.get("value", cur.get("value", ""))
            cur["detail"] = result.get("detail") or cur.get("docker_detail", "")
            cur["items"] = result.get("items") or []
            cur["rows"] = result.get("rows") or []
            if "spark" in result and status not in (DOWN, UNKNOWN):
                self.history[svc["id"]].append(float(result["spark"]))

    def snapshot(self):
        with self._lock:
            return (
                {k: dict(v) for k, v in self.state.items()},
                dict(self.extra),
                {k: list(v) for k, v in self.history.items()},
            )


