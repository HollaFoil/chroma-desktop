From: local build
Subject: [PATCH] daemon: ignore unknown allowCredentials transports instead of dropping the credential

The transports list on a PublicKeyCredentialDescriptor is only a hint, and
the WebAuthn spec says unknown values must be ignored. 0.2.0 instead fails
the whole descriptor conversion on any value outside ble/nfc/usb/internal,
and the caller in dbus/model.rs filter_maps on Ok(), so the credential
silently vanishes from the allow list sent to the authenticator.

Phone passkeys created through the hybrid flow are tagged
["cable", "internal"] by relying parties (e.g. accounts.google.com), so
exactly those were dropped, and the phone then correctly reported that it
had no matching passkey. Map the known values, drop unknown ones, and let
an all-unknown list collapse to None. The transports were being cleared
right afterwards anyway (see the TODO in dbus/model.rs), so nothing
downstream depended on the strictness.

Fixed differently upstream after 0.2.0 by moving JSON parsing into
libwebauthn (04566df); drop this patch on the next release.
---
diff --git a/credentialsd/src/webauthn.rs b/credentialsd/src/webauthn.rs
index cf4a82c..3852a9b 100644
--- a/credentialsd/src/webauthn.rs
+++ b/credentialsd/src/webauthn.rs
@@ -244,25 +244,24 @@ pub(crate) struct CredentialDescriptor {
 impl TryFrom<&CredentialDescriptor> for Ctap2PublicKeyCredentialDescriptor {
     type Error = Error;
     fn try_from(value: &CredentialDescriptor) -> Result<Self, Self::Error> {
-        let transports = value.transports.as_ref().filter(|t| !t.is_empty());
-        let transports = match transports {
-            Some(transports) => {
-                let mut transport_list = transports.iter().map(|t| match t.as_ref() {
-                    "ble" => Some(Ctap2Transport::Ble),
-                    "nfc" => Some(Ctap2Transport::Nfc),
-                    "usb" => Some(Ctap2Transport::Usb),
-                    "internal" => Some(Ctap2Transport::Internal),
-                    _ => None,
-                });
-                if transport_list.any(|t| t.is_none()) {
-                    return Err(Error::Internal(
-                        "Invalid transport type specified".to_owned(),
-                    ));
-                }
-                transport_list.collect()
-            }
-            None => None,
-        };
+        // Transports are a hint; unknown values (e.g. "cable", "hybrid") must
+        // be ignored, not fail the descriptor.
+        let transports: Option<Vec<Ctap2Transport>> = value
+            .transports
+            .as_ref()
+            .map(|transports| {
+                transports
+                    .iter()
+                    .filter_map(|t| match t.as_ref() {
+                        "ble" => Some(Ctap2Transport::Ble),
+                        "nfc" => Some(Ctap2Transport::Nfc),
+                        "usb" => Some(Ctap2Transport::Usb),
+                        "internal" => Some(Ctap2Transport::Internal),
+                        _ => None,
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .filter(|t| !t.is_empty());
         Ok(Self {
             r#type: Ctap2PublicKeyCredentialType::PublicKey,
             id: value.id.clone().into(),
