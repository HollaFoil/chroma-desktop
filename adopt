#!/bin/bash
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$REPO/manifest.txt"

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    # seeds are the user's own copy; the repo's is the default, edited by hand
    [[ "$line" == seed\ * ]] && { echo "seed (not adopted): ${line#seed }"; continue; }

    SRC="$HOME/$line"
    DST="$REPO/files/$line"

    if [[ -L "$SRC" ]]; then
        echo "skip (already linked): $line"
        continue
    fi

    if [[ ! -e "$SRC" ]]; then
        echo "MISSING: $line"
        continue
    fi

    mkdir -p "$(dirname "$DST")"
    cp -a "$SRC" "$DST"
    echo "adopted: $line"
done < "$MANIFEST"
