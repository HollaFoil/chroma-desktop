#!/bin/bash
set -euo pipefail

SRC="$HOME/.config/oh-my-posh/themes/agnoster.omp.json"
OUT="$HOME/.config/oh-my-posh/current.omp.json"
COLORS="$HOME/.config/matugen/colors.sh"

if [[ ! -f "$COLORS" ]]; then
    echo "no colours yet, run setwall first" >&2
    exit 1
fi

source "$COLORS"

jq \
  --arg root      "$ERROR" \
  --arg onRoot    "$ON_ERROR" \
  --arg session   "$SURFACE_CONTAINER_HIGH" \
  --arg onSession "$ON_SURFACE" \
  --arg path      "$PRIMARY" \
  --arg onPath    "$ON_PRIMARY" \
  --arg git       "$TERTIARY" \
  --arg onGit     "$ON_TERTIARY" \
  --arg python    "$SECONDARY" \
  --arg onPython  "$ON_SECONDARY" \
  --arg status    "$ERROR" \
  --arg onStatus  "$ON_ERROR" \
  '
  .blocks[].segments |= map(
    if   .type == "root"    then .background = $root    | .foreground = $onRoot
    elif .type == "session" then .background = $session | .foreground = $onSession
    elif .type == "path"    then .background = $path    | .foreground = $onPath
    elif .type == "git"     then .background = $git     | .foreground = $onGit
    elif .type == "python"  then .background = $python  | .foreground = $onPython
    elif .type == "status"  then .background = $status  | .foreground = $onStatus
    else . end
  )
  ' "$SRC" > "$OUT"

echo "wrote $OUT"

# oh-my-posh parses the config once per shell session and caches the result in
# ~/.cache/oh-my-posh/<shell>.<session-id>.omp.cache, keyed by POSH_SESSION_ID
# and never revalidated against the config's mtime. That cache is why a running
# shell keeps the old palette until it is relaunched - a new shell gets a new
# session id, hence a fresh read. Dropping the session caches makes every live
# shell re-read this file on its next prompt; the shared omp.cache (upgrade
# state, accent colour) is deliberately left alone.
find "${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-posh" -maxdepth 1 \
    -name '*.*.omp.cache' -delete 2>/dev/null || true

echo "invalidated oh-my-posh session caches"
