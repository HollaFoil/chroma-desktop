#!/bin/bash
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$REPO/manifest.txt"
BACKUP="$REPO/backup-$(date +%Y%m%d-%H%M%S)"

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    # `seed <path>`: copied once, never linked, never overwritten. A symlink
    # into the repo (how older versions linked it) is replaced by a copy of
    # what it points at, so what was written through it stays yours.
    if [[ "$line" == seed\ * ]]; then
        line="${line#seed }"
        SRC="$HOME/$line"
        DST="$REPO/files/$line"
        [[ -e "$DST" ]] || { echo "not in repo: $line"; continue; }
        if [[ -L "$SRC" ]]; then
            # copy beside, rename over: Hyprland reloads on a change to a file it
            # loaded, and must never see the path missing in between
            target="$(readlink -f "$SRC")"
            cp "$target" "$SRC.link-$$" && mv -T "$SRC.link-$$" "$SRC"
            echo "unlinked (now your own copy): $line"
        elif [[ -e "$SRC" ]]; then
            echo "ok (yours): $line"
        else
            mkdir -p "$(dirname "$SRC")"
            cp "$DST" "$SRC"
            echo "seeded: $line"
        fi
        continue
    fi

    SRC="$HOME/$line"
    DST="$REPO/files/$line"

    if [[ ! -e "$DST" ]]; then
        echo "not in repo, run ./adopt first: $line"
        continue
    fi

    # already correctly linked?
    if [[ -L "$SRC" && "$(readlink -f "$SRC")" == "$(readlink -f "$DST")" ]]; then
        echo "ok: $line"
        continue
    fi

    # back up anything real that's in the way
    if [[ -e "$SRC" && ! -L "$SRC" ]]; then
        mkdir -p "$BACKUP/$(dirname "$line")"
        mv "$SRC" "$BACKUP/$line"
        echo "backed up: $line"
    elif [[ -L "$SRC" ]]; then
        rm "$SRC"
    fi

    mkdir -p "$(dirname "$SRC")"
    ln -s "$DST" "$SRC"
    echo "linked: $line"
done < "$MANIFEST"

[[ -d "$BACKUP" ]] && echo "" && echo "originals backed up to: $BACKUP"
