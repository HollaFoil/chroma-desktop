#!/bin/bash
# First-time setup for these dotfiles on an Arch/CachyOS machine.
#
#   ./bootstrap --check            report missing packages and files, change nothing
#   ./bootstrap                    install packages (asks first), link, wire up the session
#   ./bootstrap --wallpaper IMG    ...and run setwall on IMG so the colours exist at first login
#   ./bootstrap --monitors         (re)write the monitor and workspace config for this machine
#
# Everything here is idempotent; run it again after pulling changes. The
# per-app integrations (Steam, Spotify, Discord, Firefox, oh-my-posh) are only
# set up when the app is installed, and are always safe to skip.
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHECK=0
WALL=""
MONITORS=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)     CHECK=1 ;;
        --wallpaper) WALL="${2:-}"; shift ;;
        --monitors)  MONITORS=1 ;;
        -h|--help)   sed -n '2,11p' "$0"; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

if [[ $MONITORS == 1 ]]; then
    # The repo copy, so this works before ./link has run.
    exec "$REPO/files/.local/bin/gen-monitors"
fi

bold() { printf '\n\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
miss() { printf '  \033[31m✗\033[0m %s\n' "$1"; }
ask()  { local a; read -r -p "  $1 [y/N] " a; [[ "$a" =~ ^[Yy] ]]; }

# ---- packages -------------------------------------------------------
# packages.txt is sectioned; collect names per section, keep the purposes for
# the report.
declare -A PKG_SECTION PKG_WHY
ORDER=()
section=""
while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^\[(.+)\]$ ]]; then section="${BASH_REMATCH[1]}"; continue; fi
    name="${line%%[[:space:]]*}"
    why="${line#*#}"; [[ "$why" == "$line" ]] && why=""
    PKG_SECTION[$name]="$section"; PKG_WHY[$name]="${why# }"; ORDER+=("$name")
done < "$REPO/packages.txt"

# A package counts as present if pacman has it, or if the command it provides
# is on PATH (oh-my-posh and spicetify are often installed by hand).
declare -A BIN_OF=([oh-my-posh-bin]=oh-my-posh [slack-desktop]=slack [google-chrome]=google-chrome-stable [vscodium-bin]=codium)
installed() { pacman -Qq "$1" >/dev/null 2>&1 || { [[ -n "${BIN_OF[$1]:-}" ]] && command -v "${BIN_OF[$1]}" >/dev/null 2>&1; }; }

# pacman -S aborts the whole transaction on one unknown name ("target not
# found"), which used to mean a single miscategorised package took its entire
# section down with it and installed nothing. Names are checked against the
# sync databases first, and anything unknown is reported and left out rather
# than allowed to cancel the rest.
pac_install() {
    local avail=() unknown=() p
    for p in "$@"; do
        if pacman -Si "$p" >/dev/null 2>&1; then avail+=("$p"); else unknown+=("$p"); fi
    done
    if [[ ${#unknown[@]} -gt 0 ]]; then
        warn "not in your repos, left out: ${unknown[*]}"
        warn "  (in the AUR, or renamed upstream — check the entry in packages.txt)"
    fi
    [[ ${#avail[@]} -gt 0 ]] || return 0
    sudo pacman -S --needed "${avail[@]}"
}

if ! command -v pacman >/dev/null 2>&1; then
    warn "no pacman: this is written for Arch/CachyOS. Skipping packages; see packages.txt for what to install."
fi

bold "Packages"
declare -A MISSING_BY
for p in "${ORDER[@]}"; do
    s="${PKG_SECTION[$p]}"
    if installed "$p"; then :; else
        MISSING_BY[$s]+=" $p"
    fi
done
for s in core fonts theming optional aur; do
    [[ -n "${MISSING_BY[$s]:-}" ]] || { ok "$s: all present"; continue; }
    miss "$s:"
    for p in ${MISSING_BY[$s]}; do printf '      %-28s %s\n' "$p" "${PKG_WHY[$p]}"; done
done

if [[ $CHECK == 0 ]] && command -v pacman >/dev/null 2>&1; then
    for s in core fonts; do
        [[ -n "${MISSING_BY[$s]:-}" ]] || continue
        if ask "install the missing [$s] packages with pacman?"; then
            # shellcheck disable=SC2086
            pac_install ${MISSING_BY[$s]}
        fi
    done
    for s in theming optional; do
        [[ -n "${MISSING_BY[$s]:-}" ]] || continue
        if ask "install the missing [$s] packages too? (apps you may not want)"; then
            # shellcheck disable=SC2086
            pac_install ${MISSING_BY[$s]}
        fi
    done
    if [[ -n "${MISSING_BY[aur]:-}" ]]; then
        helper=""
        for h in paru yay; do command -v "$h" >/dev/null 2>&1 && { helper="$h"; break; }; done
        if [[ -n "$helper" ]] && ask "install the missing [aur] packages with $helper?"; then
            # shellcheck disable=SC2086
            "$helper" -S --needed ${MISSING_BY[aur]}
        elif [[ -z "$helper" ]]; then
            warn "no AUR helper (paru/yay) found; install the [aur] entries you want by hand"
        fi
    fi
fi

# ---- hyprland version -----------------------------------------------
# hyprland.lua and conf/*.lua are read natively, with no conversion step, and
# only Hyprland >= 0.56 can do that. On anything older the config is not just
# ignored per-line: it cannot be parsed at all, so the session comes up with
# Hyprland's built-in defaults - no bar, no binds, no explanation. Worth
# saying out loud rather than letting someone discover it after a reboot.
MIN_HYPR="0.56.0"
bold "Hyprland version"
HV="$(hyprctl version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
[[ -n "$HV" ]] || HV="$(pacman -Q hyprland 2>/dev/null | awk '{print $2}')"
HV="${HV#v}"; HV="${HV%%-*}"
if [[ -z "$HV" ]]; then
    warn "hyprland not installed yet; this config needs >= $MIN_HYPR (it is Lua, not hyprland.conf)"
elif [[ "$(printf '%s\n%s\n' "$MIN_HYPR" "$HV" | sort -V | head -1)" != "$MIN_HYPR" ]]; then
    miss "hyprland $HV is too old for this config: hyprland.lua needs >= $MIN_HYPR."
    miss "  Older Hyprland cannot read a Lua config at all - you would log into an unconfigured session."
else
    ok "hyprland $HV (>= $MIN_HYPR, reads hyprland.lua natively)"
fi

# ---- monitors --------------------------------------------------------
# monitors.lua is one machine's three outputs, and their names also decide the
# workspace rules (hypr/state/monitors.json) and the bar's persistent
# workspaces. Wrong names are not a crash, just workspaces pinned to monitors
# that are not there, which is a confusing first hour. gen-monitors writes all
# three from hyprctl.
bold "Monitors"
CONNECTED=""
if command -v hyprctl >/dev/null 2>&1; then
    CONNECTED="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled != true) | .name' 2>/dev/null | sort | tr '\n' ' ')"
fi
if [[ -z "$CONNECTED" ]]; then
    warn "not in a Hyprland session; run  ./bootstrap --monitors  from inside one"
else
    DECLARED="$(sed -n 's/.*output *= *"\([^"]*\)".*/\1/p' "$REPO/files/.config/hypr/monitors.lua" 2>/dev/null | sort | tr '\n' ' ')"
    if [[ "$CONNECTED" == "$DECLARED" ]]; then
        ok "monitors.lua is this machine's: $CONNECTED"
    else
        miss "monitors.lua describes: ${DECLARED:-nothing}"
        miss "this machine has:      $CONNECTED"
        if [[ $CHECK == 1 ]]; then
            miss "run  ./bootstrap --monitors  to write monitors.lua, the workspace map and the bar"
        elif ask "write monitors.lua, the workspace map and the bar for this machine?"; then
            "$REPO/files/.local/bin/gen-monitors"
        fi
    fi
fi

# ---- redundant packages ---------------------------------------------
bold "Redundant packages (replaced by this setup)"
"$REPO/prune"

# ---- link -----------------------------------------------------------
bold "Symlinks"
if [[ $CHECK == 1 ]]; then
    n=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ ! -L "$HOME/$line" || "$(readlink -f "$HOME/$line")" != "$(readlink -f "$REPO/files/$line")" ]]; then
            miss "not linked: ~/$line"; n=$((n+1))
        fi
    done < "$REPO/manifest.txt"
    [[ $n == 0 ]] && ok "every manifest entry is linked"
else
    "$REPO/link" | grep -v '^ok:' || true
    ok "manifest linked (originals, if any, went to $REPO/backup-*)"
fi

# ---- files that have to be rendered per user ------------------------
bold "Per-user files"
# Firefox native-messaging manifests need an absolute path, so this one is a
# template rather than a symlink.
NM_DIR="$HOME/.mozilla/native-messaging-hosts"
if [[ $CHECK == 1 ]]; then
    [[ -f "$NM_DIR/matugenfox.json" ]] && ok "matugenfox.json rendered" || miss "matugenfox.json not rendered (Firefox site theming)"
else
    mkdir -p "$NM_DIR"
    sed "s|@HOME@|$HOME|" "$REPO/files/.mozilla/native-messaging-hosts/matugenfox.json.in" > "$NM_DIR/matugenfox.json"
    ok "rendered $NM_DIR/matugenfox.json"
fi

# ---- systemd user session -------------------------------------------
bold "systemd --user"
if [[ $CHECK == 1 ]]; then
    systemctl --user is-enabled quickshell.service >/dev/null 2>&1 && ok "quickshell.service enabled" || miss "quickshell.service not enabled"
    if command -v xsettingsd >/dev/null; then
        [[ -e "$HOME/.config/systemd/user/graphical-session.target.wants/xsettingsd.service" ]] && ok "xsettingsd.service wanted by graphical-session.target" || miss "xsettingsd.service not hooked into graphical-session.target"
    fi
else
    systemctl --user daemon-reload
    if systemctl --user cat quickshell.service >/dev/null 2>&1; then
        systemctl --user enable quickshell.service >/dev/null 2>&1 && ok "quickshell.service enabled (starts with hyprland-session.target)"
    else
        warn "quickshell.service unit not found; run ./link first, then re-run"
    fi
    # xsettingsd (GTK settings for Xwayland apps) ships a static unit with no
    # [Install]; add-wants is how a static unit gets pulled in by a target.
    if command -v xsettingsd >/dev/null; then
        systemctl --user add-wants graphical-session.target xsettingsd.service >/dev/null 2>&1 && ok "xsettingsd.service wanted by graphical-session.target"
    fi
    # hyprland-session.target is started by hyprland.lua at login; nothing to enable.
    ok "hyprland-session.target is linked (hyprland.lua starts it at login)"
fi

# ---- shell ----------------------------------------------------------
# config.fish is linked either way, but nothing reads it unless fish is the
# login shell: the wallpaper-coloured oh-my-posh prompt then simply never
# appears, with no error anywhere to explain why.
bold "Shell"
FISH="$(command -v fish 2>/dev/null || true)"
LOGIN_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [[ -z "$FISH" ]]; then
    warn "fish is not installed; ~/.config/fish/config.fish and the matugen prompt go unused"
# /bin/fish and /usr/bin/fish are the same file on Arch, so compare what they
# resolve to rather than the strings.
elif [[ "$(readlink -f "$LOGIN_SHELL" 2>/dev/null)" == "$(readlink -f "$FISH")" ]]; then
    ok "fish is your login shell"
elif [[ $CHECK == 1 ]]; then
    miss "login shell is $LOGIN_SHELL, not $FISH (config.fish and the prompt go unused)"
elif ask "make fish your login shell (chsh -s $FISH)?"; then
    chsh -s "$FISH" && ok "login shell set to fish; log out and back in for it"
fi

# ---- optional integrations ------------------------------------------
bold "App integrations"

# Steam: Adwaita-for-Steam skin + DevTools flag so reload-steam-css can push live
if command -v steam >/dev/null 2>&1; then
    AFS="$HOME/.local/src/Adwaita-for-Steam"
    if [[ $CHECK == 1 ]]; then
        [[ -d "$AFS" ]] && ok "Adwaita-for-Steam cloned" || miss "Adwaita-for-Steam not cloned ($AFS)"
        [[ -f "$HOME/.steam/steam/.cef-enable-remote-debugging" ]] && ok "Steam DevTools flag set" || miss "Steam DevTools flag missing (live reload)"
    elif ask "Steam found: set up the matugen skin (clone Adwaita-for-Steam, enable Steam's DevTools port)?"; then
        [[ -d "$AFS" ]] || git clone -q --depth 1 https://github.com/tkashkin/Adwaita-for-Steam "$AFS"
        [[ -d "$HOME/.steam/steam" ]] && touch "$HOME/.steam/steam/.cef-enable-remote-debugging"
        ok "Steam ready; port 8080 must be free on this machine (Steam hardcodes it)"
    fi
else
    warn "steam not installed: skipping Steam skin"
fi

# Default applications (~/.config/mimeapps.list is xdg state, not a dotfile):
# nemo for folders, swayimg for images, mpv for video, firefox for the web.
# Without these, xdg-open falls back to whatever is first in mimeinfo.cache
# (for images that was Firefox, then gwenview complaining about Dolphin).
declare -A DEFAULT_APPS=(
    [nemo.desktop]="inode/directory"
    [swayimg.desktop]="image/jpeg image/png image/gif image/webp image/bmp image/tiff image/svg+xml image/avif image/heif image/heic image/jxl image/x-exr image/x-portable-pixmap image/x-tga image/vnd.microsoft.icon image/x-xcf"
    [mpv.desktop]="video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo video/mpeg video/x-flv video/3gpp video/ogg video/x-ms-wmv video/mp2t application/x-matroska audio/x-matroska"
    [firefox.desktop]="x-scheme-handler/http x-scheme-handler/https text/html application/pdf"
)
bold "Default applications"
for app in "${!DEFAULT_APPS[@]}"; do
    desktop="/usr/share/applications/$app"
    [[ -f "$desktop" || -f "$HOME/.local/share/applications/$app" ]] || { warn "${app%.desktop} not installed: its file types stay unassigned"; continue; }
    if [[ $CHECK == 1 ]]; then
        wrong=""
        for m in ${DEFAULT_APPS[$app]}; do [[ "$(xdg-mime query default "$m")" == "$app" ]] || wrong+=" $m"; done
        [[ -z "$wrong" ]] && ok "${app%.desktop} owns its file types" || miss "${app%.desktop} is not the default for:$wrong"
    else
        # shellcheck disable=SC2086
        xdg-mime default "$app" ${DEFAULT_APPS[$app]}
        ok "${app%.desktop}: $(echo ${DEFAULT_APPS[$app]} | wc -w) types"
    fi
done

# Nemo: kitty as its terminal, no desktop drawing (dconf state).
if command -v nemo >/dev/null 2>&1 && [[ $CHECK == 0 ]]; then
    gsettings set org.cinnamon.desktop.default-applications.terminal exec kitty 2>/dev/null
    gsettings set org.cinnamon.desktop.default-applications.terminal exec-arg '' 2>/dev/null
    gsettings set org.nemo.desktop show-desktop-icons false 2>/dev/null
    ok "nemo: opens kitty, draws no desktop"
fi

# Hyprland: hyprland.lua writes ~/.cache/hypr/binds.json (the action table the
# cheatsheet and Settings > Keybinds read) at the end of every load.
if [[ $CHECK == 1 ]]; then
    [[ -f "${XDG_CACHE_HOME:-$HOME/.cache}/hypr/binds.json" ]] && ok "hyprland.lua exported its actions (binds.json)" || miss "no ~/.cache/hypr/binds.json yet: log into Hyprland (or hyprctl reload) and the config writes it"
fi

# Audio: per-app output rules (Settings > Audio, routing.py) need WirePlumber
# to stop remembering stream targets itself, or a one-off move of a stream
# would come back as a permanent per-app rule. Saved in WirePlumber's state.
if command -v wpctl >/dev/null 2>&1; then
    if [[ $CHECK == 1 ]]; then
        [[ "$(wpctl settings node.stream.restore-target 2>/dev/null)" == *false* ]] && ok "WirePlumber does not restore stream targets (the shell routes them)" || miss "WirePlumber still restores stream targets: wpctl settings -s node.stream.restore-target false"
    else
        wpctl settings node.stream.restore-target false >/dev/null 2>&1 && wpctl settings -s node.stream.restore-target >/dev/null 2>&1
        ok "WirePlumber stream-target memory off (the shell routes streams)"
    fi
fi

# Icons: setwall builds ~/.local/share/icons/Matugen (Adwaita, folders
# recoloured); GTK on Wayland reads the icon theme from gsettings, kdeglobals
# is linked from the repo, and kde-gtk-config mirrors it into settings.ini
# when present. Nothing here draws the icons until setwall has run once.
ICON_INI=("$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini")
if [[ $CHECK == 1 ]]; then
    [[ "$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null)" == "'Matugen'" ]] && ok "icon theme is Matugen (gsettings)" || miss "icon theme is not Matugen in gsettings"
    for ini in "${ICON_INI[@]}"; do
        [[ -f "$ini" ]] && ! grep -q '^gtk-icon-theme-name=Matugen$' "$ini" && miss "$ini names another icon theme"
    done
    [[ -f "$HOME/.local/share/icons/Matugen/index.theme" ]] && ok "Matugen icon theme built" || miss "Matugen icon theme not built yet (setwall builds it)"
else
    gsettings set org.gnome.desktop.interface icon-theme Matugen 2>/dev/null
    for ini in "${ICON_INI[@]}"; do
        [[ -f "$ini" ]] && sed -i 's/^gtk-icon-theme-name=.*/gtk-icon-theme-name=Matugen/' "$ini"
    done
    ok "icon theme set to Matugen (gsettings, gtk settings.ini)"
fi

# Spotify: spicetify is not packaged
if command -v spotify-launcher >/dev/null 2>&1; then
    if command -v spicetify >/dev/null 2>&1 || [[ -x "$HOME/.spicetify/spicetify" ]]; then
        ok "spicetify present; set current_theme = Text, color_scheme = matugen in ~/.config/spicetify/config-xpui.ini"
    else
        warn "Spotify found but no spicetify: install it from https://spicetify.app (curl installer puts it in ~/.spicetify)"
    fi
fi

# Vesktop: Vencord only loads quickCss.css if enabled
if command -v vesktop >/dev/null 2>&1; then
    VS="$HOME/.config/vesktop/settings/settings.json"
    if [[ -f "$VS" ]] && grep -q '"useQuickCss": *true' "$VS"; then ok "vesktop quickCss enabled"
    else warn "vesktop: enable Settings > Vencord > \"Enable Custom CSS\" (useQuickCss) for the matugen theme"; fi
fi

# btop: theme file is generated, but btop has to be told to use it
if command -v btop >/dev/null 2>&1; then
    BC="$HOME/.config/btop/btop.conf"
    if [[ -f "$BC" ]] && grep -q 'color_theme *= *"matugen"' "$BC"; then ok "btop uses the matugen theme"
    else warn "btop: set color_theme = \"matugen\" and theme_background = False in ~/.config/btop/btop.conf (or pick it in btop's menu)"; fi
fi

# Firefox: extension is manual
if command -v firefox >/dev/null 2>&1; then
    warn "firefox: install the MatugenFox extension and point it at ~/.config/matugen/generated/firefox_websites.css and ~/.config/dusky_sites"
fi

# oh-my-posh: needs the source theme the recolouring script reads
if command -v oh-my-posh >/dev/null 2>&1; then
    OMP="$HOME/.config/oh-my-posh/themes/agnoster.omp.json"
    if [[ -f "$OMP" ]]; then ok "oh-my-posh theme source present"
    elif [[ $CHECK == 0 ]] && ask "oh-my-posh found: fetch agnoster.omp.json so setwall can recolour the prompt?"; then
        mkdir -p "$(dirname "$OMP")"
        curl -fsSL -o "$OMP" https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/agnoster.omp.json && ok "fetched $OMP"
    else miss "oh-my-posh theme missing: $OMP (fish falls back to its own prompt)"; fi
fi

# ---- first colours --------------------------------------------------
bold "Colours"
if [[ -f "$HOME/.config/matugen/generated/quickshell.json" ]]; then
    ok "matugen colours exist"
elif [[ $CHECK == 1 ]]; then
    miss "no colours yet: hyprlock and the terminal are unstyled until setwall has run once"
fi
# Only a first run (no colours yet) or an explicit --wallpaper picks a
# wallpaper; re-running bootstrap on a configured machine must not swap it.
if [[ $CHECK == 0 && ( -n "$WALL" || ! -f "$HOME/.config/matugen/generated/quickshell.json" ) ]]; then
    # SUPER+W browses this directory, so it has to exist before the first login
    # even if the wallpaper came from somewhere else.
    mkdir -p "$HOME/Pictures/Wallpapers"
    if [[ -z "$WALL" ]]; then
        WALL="$(find "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | head -1)"
    fi
    # No wallpapers of your own yet: the repo ships one, purely so that a fresh
    # clone has colours. Every generated file the desktop reads (the shell's
    # palette, hyprlock, kitty, GTK) only exists after a setwall run, and
    # hyprlock refuses to start without its colours - so "clone it and log in"
    # has to end somewhere other than an unstyled bar and a lock screen that
    # will not come up. Replace it with your own and run setwall again.
    if [[ -z "$WALL" && -f "$REPO/wallpapers/default.jpg" ]]; then
        cp -n "$REPO/wallpapers/default.jpg" "$HOME/Pictures/Wallpapers/default.jpg"
        WALL="$HOME/Pictures/Wallpapers/default.jpg"
        ok "no wallpapers found: copied the repo's default to ~/Pictures/Wallpapers"
    fi
    if [[ -n "$WALL" && -f "$WALL" ]] && command -v matugen >/dev/null 2>&1; then
        "$HOME/.local/bin/setwall" "$WALL" && ok "colours generated from $WALL"
    else
        warn "run  setwall <image>  before your first login (put wallpapers in ~/Pictures/Wallpapers for SUPER+W)"
    fi
fi

# ---- what is still yours to edit ------------------------------------
bold "Make it yours (see README.md, 'Make it yours')"
echo "  ./bootstrap --monitors                 your monitors, workspace map and bar workspaces, from hyprctl"
echo "  files/.config/hypr/conf/actions.lua    apps on SUPER+E/Q and every other action; rebind in Settings > Keybinds"
echo "  files/.config/hypr/conf/input.lua      kb_layout (or Settings > Input)"
echo "  files/.config/quickshell/Services/Stats.qml  temperature hwmon path (an AMD k10temp one by default)"
echo "  ~/.config/relayout/config.sh           opt into the dashboard layout (examples/relayout.config.sh)"
echo "  ~/.config/hypr/user/init.lua           machine-local Hyprland extras (examples/hypr-user.lua)"
echo "  ./greeter install && ./greeter enable  login screen: greetd + the shell's greeter, themed by matugen (README, 'Login screen')"
echo
