#!/bin/bash
# Packages this desktop makes redundant: apps whose job another part of the
# setup now does. `./prune` lists the ones installed; `./prune --remove`
# uninstalls them (asks first) and sweeps the orphans they leave behind.
# bootstrap --check calls the listing.
#
# Two tiers. REDUNDANT (and PLASMA_CORE once greetd is in) is replaced
# outright and goes as one batch after one question. DROPPED is what the
# desktop merely stopped setting up: nothing stands in for those, so each is
# its own yes/no in --remove, and the default keeps it.
#
# Format: package<space>#<space>what replaces it. Only exact package names;
# vlc-plugins-all pulls the ~80 vlc-plugin-* with it as dependencies.
set -uo pipefail

# Installed under exactly this name. `pacman -Q name` also answers for a
# package that merely *provides* the name (waybar-git provides waybar), while
# `pacman -R name` does not, and one such name aborts the whole removal with
# "target not found". So ask for the installed package's real name and compare.
installed() { [[ "$(pacman -Qq "$1" 2>/dev/null)" == "$1" ]]; }

REDUNDANT='
haruna                  # video: mpv + ModernZ
mpvqt                   # only haruna used it
gwenview                # images: swayimg
kdegraphics-thumbnailers # gwenview'"'"'s thumbnails; nemo has its own
kdegraphics-mobipocket  # dependency of the thumbnailers
vlc                     # video: mpv
vlc-plugins-all         # video: mpv (drags every vlc-plugin-* out with it)
mpv-uosc                # OSC: replaced by mpv-modernz-git
dolphin                 # files: nemo
loupe                   # images: swayimg
eog                     # images: swayimg
celluloid               # video: mpv + ModernZ
totem                   # video: mpv + ModernZ
greetd-regreet          # login screen: the shell'"'"'s greeter (./greeter)
waybar                  # bar: the shell (quickshell)
waybar-git              # bar: the shell (quickshell)
swaync                  # notifications: the shell
rofi                    # launcher and clipboard: the shell
fuzzel                  # power menu: the shell'"'"'s launcher menu
gtk-session-lock        # lock screen: the shell (ext-session-lock via quickshell)
python-pam              # lock screen: the shell (PAM via quickshell)
ffmpegthumbs            # dolphin'"'"'s video thumbnails; nemo uses ffmpegthumbnailer
plasma-desktop          # the Plasma desktop: Hyprland
kdeplasma-addons        # Plasma widgets
kinfocenter             # Settings > About PC (fastfetch)
kscreen                 # monitors: nwg-displays / gen-monitors
plasma-nm               # network: the shell'"'"'s network panel
plasma-pa               # audio: the shell'"'"'s audio panel
bluedevil               # bluetooth: the shell'"'"'s network panel
powerdevil              # idle/lock/brightness: hypridle, brightnessctl
plasma-firewall         # ufw front end for systemsettings
plasma-systemmonitor    # btop
plasma-thunderbolt      # bolt front end for systemsettings
plymouth-kcm            # systemsettings module
kde-gtk-config          # rewrote gtk settings.ini and xsettingsd.conf behind matugen'"'"'s back
breeze-gtk              # GTK theme: adw-gtk3 + matugen colours
kwallet-pam             # only a Plasma session unlocked the wallet at login
cachyos-emerald-kde-theme-git # Plasma theme
cachyos-iridescent-kde  # Plasma theme
cachyos-nord-kde-theme-git # Plasma theme
'

# The Plasma core. Only redundant once greetd is the login manager (./greeter
# enable, then a reboot) and qt6ct the Qt platform theme (packages.txt [core]):
# plasma-login-manager needs plasma-workspace, and so does plasma-integration
# through its portal backend.
PLASMA_CORE='
plasma-login-manager    # login: greetd + the shell'"'"'s greeter (./greeter)
plasma-workspace        # Plasma session, kwin, plasmashell
plasma-integration      # Qt theming: qt6ct (QT_QPA_PLATFORMTHEME=qt6ct)
xdg-desktop-portal-kde  # portals: xdg-desktop-portal-hyprland + -gtk
plasma-browser-integration # needs plasmashell to do anything
'
dm="$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service 2>/dev/null)"
core_ok=0
if [[ "$dm" == greetd ]] && installed qt6ct; then
    core_ok=1
    REDUNDANT+="$PLASMA_CORE"
fi

# No longer set up by this desktop, not replaced by anything. Asked about
# one at a time; say no and it stays exactly as it is.
DROPPED='
google-chrome           # 1.4.0: chrome-flags.conf left the repo; firefox is the browser the desktop themes
'

# Dependencies of the Plasma core that stay useful without it. Marked explicit
# before the removal so the orphan sweep does not take them.
KEEP=(breeze breeze-icons qqc2-breeze-style qqc2-desktop-style kio-extras kimageformats qtkeychain-qt6 socat hunspell)

REMOVE=0
[[ "${1:-}" == "--remove" ]] && REMOVE=1

present=()
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%%[[:space:]]*}"
    installed "$name" && present+=("$name")
done <<< "$REDUNDANT"

# A candidate that an installed package outside this list still depends on
# cannot go: pacman refuses the whole transaction over one such package
# ("removing X breaks dependency 'X' required by Y"). Leave it out and say
# why; once Y is gone it turns up as an orphan, and the sweep below takes it.
listed() { local n; for n in "${present[@]}"; do [[ "$n" == "$1" ]] && return 0; done; return 1; }
removable=()
for name in "${present[@]}"; do
    why="$(grep -m1 "^$name[[:space:]]" <<< "$REDUNDANT")"; why="${why#*#}"
    blockers=""
    for r in $(pacman -Qi "$name" 2>/dev/null | sed -n 's/^Required By *: *//p'); do
        [[ "$r" == None ]] && continue
        listed "$r" || blockers+=" $r"
    done
    if [[ -n "$blockers" ]]; then
        printf '  %-26s %s\n' "$name" "kept: still needed by${blockers}"
    else
        removable+=("$name")
        printf '  %-26s %s\n' "$name" "${why# }"
    fi
done
present=("${removable[@]}")

dropped=()
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%%[[:space:]]*}"
    installed "$name" || continue
    dropped+=("$name")
    why="${line#*#}"
    printf '  %-26s %s\n' "$name" "${why# } (asked on its own)"
done <<< "$DROPPED"

if [[ $core_ok == 0 ]] && installed plasma-workspace; then
    echo
    echo "  plasma-workspace (and plasma-login-manager, plasma-integration) stay until greetd is the"
    echo "  display manager (./greeter enable + reboot) and qt6ct is installed; then ./prune lists them."
fi

if [[ ${#present[@]} -eq 0 && ${#dropped[@]} -eq 0 ]]; then
    echo "  nothing redundant installed"
    exit 0
fi

[[ $REMOVE == 1 ]] || { echo; echo "  ./prune --remove  uninstalls these and their orphans"; exit 0; }

# the replaced tier: one question, one transaction
if [[ ${#present[@]} -gt 0 ]]; then
    echo
    read -r -p "  remove ${#present[@]} replaced package(s) and their orphaned dependencies? [y/N] " a
    if [[ "$a" =~ ^[Yy] ]]; then
        keep=()
        for k in "${KEEP[@]}"; do installed "$k" && keep+=("$k"); done
        [[ ${#keep[@]} -gt 0 ]] && sudo pacman -D --asexplicit "${keep[@]}" >/dev/null
        sudo pacman -Rns "${present[@]}"
    fi
fi

# the dropped tier: each one is your call
for name in "${dropped[@]}"; do
    why="$(grep -m1 "^$name[[:space:]]" <<< "$DROPPED")"; why="${why#*#}"
    echo
    read -r -p "  remove $name? (${why# }) [y/N] " a
    [[ "$a" =~ ^[Yy] ]] && sudo pacman -Rns "$name"
done

orphans="$(pacman -Qdtq 2>/dev/null)"
if [[ -n "$orphans" ]]; then
    echo; echo "  orphans left behind:"; echo "$orphans" | sed 's/^/    /'
    read -r -p "  remove them too? [y/N] " a
    # shellcheck disable=SC2086
    [[ "$a" =~ ^[Yy] ]] && sudo pacman -Rns $orphans
fi
